#!/usr/bin/env bash
#
# runner-cleanup — tear down GitHub Actions self-hosted runners that
# runner-setup provisioned on macOS, or unregister them from one organization
# while keeping the install (--org ORG --keep-files).
#
# Usage:
#   runner-cleanup [--all | --runner N] [--token REMOVE_TOKEN] [--yes]
#   runner-cleanup --org ORG [--keep-files] [--runner N] [--yes]
#
# For each runner it:
#   1. boots out and removes the system LaunchDaemon (com.github.runner-N),
#      FIRST, so an ephemeral supervisor cannot register the runner back,
#   2. boots out and removes any leftover gui LaunchAgent (actions.runner.*),
#   3. deregisters the runner from GitHub when a *removal* token is available
#      (registration tokens will NOT work for removal; --org mints one with
#      runner-token),
#   4. deletes the runner directory under /opt/github-runners, or with
#      --keep-files deletes only its registration credentials,
#   5. when every runner is gone, also unmounts the shared runner-ramscratch
#      RAM volume (clean --all --offline) once the daemons that consume it are
#      stopped.
#
# --org ORG acts only on runners registered to that organization and refuses
# while any of them is running a job (Runner.Worker). With --keep-files the
# runner directory, binaries, _toolcache, Colima VM, and host setup stay, so a
# later runner-setup can register a different org. runner-setup --replace does
# not remove a registration from a different org; deregister first.
#
# Like runner-setup, it runs config.sh as the INVOKING (non-root) user and uses
# sudo ONLY for the privileged /opt and /Library/LaunchDaemons operations. It is
# idempotent: a missing daemon, plist, or directory is fine.

set -euo pipefail

# ----------------------------------------------------------------------------
# Constants / globals
# ----------------------------------------------------------------------------
PROG_NAME="$(basename "$0")"
RUNNER_ROOT="/opt/github-runners"
LAUNCH_DAEMON_DIR="/Library/LaunchDaemons"
BOOTOUT_RETRIES="${BOOTOUT_RETRIES:-10}"

TOKEN=""
KEYCHAIN_ITEM=""
ORG=""                # non-empty => only runners registered to this org
TARGET_RUNNER=""      # empty => all runners
KEEP_FILES=0
ASSUME_YES=0
DRY_RUN=0
FAILURES=0
CLASSIFIED_ACTION=""

REAL_USER=""
REAL_GROUP=""
REAL_UID=""
REAL_HOME=""

# Names (e.g. "runner-1") selected for removal, a parallel action table
# ("remove" = has or may have a GitHub registration; "unload" = --org matched
# only the service plist), and a parallel status table.
declare -a TARGET_NAMES=()
declare -a TARGET_ACTIONS=()
declare -a STATUS_NAME=()
declare -a STATUS_RESULT=()

# ----------------------------------------------------------------------------
# Output helpers — progress to stderr; the token is NEVER interpolated.
# ----------------------------------------------------------------------------
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
step() { printf '\033[1;32m  ->\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; }

usage() {
  cat >&2 <<EOF
${PROG_NAME} — remove GitHub Actions self-hosted runners on macOS

USAGE:
  ${PROG_NAME} [--all | --runner N] [--token REMOVE_TOKEN] [--yes]
  ${PROG_NAME} --org ORG [--keep-files] [--runner N] [--yes]

OPTIONS:
  --all              Remove every runner under ${RUNNER_ROOT} (default).
  --runner N         Remove only runner-N.
  --org ORG          Act only on runners registered to this organization.
                     Refuses while any of them is running a job, and mints a
                     removal token with runner-token when none is given.
  --keep-files       With --org: unregister and stop the runners but keep
                     runner directories, tool caches, Colima, and the rest of
                     the host, so runner-setup can register another org.
  --token TOKEN      GitHub *removal* token, so each runner is deregistered from
                     GitHub before local teardown. Get it from the Runners
                     settings page: an existing runner > Remove shows a
                     'config.sh remove --token ...' command. May also be given
                     via the RUNNER_REMOVE_TOKEN env var (preferred). WITHOUT a
                     token or --org, local teardown still happens but the
                     runner lingers as 'offline' in GitHub until you remove it
                     there.
  --keychain-item NAME
                     With --org: passed to runner-token when minting the token.
  --dry-run          Show what would be removed. Changes nothing.
  -y, --yes          Do not prompt for confirmation.
  -h, --help         Show this help and exit.

EXAMPLES:
  ${PROG_NAME} --all
  ${PROG_NAME} --runner 2 --token AXR...
  RUNNER_REMOVE_TOKEN=AXR... ${PROG_NAME} --all --yes
  ${PROG_NAME} --org acme --keep-files --yes
  ${PROG_NAME} --org acme --keep-files --runner 2 --keychain-item gh-runner-pat

Move a Mini to another org: run --org OLD_ORG --keep-files as the runner owner,
then register the new org:
  RUNNER_TOKEN=\$(runner-token registration --org NEW_ORG) \\
    runner-setup --org NEW_ORG --runners 2 --colima

SECURITY NOTE:
  A token passed via --token is visible in 'ps' to other local users while this
  runs. Prefer RUNNER_REMOVE_TOKEN on shared machines, or let --org mint one.
  Removal tokens are short-lived; rotate any token that may have been exposed.
EOF
}

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)        TARGET_RUNNER=""; shift ;;
      --runner)
        [[ $# -ge 2 ]] || { err "--runner requires a value"; usage; exit 2; }
        TARGET_RUNNER="$2"; shift 2 ;;
      --runner=*)   TARGET_RUNNER="${1#*=}"; shift ;;
      --org)
        [[ $# -ge 2 ]] || { err "--org requires a value"; usage; exit 2; }
        ORG="$2"; shift 2 ;;
      --org=*)      ORG="${1#*=}"; shift ;;
      --keep-files) KEEP_FILES=1; shift ;;
      --token)
        [[ $# -ge 2 ]] || { err "--token requires a value"; usage; exit 2; }
        TOKEN="$2"; shift 2 ;;
      --token=*)    TOKEN="${1#*=}"; shift ;;
      --keychain-item)
        [[ $# -ge 2 ]] || { err "--keychain-item requires a value"; usage; exit 2; }
        KEYCHAIN_ITEM="$2"; shift 2 ;;
      --keychain-item=*) KEYCHAIN_ITEM="${1#*=}"; shift ;;
      --dry-run)    DRY_RUN=1; shift ;;
      -y|--yes)     ASSUME_YES=1; shift ;;
      -h|--help)    usage; exit 0 ;;
      *) err "Unknown argument: $1"; usage; exit 2 ;;
    esac
  done

  if [[ -z "${TOKEN}" && -n "${RUNNER_REMOVE_TOKEN:-}" ]]; then
    TOKEN="${RUNNER_REMOVE_TOKEN}"
  fi

  if [[ -n "${TARGET_RUNNER}" ]] && ! [[ "${TARGET_RUNNER}" =~ ^[0-9]+$ ]]; then
    err "--runner must be a positive integer (got: '${TARGET_RUNNER}')"
    exit 2
  fi
  if [[ -n "${ORG}" ]] && ! [[ "${ORG}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]]; then
    err "--org must be a GitHub organization login (got: '${ORG}')"
    exit 2
  fi
  if [[ -z "${ORG}" && "${KEEP_FILES}" -eq 1 ]]; then
    err "--keep-files requires --org ORG."
    exit 2
  fi
  if [[ -z "${ORG}" && -n "${KEYCHAIN_ITEM}" ]]; then
    err "--keychain-item requires --org ORG."
    exit 2
  fi
  if [[ -n "${TOKEN}" && -n "${KEYCHAIN_ITEM}" ]]; then
    err "Pass either a removal token or --keychain-item, not both."
    exit 2
  fi
}

# ----------------------------------------------------------------------------
# Environment detection (mirrors runner-setup)
# ----------------------------------------------------------------------------
detect_platform() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    err "This tool only supports macOS."
    exit 1
  fi
}

require_cmds() {
  local missing=() c
  local -a cmds=(uname id sudo launchctl rm basename)
  # --org reads service plists and checks for running jobs.
  [[ -z "${ORG}" ]] || cmds+=(python3 ps)
  for c in "${cmds[@]}"; do
    command -v "${c}" >/dev/null 2>&1 || missing+=("${c}")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Required command(s) not found: ${missing[*]}"
    exit 1
  fi
}

detect_user() {
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    REAL_USER="${SUDO_USER}"
  else
    REAL_USER="$(whoami)"
  fi
  if [[ "${REAL_USER}" == "root" ]]; then
    err "Run this as a normal user; it uses sudo only internally for /opt and"
    err "${LAUNCH_DAEMON_DIR}."
    exit 1
  fi
  REAL_GROUP="$(id -gn "${REAL_USER}")"
  REAL_UID="$(id -u "${REAL_USER}")"
  # `|| true`: dscl exits non-zero for a non-local (e.g. MDM/AD) user record,
  # and with `pipefail` that would abort the whole script before the fallback.
  REAL_HOME="$(dscl . -read "/Users/${REAL_USER}" NFSHomeDirectory 2>/dev/null \
    | awk '{print $2}' || true)"
  [[ -n "${REAL_HOME}" ]] || REAL_HOME="/Users/${REAL_USER}"
}

# Run a command as the real (non-root) user, forcing HOME/USER/LOGNAME so
# config.sh resolves "${HOME}/..." correctly even under `sudo runner-cleanup`.
as_user() {
  if [[ "$(id -un)" == "${REAL_USER}" ]]; then
    HOME="${REAL_HOME}" USER="${REAL_USER}" LOGNAME="${REAL_USER}" "$@"
  else
    sudo -H -u "${REAL_USER}" env \
      HOME="${REAL_HOME}" \
      USER="${REAL_USER}" \
      LOGNAME="${REAL_USER}" \
      "$@"
  fi
}

ensure_sudo() {
  log "Requesting administrator privileges (needed for ${LAUNCH_DAEMON_DIR} and ${RUNNER_ROOT})"
  if ! sudo -v; then
    err "Could not obtain sudo privileges."
    exit 1
  fi
}

record_status() {
  STATUS_NAME+=("$1")
  STATUS_RESULT+=("$2")
}

note_failure() {
  FAILURES=1
  record_status "$1" "$2"
}

# Locate a sibling tap tool: script-adjacent only when executed by path
# (sourcing carries no real location); otherwise fall back to PATH.
tool_bin() {
  local tool="$1" self_dir="" candidate
  case "${BASH_SOURCE[0]:-}" in
    */*)
      self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd || true)"
      ;;
  esac
  if [[ -n "${self_dir}" && -x "${self_dir}/${tool}" ]]; then
    printf '%s\n' "${self_dir}/${tool}"
    return 0
  fi
  candidate="$(command -v "${tool}" 2>/dev/null || true)"
  if [[ -n "${candidate}" && -x "${candidate}" ]]; then
    printf '%s\n' "${candidate}"
    return 0
  fi
  return 1
}

# Boot out a system service and WAIT for it to disappear (bootout is async).
# Returns 1 if it is still loaded after BOOTOUT_RETRIES seconds.
bootout_system() {
  local label="$1" tries=0
  sudo launchctl bootout "system/${label}" 2>/dev/null || true
  while sudo launchctl print "system/${label}" >/dev/null 2>&1; do
    tries=$((tries + 1))
    if [[ "${tries}" -ge "${BOOTOUT_RETRIES}" ]]; then
      return 1
    fi
    sleep 1
  done
  return 0
}

# ----------------------------------------------------------------------------
# Discover which runner names to act on. Populates TARGET_NAMES.
# Sources, unioned + de-duplicated:
#   - directories  ${RUNNER_ROOT}/runner-*
#   - daemon plists ${LAUNCH_DAEMON_DIR}/com.github.runner-*.plist  (--all only,
#     so an orphaned daemon whose dir was already deleted is still torn down)
# Only runner-N names count: the same globs match com.github.runner-health and
# com.github.runner-autoscale, which are host services, not runners.
# ----------------------------------------------------------------------------
discover_targets() {
  local -a found=()
  local d p name lbl

  if [[ -n "${TARGET_RUNNER}" ]]; then
    found+=("runner-${TARGET_RUNNER}")
  else
    shopt -s nullglob
    for d in "${RUNNER_ROOT}"/runner-*; do
      [[ -d "${d}" ]] || continue
      name="$(basename "${d}")"
      [[ "${name}" =~ ^runner-[0-9]+$ ]] && found+=("${name}")
    done
    for p in "${LAUNCH_DAEMON_DIR}"/com.github.runner-*.plist; do
      [[ -f "${p}" ]] || continue
      lbl="$(basename "${p}" .plist)"   # com.github.runner-N
      name="${lbl#com.github.}"
      [[ "${name}" =~ ^runner-[0-9]+$ ]] && found+=("${name}")
    done
    shopt -u nullglob
  fi

  # De-duplicate while preserving order (bash 3.2: no associative arrays).
  # Guard the count FIRST: on bash 3.2 expanding an EMPTY array as "${found[@]}"
  # under `set -u` aborts ("found[@]: unbound variable"; the 4.4 relaxation is
  # absent), which would crash the common "nothing to clean" case before the
  # empty-target guard in main(). (Do NOT use "${found[@]:-}" — that injects one
  # empty-string element into TARGET_NAMES.)
  local seen=" "
  if [[ ${#found[@]} -gt 0 ]]; then
    for name in "${found[@]}"; do
      case "${seen}" in
        *" ${name} "*) ;;
        *) TARGET_NAMES+=("${name}"); TARGET_ACTIONS+=("remove"); seen="${seen}${name} " ;;
      esac
    done
  fi
}

# ----------------------------------------------------------------------------
# --org filtering. A runner matches when its .runner gitHubUrl is
# https://host/ORG (a second path segment is a repository), or, with no local
# registration (an ephemeral runner between jobs), when its service plist
# passes --org ORG.
# ----------------------------------------------------------------------------
same_org() {
  local a b
  a="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  b="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
  [[ -n "${a}" && "${a}" == "${b}" ]]
}

github_url_of() {
  local line
  line="$(sed -n 's/.*"gitHubUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1")"
  printf '%s\n' "${line%%$'\n'*}"
}

org_of_github_url() {
  local url="${1%/}" rest path
  case "${url}" in
    https://*|http://*) ;;
    *) return 1 ;;
  esac
  rest="${url#*://}"
  case "${rest}" in
    */*) path="${rest#*/}" ;;
    *) return 1 ;;
  esac
  case "${path}" in
    ""|*/*) return 1 ;;
  esac
  printf '%s\n' "${path}"
}

plist_arg() {
  local plist="$1" flag="$2"
  python3 - "${plist}" "${flag}" <<'PY'
import plistlib, sys
path, flag = sys.argv[1], sys.argv[2]
try:
    with open(path, "rb") as handle:
        data = plistlib.load(handle)
except Exception:
    sys.exit(0)
args = data.get("ProgramArguments") or []
for index, arg in enumerate(args):
    if arg == flag and index + 1 < len(args):
        print(args[index + 1])
        break
PY
}

# Set CLASSIFIED_ACTION for one runner under --org ("remove" or "unload"), or
# record why it is skipped and leave it empty.
classify_one() {
  local name="$1"
  local dir="${RUNNER_ROOT}/${name}"
  local plist="${LAUNCH_DAEMON_DIR}/com.github.${name}.plist"
  local url org="" plist_org=""

  CLASSIFIED_ACTION=""
  if [[ -f "${dir}/.runner" ]]; then
    url="$(github_url_of "${dir}/.runner")"
    if [[ -z "${url}" ]]; then
      note_failure "${name}" "FAILED (unreadable registration)"
      return 0
    fi
    if ! org="$(org_of_github_url "${url}")"; then
      record_status "${name}" "skipped (not an org runner)"
      return 0
    fi
    if ! same_org "${org}" "${ORG}"; then
      record_status "${name}" "skipped (registered to ${org})"
      return 0
    fi
    CLASSIFIED_ACTION="remove"
    return 0
  fi

  if [[ -f "${plist}" ]]; then
    plist_org="$(plist_arg "${plist}" --org)"
    if same_org "${plist_org}" "${ORG}"; then
      CLASSIFIED_ACTION="unload"
      return 0
    fi
    if [[ -n "${plist_org}" ]]; then
      record_status "${name}" "skipped (service targets ${plist_org})"
      return 0
    fi
  fi

  if [[ -n "${TARGET_RUNNER}" ]]; then
    note_failure "${name}" "FAILED (not registered to ${ORG})"
  fi
}

filter_by_org() {
  local name
  local -a names=()
  [[ ${#TARGET_NAMES[@]} -gt 0 ]] || return 0
  names=("${TARGET_NAMES[@]}")
  TARGET_NAMES=()
  TARGET_ACTIONS=()
  for name in "${names[@]}"; do
    classify_one "${name}"
    [[ -n "${CLASSIFIED_ACTION}" ]] || continue
    TARGET_NAMES+=("${name}")
    TARGET_ACTIONS+=("${CLASSIFIED_ACTION}")
  done
}

# ----------------------------------------------------------------------------
# Active-job check (--org). Return 0 = busy, 1 = idle, 2 = inspection
# failed/ambiguous executable.
# ----------------------------------------------------------------------------
active_workers() {
  local name="$1" processes executable ambiguous=0
  if ! processes="$(ps -axww -o comm=)"; then return 2; fi
  while IFS= read -r executable; do
    [[ -n "${executable}" ]] || continue
    executable="${executable#"${executable%%[![:space:]]*}"}"
    [[ "${executable}" != "${RUNNER_ROOT}/${name}/bin/Runner.Worker" ]] || return 0
    case "${executable}" in
      Runner.Worker|./*Runner.Worker|bin/Runner.Worker) ambiguous=1 ;;
    esac
  done <<< "${processes}"
  [[ "${ambiguous}" -eq 0 ]] || return 2
  return 1
}

check_idle() {
  local name rc=0 state
  [[ ${#TARGET_NAMES[@]} -gt 0 ]] || return 0
  for name in "${TARGET_NAMES[@]}"; do
    if active_workers "${name}"; then state=0; else state=$?; fi
    case "${state}" in
      1) ;;
      0)
        err "${name} has an active job. Pause dispatch and let it finish."
        note_failure "${name}" "FAILED (active job)"
        rc=1
        ;;
      *)
        err "Could not establish local worker state for ${name}; refusing to stop it."
        note_failure "${name}" "FAILED (worker state unknown)"
        rc=1
        ;;
    esac
  done
  return "${rc}"
}

needs_token() {
  local action
  [[ ${#TARGET_ACTIONS[@]} -gt 0 ]] || return 1
  for action in "${TARGET_ACTIONS[@]}"; do
    [[ "${action}" == "remove" ]] && return 0
  done
  return 1
}

mint_removal_token() {
  local bin token
  local -a args=()
  bin="$(tool_bin runner-token)" || {
    err "runner-token is not installed. Pass --token or set RUNNER_REMOVE_TOKEN."
    return 1
  }
  args=(removal --org "${ORG}")
  if [[ -n "${KEYCHAIN_ITEM}" ]]; then
    args+=(--keychain-item "${KEYCHAIN_ITEM}")
  fi
  if ! token="$("${bin}" "${args[@]}")"; then
    err "Could not mint a removal token for ${ORG}."
    return 1
  fi
  token="${token//$'\r'/}"
  if [[ -z "${token}" || "${token}" == *$'\n'* ]]; then
    err "runner-token did not print a single-line removal token."
    return 1
  fi
  TOKEN="${token}"
}

# ----------------------------------------------------------------------------
# Remove one runner by name (e.g. "runner-1"). Tolerant of missing pieces,
# except that --keep-files refuses to report success while the service is
# still loaded or the GitHub registration remains.
# ----------------------------------------------------------------------------
cleanup_one() {
  local name="$1" action="$2"
  local dir="${RUNNER_ROOT}/${name}"
  local label="com.github.${name}"
  local plist="${LAUNCH_DAEMON_DIR}/${label}.plist"
  local failed=""

  if [[ "${KEEP_FILES}" -eq 1 ]]; then
    log "Deregistering ${name} from ${ORG}"
  else
    log "Removing ${name}"
  fi

  # 1) System LaunchDaemon FIRST, so an ephemeral supervisor cannot register
  #    the runner back while it is being removed.
  if sudo launchctl print "system/${label}" >/dev/null 2>&1; then
    step "Booting out system/${label}"
    if ! bootout_system "${label}"; then
      if [[ "${KEEP_FILES}" -eq 1 ]]; then
        err "${label} is still loaded."
        note_failure "${name}" "FAILED (still loaded)"
        return 0
      fi
      warn "${label} is still loaded; continuing because its directory is deleted."
    fi
  fi
  if [[ -e "${plist}" ]]; then
    step "Removing ${plist}"
    sudo rm -f "${plist}"
  fi

  # 2) Any leftover gui LaunchAgent(s) for this runner (from a manual svc.sh
  #    run). The GitHub runner name may be plain (runner-N) or machine-prefixed
  #    (PREFIX-runner-N), so match the trailing index precisely rather than a
  #    fixed ".runner-N" suffix.
  local idx="${name#runner-}"
  local agent alabel rn
  shopt -s nullglob
  for agent in "${REAL_HOME}/Library/LaunchAgents/actions.runner."*.plist; do
    alabel="$(basename "${agent}" .plist)"   # actions.runner.<slug>.<runner-name>
    rn="${alabel##*.}"                         # <runner-name>
    if [[ "${rn}" == "runner-${idx}" || "${rn}" == *"-runner-${idx}" ]]; then
      step "Booting out gui agent ${alabel}"
      sudo launchctl asuser "${REAL_UID}" launchctl bootout "gui/${REAL_UID}/${alabel}" 2>/dev/null || true
      as_user rm -f "${agent}" 2>/dev/null || true
    fi
  done
  shopt -u nullglob

  # 3) Deregister from GitHub while the runner files still exist. Only possible
  #    with a removal token; a registration token cannot remove.
  if [[ "${action}" == "remove" && -f "${dir}/.runner" ]]; then
    if [[ -z "${TOKEN}" ]]; then
      warn "${name} is registered but no --token given: NOT deregistered from GitHub."
      warn "It will show as 'offline' until you remove it on the Runners page."
    elif [[ ! -x "${dir}/config.sh" ]]; then
      warn "${dir}/config.sh is missing: ${name} remains registered in GitHub."
      failed="config.sh missing; GitHub registration remains"
    else
      step "Deregistering from GitHub (config.sh remove) as ${REAL_USER}"
      if ! ( cd "${dir}" && as_user ./config.sh remove --token "${TOKEN}" ); then
        warn "config.sh remove failed for ${name} (removal token wrong/expired?)."
        warn "It may remain listed in GitHub; remove it from the Runners page."
        failed="config.sh remove"
      elif [[ -f "${dir}/.runner" ]]; then
        failed="registration file remains"
      fi
    fi
  fi

  # 4) --keep-files: drop only the registration credentials. Otherwise delete
  #    the runner directory (sudo: lives under root-owned /opt).
  if [[ "${KEEP_FILES}" -eq 1 ]]; then
    if [[ -n "${failed}" ]]; then
      note_failure "${name}" "FAILED (${failed})"
      return 0
    fi
    if [[ "${action}" == "unload" ]]; then
      record_status "${name}" "unloaded (no local registration)"
      return 0
    fi
    as_user rm -f "${dir}/.credentials" "${dir}/.credentials_rsaparams" \
      "${dir}/.service" 2>/dev/null || true
    record_status "${name}" "deregistered"
    return 0
  fi

  if [[ -d "${dir}" ]]; then
    step "Deleting ${dir}"
    sudo rm -rf "${dir}"
  fi

  record_status "${name}" "removed"
  return 0
}

# Warn when the health watchdog or autoscaler still watches the org the
# runners just left.
warn_related_plists() {
  local label plist org_in
  [[ -n "${ORG}" ]] || return 0
  for label in com.github.runner-health com.github.runner-autoscale; do
    plist="${LAUNCH_DAEMON_DIR}/${label}.plist"
    [[ -f "${plist}" ]] || continue
    org_in="$(plist_arg "${plist}" --org || true)"
    if same_org "${org_in}" "${ORG}"; then
      warn "${plist} still names --org ${ORG}. Update it before watching another org."
    fi
  done
}

# True while any runner directory is left under RUNNER_ROOT.
runners_remain() {
  local d
  for d in "${RUNNER_ROOT}"/runner-*; do
    [[ -d "${d}" ]] && return 0
  done
  return 1
}

# ----------------------------------------------------------------------------
# RAM scratch teardown. The runner-ramscratch volume is HOST-WIDE (shared by
# every runner under one bounded budget), so it is torn down only when ALL
# runners are being removed — after their daemons are booted out, which is
# what stops the consumers. helper clean --all --offline then unmounts only
# after the allocation ledger is empty; a mounted volume that refuses to
# detach is left for a later clean. Removing one runner of many leaves the
# volume (and the other runners' allocations) untouched.
# ----------------------------------------------------------------------------
teardown_ramscratch() {
  local state_dir="${RUNNER_ROOT}/_ramscratch"
  [[ -d "${state_dir}" ]] || return 0
  local helper=""
  if [[ -n "${RUNNER_RAMSCRATCH_BIN:-}" && -x "${RUNNER_RAMSCRATCH_BIN}" ]]; then
    helper="${RUNNER_RAMSCRATCH_BIN}"
  else
    helper="$(tool_bin runner-ramscratch || true)"
  fi
  if [[ -z "${helper}" ]]; then
    warn "RAM scratch state exists at ${state_dir} but runner-ramscratch was"
    warn "not found; leaving it (detach any mounted volume manually)."
    return 0
  fi
  step "Unmounting the shared RAM scratch volume (all runners removed)"
  if ! as_user "${helper}" clean --all --offline; then
    warn "RAM scratch teardown failed; leaving ${state_dir} for manual cleanup."
    return 0
  fi
  sudo rm -rf "${state_dir}"
  return 0
}

# ----------------------------------------------------------------------------
# Plan / confirmation (skipped with --yes; refuses to proceed without a TTY)
# ----------------------------------------------------------------------------
describe_plan() {
  local i text
  for i in "${!TARGET_NAMES[@]}"; do
    if [[ "${KEEP_FILES}" -eq 0 ]]; then
      text="remove ${RUNNER_ROOT}/${TARGET_NAMES[$i]}"
    elif [[ "${TARGET_ACTIONS[$i]}" == "remove" ]]; then
      text="unregister from GitHub and unload its service"
    else
      text="unload its service (no local registration)"
    fi
    log "Would ${text}: ${TARGET_NAMES[$i]}"
  done
  if [[ "${KEEP_FILES}" -eq 1 ]]; then
    log "Runner directories, tool caches, and Colima stay on disk."
  fi
}

confirm() {
  [[ "${ASSUME_YES}" -eq 1 ]] && return 0
  if [[ ! -t 0 ]]; then
    err "Refusing to remove runners without confirmation (no TTY). Re-run with --yes."
    exit 1
  fi
  local n
  if [[ "${KEEP_FILES}" -eq 1 ]]; then
    log "About to deregister these runners from ${ORG}:"
    for n in "${TARGET_NAMES[@]}"; do
      printf '     - %s\n' "${n}" >&2
    done
    log "Runner directories and tool caches stay."
  else
    log "About to PERMANENTLY remove the following runner(s):"
    for n in "${TARGET_NAMES[@]}"; do
      printf '     - %s/%s\n' "${RUNNER_ROOT}" "${n}" >&2
    done
    if [[ -z "${TOKEN}" && -z "${ORG}" ]]; then
      warn "No --token: runners will NOT be deregistered from GitHub (left 'offline')."
    fi
  fi
  local reply
  printf '\033[1;33m?\033[0m Proceed? [y/N] ' >&2
  read -r reply
  case "${reply}" in
    y|Y|yes|YES) return 0 ;;
    *) log "Aborted; nothing removed."; exit 0 ;;
  esac
}

print_summary() {
  local i
  printf '\n'
  printf '==> Summary\n'
  printf '  %-12s %s\n' "RUNNER" "STATUS"
  printf '  %-12s %s\n' "------" "------"
  if [[ ${#STATUS_NAME[@]} -gt 0 ]]; then
    for i in "${!STATUS_NAME[@]}"; do
      printf '  %-12s %s\n' "${STATUS_NAME[$i]}" "${STATUS_RESULT[$i]}"
    done
  fi
  printf '\n'
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
  local idle_rc=0
  parse_args "$@"
  detect_platform
  require_cmds
  detect_user

  discover_targets
  [[ -z "${ORG}" ]] || filter_by_org
  if [[ ${#TARGET_NAMES[@]} -eq 0 ]]; then
    if [[ -n "${ORG}" ]]; then
      [[ "${FAILURES}" -ne 0 ]] || log "No runners on this Mac are registered to ${ORG}."
      print_summary
      return "${FAILURES}"
    fi
    log "No runners found under ${RUNNER_ROOT}; nothing to clean up."
    [[ -d "${RUNNER_ROOT}" ]] && rmdir "${RUNNER_ROOT}" 2>/dev/null || true
    exit 0
  fi

  [[ -z "${ORG}" ]] || check_idle || idle_rc=1
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    describe_plan
    warn_related_plists
    print_summary
    if [[ "${idle_rc}" -ne 0 || "${FAILURES}" -ne 0 ]]; then
      return 1
    fi
    return 0
  fi
  if [[ "${idle_rc}" -ne 0 ]]; then
    print_summary
    return 1
  fi

  confirm
  if [[ -n "${ORG}" && -z "${TOKEN}" ]] && needs_token; then
    mint_removal_token || return 1
  fi
  ensure_sudo

  local i
  for i in "${!TARGET_NAMES[@]}"; do
    cleanup_one "${TARGET_NAMES[$i]}" "${TARGET_ACTIONS[$i]}"
  done
  unset TOKEN

  # Remove the root dir if it is now empty (only meaningful for --all).
  if [[ -z "${TARGET_RUNNER}" && "${KEEP_FILES}" -eq 0 && -d "${RUNNER_ROOT}" ]] \
      && ! runners_remain; then
    teardown_ramscratch
    if sudo rmdir "${RUNNER_ROOT}" 2>/dev/null; then
      step "Removed empty ${RUNNER_ROOT}"
    fi
  fi

  warn_related_plists
  print_summary
  if [[ "${FAILURES}" -ne 0 ]]; then
    err "Some runners did not clean up fully. See the summary above."
    return 1
  fi
  if [[ "${KEEP_FILES}" -eq 1 ]]; then
    log "Deregistered from ${ORG}. Runner files are still on disk."
    log "Register another org with runner-setup --org NEW_ORG."
  else
    log "Cleanup complete."
  fi
  return 0
}

main "$@"

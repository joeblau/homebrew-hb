#!/usr/bin/env bash
# Clear removable Dock items and hide desktop widgets for the invoking user.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: clear-mac

Clear pinned apps, files, folders, and recent apps from your Dock,
and hide widgets on the desktop and in Stage Manager (macOS Sonoma or later).
Saved widget layouts and Notification Center widgets are preserved.
Run as the user whose desktop you want to clear, without sudo.
Finder, Trash, running apps, and minimized windows can still appear.
Dock and widget visibility preferences are backed up before any changes.
EOF
}

if [[ $# -eq 1 && ( "$1" == -h || "$1" == --help ) ]]; then
  usage
  exit 0
elif [[ $# -gt 0 ]]; then
  usage >&2
  exit 2
fi
if [[ "$(uname -s)" != Darwin ]]; then
  printf 'This script requires macOS.\n' >&2
  exit 1
fi
if [[ "${EUID}" -eq 0 ]]; then
  printf 'Run as the desktop owner, without sudo.\n' >&2
  exit 1
fi

umask 077
backup_root="${HOME}/Library/Application Support/clear-mac/backups"
mkdir -p "${backup_root}"
backup_dir="$(mktemp -d "${backup_root}/mac-$(date +%Y%m%d-%H%M%S).XXXXXX")"

# Complete both backups before changing either domain. An absent domain exports
# as an empty dictionary, which can also be restored with defaults import.
for domain in com.apple.dock com.apple.WindowManager; do
  backup_file="${backup_dir}/${domain}.plist"
  if ! defaults export "${domain}" - > "${backup_file}" ||
     ! plutil -lint "${backup_file}" >/dev/null; then
    printf 'Could not back up %s; stopping before changing preferences.\n' "${domain}" >&2
    printf 'Backup directory: %s\n' "${backup_dir}" >&2
    exit 1
  fi
done

# Print recovery commands first, so they remain available if a later write fails.
printf 'Backup directory: %s\n' "${backup_dir}"
for domain in com.apple.dock com.apple.WindowManager; do
  printf 'Restore with: defaults import %s %q\n' "${domain}" "${backup_dir}/${domain}.plist"
done

for key in persistent-apps persistent-others static-apps static-others; do
  defaults write com.apple.dock "${key}" -array
done
defaults write com.apple.dock show-recents -bool false

# These are the Show Widgets switches in System Settings > Desktop & Dock.
defaults write com.apple.WindowManager StandardHideWidgets -bool true
defaults write com.apple.WindowManager StageManagerHideWidgets -bool true

# Refresh only this user's UI. When logged out, preferences apply next login.
killall -u "$(id -un)" Dock NotificationCenter 2>/dev/null || true

printf 'Cleared removable Dock items. Finder, Trash, and running apps can remain.\n'
printf 'Hidden desktop and Stage Manager widgets; saved layouts are preserved.\n'
printf 'After restoring, log out and back in to refresh the desktop.\n'

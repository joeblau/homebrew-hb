# ----------------------------------------------------------------------------
# start / stop / status
# ----------------------------------------------------------------------------
cmd_start() {
  detect_platform
  require_cmds sudo launchctl curl
  detect_user
  if [[ ! -f "${PLIST_DEST}" ]]; then
    err "Not installed (no ${PLIST_DEST}). Run: ${PROG_NAME} install --org ORG"
    exit 1
  fi
  load_config
  ensure_sudo
  if daemon_loaded; then
    log "Reloading system/${DAEMON_LABEL}"
    sudo launchctl kickstart -k "system/${DAEMON_LABEL}"
  else
    log "Bootstrapping system/${DAEMON_LABEL}"
    sudo launchctl bootstrap system "${PLIST_DEST}"
    sudo launchctl enable "system/${DAEMON_LABEL}" 2>/dev/null || true
  fi
  if wait_healthy; then
    log "MinIO is healthy on 127.0.0.1:${CACHE_PORT}."
  else
    warn "MinIO not healthy yet; check ${LOG_DIR}/minio-stderr.log"
  fi
}

cmd_stop() {
  detect_platform
  require_cmds sudo launchctl
  detect_user
  ensure_sudo
  if daemon_loaded; then
    log "Booting out system/${DAEMON_LABEL} (plist stays installed)"
    bootout_system "${DAEMON_LABEL}"
    log "Stopped."
  else
    log "system/${DAEMON_LABEL} is not loaded; nothing to stop."
  fi
}

cmd_status() {
  detect_platform
  require_cmds curl awk sed grep uname id dscl
  detect_user
  load_config

  printf '\n'
  printf '==> runner-cache status\n'
  printf '  %-18s %s\n' "Daemon:" "${DAEMON_LABEL}"
  if daemon_loaded_n; then
    printf '  %-18s %s\n' "launchd:" "loaded"
  else
    printf '  %-18s %s\n' "launchd:" "NOT loaded (or requires sudo to inspect)"
  fi
  if curl -fsS -o /dev/null --max-time 2 \
      "http://127.0.0.1:${CACHE_PORT}/minio/health/live" 2>/dev/null; then
    printf '  %-18s %s\n' "health:" "OK (http://127.0.0.1:${CACHE_PORT}/minio/health/live)"
  else
    printf '  %-18s %s\n' "health:" "DOWN (http://127.0.0.1:${CACHE_PORT})"
  fi
  printf '  %-18s %s\n' "S3 endpoint:" "http://127.0.0.1:${CACHE_PORT}"
  printf '  %-18s %s\n' "Console:" "http://127.0.0.1:${CACHE_CONSOLE_PORT}"
  printf '  %-18s %s\n' "Data dir:" "${CACHE_ROOT}/data"
  if [[ -d "${CACHE_ROOT}/data" ]]; then
    printf '  %-18s %s\n' "Disk usage:" "$(as_user du -sh "${CACHE_ROOT}/data" 2>/dev/null | awk '{print $1}' || true)"
  fi
  printf '  %-18s ' "Buckets:"
  if [[ -n "${MINIO_ROOT_USER}" ]] && command -v mc >/dev/null 2>&1; then
    local buckets
    buckets="$(mc_admin ls cache 2>/dev/null | awk '{print $NF}' | sed 's|/$||' | tr '\n' ' ' || true)"
    printf '%s\n' "${buckets:-(none)}"
  else
    printf '%s\n' "(unknown — not installed or mc missing)"
  fi
  printf '\n'
}

# ----------------------------------------------------------------------------
# env — print the runner-service configuration for a scope (stdout), with the
# wiring instructions on stderr. Credentials are NEVER printed.
# ----------------------------------------------------------------------------
cmd_env() {
  detect_platform
  require_cmds uname id dscl
  detect_user
  pick_scope
  local sf
  sf="$(scope_file "${SCOPE_SLUG}")"
  if [[ ! -r "${sf}" ]]; then
    err "Scope '${SCOPE_SLUG}' is not installed. Run:"
    err "  ${PROG_NAME} install $( [[ -n "${ORG}" ]] && printf -- '--org %s' "${ORG}" || printf -- '--repo %s' "${REPO}" )"
    exit 1
  fi
  # shellcheck disable=SC1090
  . "${sf}"
  load_config

  # stdout: the exact configuration (safe to capture/eval).
  cat <<EOF
ACTIONS_CACHE_URL=http://127.0.0.1:${CACHE_PORT}/
ACTIONS_RESULTS_URL=http://127.0.0.1:${CACHE_PORT}/
ACTIONS_CACHE_SERVICE_V2=true
EOF

  # stderr: how to wire it up.
  cat >&2 <<EOF

==> Scope '${SCOPE_SLUG}' uses bucket '${BUCKET}' on this host's MinIO.
    S3 credentials for the bucket are in ${sf} (0600) — read them
    with sudo only if you need to configure external tooling; they are
    intentionally not printed here.

==> WHERE THESE GO — the runner SERVICE, not the workflow:
    The runner process reads ACTIONS_CACHE_URL / ACTIONS_RESULTS_URL /
    ACTIONS_CACHE_SERVICE_V2 at STARTUP to choose its cache backend, so they
    must be set in the runner LaunchDaemon's EnvironmentVariables — the plist
    runner-setup wrote at:

      ${LAUNCH_DAEMON_DIR}/com.github.runner-N.plist

    Add to its <key>EnvironmentVariables</key> dict:

      <key>ACTIONS_CACHE_URL</key><string>http://127.0.0.1:${CACHE_PORT}/</string>
      <key>ACTIONS_RESULTS_URL</key><string>http://127.0.0.1:${CACHE_PORT}/</string>
      <key>ACTIONS_CACHE_SERVICE_V2</key><string>true</string>

    Then restart that runner (repeat per runner-N):

      sudo launchctl kickstart -k system/com.github.runner-N

    Setting these per-job ('env:' in a workflow) does NOT work — by the time a
    job runs, the runner has already picked its cache backend.

==> WORKFLOW SNIPPET — once the service env is set, actions/cache is
    transparent (no workflow changes):

      - uses: actions/cache@v4
        with:
          path: ~/Library/Caches/Homebrew
          key: brew-\${{ runner.os }}-\${{ hashFiles('**/Brewfile.lock.json') }}

    v2 backend: ACTIONS_CACHE_SERVICE_V2=true + ACTIONS_RESULTS_URL selects the
    newer cache-results service path; legacy v1 clients fall back to
    ACTIONS_CACHE_URL alone. Both point at the same local MinIO here.
EOF
}

# ----------------------------------------------------------------------------
# metrics — scrape MinIO's Prometheus endpoint (auth disabled via
# MINIO_PROMETHEUS_AUTH_TYPE=public in the generated env file) and summarize
# basic hit/miss counters. Full exposition is at:
#   http://127.0.0.1:PORT/minio/v2/metrics/cluster
# ----------------------------------------------------------------------------
cmd_metrics() {
  detect_platform
  require_cmds curl awk
  detect_user
  load_config

  local url="http://127.0.0.1:${CACHE_PORT}/minio/v2/metrics/cluster"
  local body
  if ! body="$(curl -fsS --max-time 5 "${url}" 2>/dev/null)"; then
    err "Could not scrape ${url}"
    err "Is the backend running? Check: ${PROG_NAME} status"
    exit 1
  fi

  if [[ "${RAW}" -eq 1 ]]; then
    printf '%s\n' "${body}"
    return 0
  fi

  local total gets puts e4xx e5xx rx tx
  total="$(printf '%s\n' "${body}" | awk '/^minio_s3_requests_total\{/ {s+=$NF} END {printf "%.0f", s+0}')"
  gets="$(printf '%s\n' "${body}" | awk '/^minio_s3_requests_total\{.*api="getobject"/ {s+=$NF} END {printf "%.0f", s+0}')"
  puts="$(printf '%s\n' "${body}" | awk '/^minio_s3_requests_total\{.*api="putobject"/ {s+=$NF} END {printf "%.0f", s+0}')"
  e4xx="$(printf '%s\n' "${body}" | awk '/^minio_s3_requests_4xx_errors_total\{/ {s+=$NF} END {printf "%.0f", s+0}')"
  e5xx="$(printf '%s\n' "${body}" | awk '/^minio_s3_requests_5xx_errors_total\{/ {s+=$NF} END {printf "%.0f", s+0}')"
  rx="$(printf '%s\n' "${body}" | awk '/^minio_s3_traffic_received_bytes_total\{/ {s+=$NF} END {printf "%.0f", s+0}')"
  tx="$(printf '%s\n' "${body}" | awk '/^minio_s3_traffic_sent_bytes_total\{/ {s+=$NF} END {printf "%.0f", s+0}')"

  printf '\n'
  printf '==> runner-cache metrics (from %s)\n' "${url}"
  printf '  %-34s %s\n' "S3 requests (total):" "${total}"
  printf '  %-34s %s\n' "GET objects (cache reads):" "${gets}"
  printf '  %-34s %s\n' "PUT objects (cache writes):" "${puts}"
  printf '  %-34s %s\n' "4xx errors (incl. misses):" "${e4xx}"
  printf '  %-34s %s\n' "5xx errors:" "${e5xx}"
  printf '  %-34s %s\n' "Bytes received:" "${rx}"
  printf '  %-34s %s\n' "Bytes sent:" "${tx}"
  if [[ "${gets}" -gt 0 ]]; then
    awk -v g="${gets}" -v m="${e4xx}" 'BEGIN {
      hr = (g + m) > 0 ? (g / (g + m)) * 100 : 0
      printf "  %-34s %.1f%%\n", "Approx. read hit rate:", hr
    }'
  fi
  printf '\n'
  log "Raw Prometheus exposition: ${PROG_NAME} metrics --raw"
  log "Scrape target for Prometheus/Grafana: ${url}"
}

# ----------------------------------------------------------------------------
# uninstall
# ----------------------------------------------------------------------------
cmd_uninstall() {
  detect_platform
  require_cmds sudo launchctl rm uname id dscl
  detect_user

  if [[ ! -f "${PLIST_DEST}" && ! -d "${CACHE_ROOT}" ]]; then
    log "Nothing installed; nothing to uninstall."
    exit 0
  fi

  if [[ "${ASSUME_YES}" -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
      err "Refusing to uninstall without confirmation (no TTY). Re-run with --yes."
      exit 1
    fi
    log "About to PERMANENTLY remove:"
    printf '     - %s\n' "${PLIST_DEST}" >&2
    if [[ "${KEEP_DATA}" -eq 1 ]]; then
      printf '     - %s (config, logs, wrapper; data kept)\n' "${CACHE_ROOT}" >&2
    else
      printf '     - %s (INCLUDING all cached blobs)\n' "${CACHE_ROOT}" >&2
    fi
    local reply
    printf '\033[1;33m?\033[0m Proceed? [y/N] ' >&2
    read -r reply
    case "${reply}" in
      y|Y|yes|YES) ;;
      *) log "Aborted; nothing removed."; exit 0 ;;
    esac
  fi

  ensure_sudo

  if daemon_loaded; then
    step "Booting out system/${DAEMON_LABEL}"
    bootout_system "${DAEMON_LABEL}"
  fi
  if [[ -e "${PLIST_DEST}" ]]; then
    step "Removing ${PLIST_DEST}"
    sudo rm -f "${PLIST_DEST}"
  fi
  if [[ -d "${CACHE_ROOT}" ]]; then
    if [[ "${KEEP_DATA}" -eq 1 ]]; then
      step "Removing ${CACHE_ROOT} except data/"
      sudo rm -rf "${CACHE_ROOT}/config" "${CACHE_ROOT}/bin" "${CACHE_ROOT}/logs"
    else
      step "Deleting ${CACHE_ROOT}"
      sudo rm -rf "${CACHE_ROOT}"
    fi
  fi

  log "Uninstall complete."
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
  parse_args "$@"
  case "${COMMAND}" in
    install)   cmd_install ;;
    start)     cmd_start ;;
    stop)      cmd_stop ;;
    status)    cmd_status ;;
    env)       cmd_env ;;
    metrics)   cmd_metrics ;;
    uninstall) cmd_uninstall ;;
  esac
}

main "$@"

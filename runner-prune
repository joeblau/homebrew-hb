#!/usr/bin/env bash
#
# runner-prune — reclaim disk between GitHub Actions jobs on macOS runners
#
# Usage:
#   runner-prune [--runners-dir DIR] [--min-free-gb N] [--dry-run]
#
# Job hooks clean only their own runner's checkouts. Tool/download caches stay
# warm by default. Fleet-wide cleanup and shared-cache eviction require an
# explicit offline maintenance window; neither is safe while jobs are running.

set -euo pipefail

# ----------------------------------------------------------------------------
# Constants / globals
# ----------------------------------------------------------------------------
PROG_NAME="$(basename "$0")"
RUNNERS_DIR="/opt/github-runners"
DEFAULT_MIN_FREE_GB=20
EXIT_LOW_DISK=75        # distinctive refusal code: free space below threshold

MIN_FREE_GB="${DEFAULT_MIN_FREE_GB}"
DRY_RUN=0
RUNNER_DIR=""
ALL_RUNNERS=0
OFFLINE=0
PURGE_CACHES=0

REAL_USER=""
REAL_HOME=""

# ----------------------------------------------------------------------------
# Output helpers — progress to stderr, every line timestamped so hook output
# captured under _diag can be correlated with job times.
# ----------------------------------------------------------------------------
ts()   { date '+%Y-%m-%d %H:%M:%S'; }
log()  { printf '\033[1;34m==>\033[0m [%s] %s\n' "$(ts)" "$*" >&2; }
step() { printf '\033[1;32m  ->\033[0m [%s] %s\n' "$(ts)" "$*" >&2; }
warn() { printf '\033[1;33mWARN:\033[0m [%s] %s\n' "$(ts)" "$*" >&2; }
err()  { printf '\033[1;31mERROR:\033[0m [%s] %s\n' "$(ts)" "$*" >&2; }

usage() {
  cat >&2 <<EOF
${PROG_NAME} — reclaim disk between GitHub Actions jobs on macOS runners

USAGE:
  ${PROG_NAME} [--runner-dir DIR] [--min-free-gb N] [--dry-run]
  ${PROG_NAME} --all --offline [--purge-caches] [--dry-run]

OPTIONS:
  --runner-dir DIR   Clean one runner's checkouts, preserving _tool, _actions,
                      and _temp. In job hooks, inferred from RUNNER_TEMP.
  --runners-dir DIR  Fleet root (default: ${RUNNERS_DIR}).
  --all              Clean all runner checkouts; requires --offline.
  --offline          Confirm every runner and other cache consumer is stopped.
  --purge-caches     Also evict shared package caches; requires --all --offline.
  --min-free-gb N    Free-space floor in GiB (default: ${DEFAULT_MIN_FREE_GB}).
  --dry-run          Report paths/sizes; delete nothing.
  -h, --help         Show this help and exit.

ENVIRONMENT:
  RUNNER_TEMP         Identifies the active runner inside a job hook.
  RUNNER_PRUNE_DOCKER  Set to 1 for Docker system prune -af --volumes;
                       requires --all --offline, never allowed in a job hook.

EXAMPLES:
  ${PROG_NAME}                       # scoped post-job hook via RUNNER_TEMP
  ${PROG_NAME} --runner-dir /opt/github-runners/runner-1 --dry-run
  ${PROG_NAME} --all --offline --purge-caches

EXIT CODES:
  0    Cleanup complete (or dry-run).
  1    Operation failed or unsafe path.
  2    Usage error or missing maintenance acknowledgement.
  ${EXIT_LOW_DISK}   Free disk below the floor. This exit alone does not stop the runner.

Run as the non-root runner owner. Schedule shared-cache eviction only after
stopping all runners and other cache consumers. See docs/disk-cleanup.md.

EOF
}

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --runners-dir)
        [[ $# -ge 2 ]] || { err "--runners-dir requires a value"; usage; exit 2; }
        RUNNERS_DIR="$2"; shift 2 ;;
      --runners-dir=*) RUNNERS_DIR="${1#*=}"; shift ;;
      --runner-dir)
        [[ $# -ge 2 ]] || { err "--runner-dir requires a value"; exit 2; }
        RUNNER_DIR="$2"; shift 2 ;;
      --runner-dir=*) RUNNER_DIR="${1#*=}"; shift ;;
      --all) ALL_RUNNERS=1; shift ;;
      --offline) OFFLINE=1; shift ;;
      --purge-caches) PURGE_CACHES=1; shift ;;
      --min-free-gb)
        [[ $# -ge 2 ]] || { err "--min-free-gb requires a value"; usage; exit 2; }
        MIN_FREE_GB="$2"; shift 2 ;;
      --min-free-gb=*) MIN_FREE_GB="${1#*=}"; shift ;;
      --dry-run)       DRY_RUN=1; shift ;;
      -h|--help)       usage; exit 0 ;;
      *)
        err "Unknown argument: $1"
        usage
        exit 2 ;;
    esac
  done

  # Strip ALL trailing slashes so globbing/paths below stay clean.
  while [[ "${RUNNERS_DIR}" == */ && "${RUNNERS_DIR}" != "/" ]]; do
    RUNNERS_DIR="${RUNNERS_DIR%/}"
  done

  if ! [[ "${MIN_FREE_GB}" =~ ^[0-9]+$ ]] || [[ "${MIN_FREE_GB}" -lt 1 ]]; then
    err "--min-free-gb must be a positive integer (got: '${MIN_FREE_GB}')"
    exit 2
  fi
  if [[ "${ALL_RUNNERS}" -eq 1 && -n "${RUNNER_DIR}" ]]; then
    err "Choose --runner-dir or --all, not both."; exit 2
  fi
  if [[ "${ALL_RUNNERS}" -eq 1 || "${PURGE_CACHES}" -eq 1 || "${RUNNER_PRUNE_DOCKER:-0}" == 1 ]]; then
    if [[ "${ALL_RUNNERS}" -ne 1 || "${OFFLINE}" -ne 1 || "${GITHUB_ACTIONS:-false}" == true || -n "${RUNNER_TEMP:-}" ]]; then
      err "Fleet/shared-cache cleanup requires --all --offline outside a job hook."; exit 2
    fi
  fi
  if [[ "${ALL_RUNNERS}" -eq 0 && -z "${RUNNER_DIR}" ]]; then
    case "${RUNNER_TEMP:-}" in
      */_work/_temp) RUNNER_DIR="${RUNNER_TEMP%/_work/_temp}" ;;
      *) err "Specify --runner-dir, or --all --offline; hooks supply RUNNER_TEMP."; exit 2 ;;
    esac
  fi

}

# ----------------------------------------------------------------------------
# Environment detection (mirrors runner-setup / runner-cleanup)
# ----------------------------------------------------------------------------
detect_platform() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    err "This tool only supports macOS."
    exit 1
  fi
}

require_cmds() {
  local missing=() c
  for c in uname id df awk du rm mkdir date; do
    command -v "${c}" >/dev/null 2>&1 || missing+=("${c}")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Required command(s) not found: ${missing[*]}"
    exit 1
  fi
}

detect_user() {
  # Resolve the real invoking user; never operate as root.
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    REAL_USER="${SUDO_USER}"
  else
    REAL_USER="$(whoami)"
  fi
  if [[ "${REAL_USER}" == "root" ]]; then
    err "Refusing to prune as root. Run this as the user that owns the runners;"
    err "it uses sudo only internally (non-interactively) for /opt leftovers."
    exit 1
  fi
  # `|| true`: dscl exits non-zero for a non-local (e.g. MDM/AD) user record,
  # and with `pipefail` that would abort the whole script before the fallback.
  REAL_HOME="$(dscl . -read "/Users/${REAL_USER}" NFSHomeDirectory 2>/dev/null \
    | awk '{print $2}' || true)"
  [[ -n "${REAL_HOME}" ]] || REAL_HOME="/Users/${REAL_USER}"
  step "Pruning as ${REAL_USER} (home ${REAL_HOME})"
}

# ----------------------------------------------------------------------------
# Free-space helpers
# ----------------------------------------------------------------------------
# Free space (in 1K blocks) on the volume holding the runners dir.
free_kb() {
  local target="${RUNNERS_DIR}"
  [[ -d "${target}" ]] || target="/"
  df -kP "${target}" | awk 'NR==2 && $4 ~ /^[0-9]+$/ {print $4; ok=1} END {if (!ok) exit 1}'
}

# Human-readable GiB for a 1K-block count (integer, awk-formatted).
gb_of() {
  awk -v kb="$1" 'BEGIN { printf "%.1f", kb / 1048576 }'
}

report_free() {
  local label="$1"
  local avail_kb
  # Capture-then-check so set -e isn't masked inside command substitution.
  if ! avail_kb="$(free_kb)"; then
    err "Could not determine free disk space (df failed)."
    exit 1
  fi
  step "Free disk (${label}): $(gb_of "${avail_kb}") GiB available"
}

# ----------------------------------------------------------------------------
# Deletion helpers. kb_of and remove_path are tolerant of unreadable entries.
# ----------------------------------------------------------------------------
kb_of() {
  local target="$1"
  # The trailing `|| true` is REQUIRED: du exits non-zero on permission errors
  # (job may have left root-owned files), and with `set -euo pipefail` a plain
  # assignment whose pipeline fails would abort the script before we can log.
  du -sk "${target}" 2>/dev/null | awk '{print $1}' || true
}

remove_path() {
  local target="$1"
  local desc="$2"

  if [[ ! -e "${target}" && ! -L "${target}" ]]; then
    step "Not present, skipping: ${target}"
    return 0
  fi

  local size_kb
  size_kb="$(kb_of "${target}")"

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would remove ${desc}: ${target} ($(gb_of "${size_kb:-0}") GiB)"
    return 0
  fi

  # Try as the invoking user first. runner-setup chowns everything under
  # /opt/github-runners to the real user, so this normally succeeds and no
  # sudo (and no password prompt inside a headless hook) is needed. Fall back
  # to NON-INTERACTIVE sudo only for root-owned files a job left behind.
  if rm -rf "${target}" 2>/dev/null; then
    step "Removed ${desc}: ${target} ($(gb_of "${size_kb:-0}") GiB)"
  elif sudo -n rm -rf "${target}" 2>/dev/null; then
    warn "Removed ${desc} with sudo (job left root-owned files): ${target}"
  else
    err "Could not remove ${desc}: ${target} (permission denied)"
    return 1
  fi
}

# ----------------------------------------------------------------------------
# 1) Clean checkouts only. Never evict a neighbor's workspace from a job hook.
# ----------------------------------------------------------------------------
canonical_runner_path() {
  local dir="${1%/}" parent base
  [[ ! -L "${dir}" ]] || { err "Refusing symlinked runner: ${dir}"; return 1; }
  base="${dir##*/}"
  parent="${dir%/*}"
  [[ "${parent}" != "${dir}" ]] || parent=.
  parent="$(cd "${parent}" && pwd -P)" || return 1
  printf '%s/%s' "${parent}" "${base}"
}

validate_runner_dir() {
  local dir="$1" base="${1##*/}"
  if [[ "${dir%/*}" != "${RUNNERS_DIR}" || ! "${base}" =~ ^runner-[0-9]+$ || -L "${dir}" || ! -d "${dir}" ]]; then
    err "Unsafe runner directory: ${dir}"; return 1
  fi
  if [[ -L "${dir}/_work" ]]; then
    err "Refusing symlinked work directory: ${dir}/_work"; return 1
  fi
}

purge_one_work_dir() {
  local dir="$1" entry base rc=0
  validate_runner_dir "${dir}" || return 1
  [[ -d "${dir}/_work" ]] || return 0
  shopt -s nullglob dotglob
  for entry in "${dir}/_work"/*; do
    base="${entry##*/}"
    case "${base}" in
      _tool|_actions|_temp|_PipelineMapping) continue ;;
    esac
    remove_path "${entry}" "checkout/build output" || rc=1
  done
  shopt -u nullglob dotglob
  return "${rc}"
}

purge_work_dirs() {
  local dir rc=0
  if [[ "${ALL_RUNNERS}" -eq 1 ]]; then
    shopt -s nullglob
    for dir in "${RUNNERS_DIR}"/runner-*; do
      purge_one_work_dir "${dir}" || rc=1
    done
    shopt -u nullglob
  else
    purge_one_work_dir "${RUNNER_DIR}" || rc=1
  fi
  return "${rc}"
}

# ----------------------------------------------------------------------------
# 2) Clear common tool caches in the invoking user's home. Each entry is
#    guarded, so a missing dir (toolchain not used here) is fine.
# ----------------------------------------------------------------------------
purge_caches() {
  if [[ "${PURGE_CACHES}" -ne 1 ]]; then
    step "Keeping package caches warm (offline eviction: --all --offline --purge-caches)."
    return 0
  fi
  log "Clearing tool caches under ${REAL_HOME}"
  local rel rc=0
  for rel in \
    "Library/Caches/Homebrew" \
    "Library/Caches/pip" \
    "Library/Caches/Yarn" \
    "Library/Caches/org.swift.swiftpm" \
    ".npm" \
    ".yarn/cache" \
    ".cache/pip" \
    ".gradle/caches" \
    ".m2/repository" \
  ; do
    if ! remove_path "${REAL_HOME}/${rel}" "cache"; then
      rc=1
    fi
  done
  return "${rc}"
}

# ----------------------------------------------------------------------------
# 3) Optional Docker prune — only when docker is installed AND opted in.
# ----------------------------------------------------------------------------
prune_docker() {
  if [[ "${RUNNER_PRUNE_DOCKER:-0}" != "1" ]]; then
    step "Docker prune disabled (set RUNNER_PRUNE_DOCKER=1 to enable); skipping."
    return 0
  fi
  if ! command -v docker >/dev/null 2>&1; then
    warn "RUNNER_PRUNE_DOCKER=1 but docker is not installed; skipping."
    return 0
  fi
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would run: docker system prune -af --volumes"
    return 0
  fi
  if ! docker info >/dev/null 2>&1; then
    warn "Docker daemon not reachable; skipping docker prune."
    return 0
  fi
  log "Pruning Docker (docker system prune -af --volumes)"
  if ! docker system prune -af --volumes; then
    warn "docker system prune failed; continuing."
  fi
  return 0
}

# ----------------------------------------------------------------------------
# 4) Enforce the minimum free-disk threshold AFTER cleanup.
# ----------------------------------------------------------------------------
enforce_min_free() {
  local avail_kb need_kb
  if ! avail_kb="$(free_kb)"; then
    err "Could not determine free disk space (df failed)."
    exit 1
  fi
  need_kb=$(( MIN_FREE_GB * 1048576 ))

  step "Free disk (after): $(gb_of "${avail_kb}") GiB available, minimum ${MIN_FREE_GB} GiB required"
  if (( avail_kb < need_kb )); then
    if [[ "${DRY_RUN}" -eq 1 ]]; then
      warn "Free disk is BELOW ${MIN_FREE_GB} GiB (dry-run: not refusing, would exit ${EXIT_LOW_DISK})."
      return 0
    fi
    err "LOW DISK: free disk is below ${MIN_FREE_GB} GiB after cleanup"
    err "($(gb_of "${avail_kb}") GiB available on the runner volume)."
    err "Block new jobs on this runner until an operator frees space or raises"
    err "the machine's disk. Exiting with code ${EXIT_LOW_DISK}."
    exit "${EXIT_LOW_DISK}"
  fi
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
  parse_args "$@"
  detect_platform
  require_cmds
  detect_user
  if [[ ! -d "${RUNNERS_DIR}" || -L "${RUNNERS_DIR}" ]]; then
    err "Runner root must be an existing directory, not a symlink: ${RUNNERS_DIR}"; exit 1
  fi
  RUNNERS_DIR="$(cd "${RUNNERS_DIR}" && pwd -P)"
  if [[ "${ALL_RUNNERS}" -eq 0 ]]; then
    RUNNER_DIR="$(canonical_runner_path "${RUNNER_DIR}")" || exit 1
    validate_runner_dir "${RUNNER_DIR}" || exit 1
    if [[ -n "${RUNNER_TEMP:-}" ]]; then
      local hook_runner=""
      case "${RUNNER_TEMP}" in
        */_work/_temp) hook_runner="$(canonical_runner_path "${RUNNER_TEMP%/_work/_temp}")" || exit 1 ;;
      esac
      if [[ "${hook_runner}" != "${RUNNER_DIR}" ]]; then
        err "--runner-dir must identify this job's runner (RUNNER_TEMP)."; exit 1
      fi
    fi
  fi

  log "Starting disk prune (runners dir: ${RUNNERS_DIR}, min free: ${MIN_FREE_GB} GiB$( (( DRY_RUN )) && printf ', DRY RUN' ))"
  report_free "before"

  local rc=0
  purge_work_dirs || rc=1
  purge_caches    || rc=1
  prune_docker    || rc=1

  enforce_min_free

  if [[ "${rc}" -ne 0 ]]; then
    err "Some paths could not be removed. See the log above."
  else
    log "Prune complete."
  fi
  return "${rc}"
}

main "$@"

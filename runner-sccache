#!/usr/bin/env bash
#
# runner-sccache — per-scope persistent compiler cache (sccache) for GitHub
# Actions self-hosted runners on macOS.
#
# Usage:
#   runner-sccache install (--org ORG | --repo OWNER/REPO) [--port N] [--max-size GIB]
#   runner-sccache env [--org ORG | --repo OWNER/REPO]
#   runner-sccache stats [--org ORG | --repo OWNER/REPO] [--json]
#   runner-sccache stop [--org ORG | --repo OWNER/REPO]
#   runner-sccache uninstall [--org ORG | --repo OWNER/REPO] [--yes] [--keep-data]
#
# Installs sccache via Homebrew and provisions ONE isolated on-disk cache per
# scope (--org or --repo) under /opt/github-runner-sccache/data/<slug>, with a
# dedicated loopback server port and a bounded size. Unlike runner-cache and
# runner-bazel-cache there is NO LaunchDaemon: sccache clients auto-start a
# per-user server with the environment of the build that invokes them, so the
# per-scope SCCACHE_* settings emitted by 'env' are the service definition.
# sudo is used ONLY to create /opt/github-runner-sccache.
#
# Isolation: each scope gets its OWN cache directory, its OWN loopback-only
# server port (so two scopes never share one sccache server), and its OWN size
# cap. Scope config lives in 0600 files under
# /opt/github-runner-sccache/config/scopes. Local mode has no credentials.
# sccache itself validates compiler, source, flags, and target inputs (they
# are hashed into every cache key), so changed inputs produce correct misses —
# no stale build directory is ever restored.

set -euo pipefail

# ----------------------------------------------------------------------------
# Constants / globals
# ----------------------------------------------------------------------------
PROG_NAME="$(basename "$0")"
CACHE_ROOT="/opt/github-runner-sccache"
SCOPES_DIR="${CACHE_ROOT}/config/scopes"
DEFAULT_PORT_BASE=4226
DEFAULT_MAX_SIZE_GIB=20

COMMAND=""
ORG=""
REPO=""
PORT_REQUESTED=""
MAX_SIZE_GIB=""
MAX_SIZE_GIVEN=0
ASSUME_YES=0
KEEP_DATA=0
JSON=0

# Derived from the chosen scope (--org / --repo).
SCOPE_KIND=""
SCOPE=""
SCOPE_SLUG=""

# Populated during detection / setup
REAL_USER=""
REAL_GROUP=""
REAL_UID=""
REAL_HOME=""

# Per-scope values loaded from ${SCOPES_DIR}/<slug>.env.
PORT=""
MAX_SIZE_GIB_LOADED=""
SCCACHE_BIN=""
CREATED_AT=""

# Populated by collect_stats.
STATS_REACHABLE=0
STATS_TEXT=""

# ----------------------------------------------------------------------------
# Output helpers — progress goes to stderr.
# ----------------------------------------------------------------------------
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
step() { printf '\033[1;32m  ->\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; }

usage() {
  cat >&2 <<EOF
${PROG_NAME} — per-scope persistent compiler cache (sccache) for macOS runners

USAGE:
  ${PROG_NAME} <command> [options]

COMMANDS:
  install       Install sccache via Homebrew, allocate the scope's loopback
                server port, and create its bounded cache directory and 0600
                scope config under ${CACHE_ROOT}.
  env           Print the per-scope SCCACHE_* / RUSTC_WRAPPER settings on
                stdout (append them to \$GITHUB_ENV) plus a workflow snippet
                on stderr. This is the ONLY supported integration path.
  stats         Show compile requests, cache hits/misses/errors, and cache
                size for one scope (sccache --show-stats plus disk usage).
                --json prints the same facts as one JSON object for
                benchmark output.
  stop          Stop the scope's sccache server (the cache directory stays;
                the next build restarts a server). Best-effort.
  uninstall     Stop the scope's server and delete its cache directory and
                scope config (asks for confirmation; --keep-data preserves
                both for reinstall).
  -h, --help    Show this help and exit.

SCOPE (install; optional for env/stats/stop/uninstall — choose at most ONE):
  --org ORG_NAME        Org-level cache shared by repositories of ORG_NAME.
  --repo OWNER/REPO     Repo-level cache for exactly OWNER/REPO.
                        Without a scope flag, these commands resolve a single
                        installed scope implicitly.

OPTIONS:
  --port N              Loopback port for this scope's sccache server
                        (default: first free port from ${DEFAULT_PORT_BASE}). Fixed at
                        install time; must be 1024-65535 and not used by
                        another installed scope.
  --max-size GIB        Per-scope cache size cap in GiB (default:
                        ${DEFAULT_MAX_SIZE_GIB}). sccache evicts least-recently-used
                        entries past the cap.
  --json                (stats) Emit one JSON object on stdout.
  -y, --yes             (uninstall) Do not prompt for confirmation.
  --keep-data           (uninstall) Keep the scope's data/ and config for a
                        usable reinstall.

EXAMPLES:
  ${PROG_NAME} install --repo acme/monorepo --max-size 50
  ${PROG_NAME} env --repo acme/monorepo
  ${PROG_NAME} stats --repo acme/monorepo --json
  ${PROG_NAME} stop --org acme
  ${PROG_NAME} uninstall --repo acme/monorepo --yes --keep-data

HOW IT PLUGS IN:
  'env' prints non-secret SCCACHE_DIR, SCCACHE_CACHE_SIZE, SCCACHE_SERVER_PORT,
  SCCACHE_IDLE_TIMEOUT, and RUSTC_WRAPPER lines; a workflow appends them to
  \$GITHUB_ENV before building. RUSTC_WRAPPER covers Rust/Cargo; C/C++ builds
  use CMAKE_C_COMPILER_LAUNCHER/CMAKE_CXX_COMPILER_LAUNCHER or CC/CXX wrapper
  prefixes. This tool never rewrites workflow files. sccache caches
  compilations only — linking, Xcode/Swift (swiftc), and invocations it cannot
  parse are NOT accelerated. See docs/compiler-cache.md.

FALLBACK:
  If the sccache server or cache fails, sccache runs the real compiler
  directly and counts the failure under cache errors — the build stays
  correct, just uncached. To bypass the cache entirely, drop the env step or
  unset RUSTC_WRAPPER.

TRUST:
  Per-scope directories, ports, and caps separate caches; they do NOT isolate
  jobs running as the same macOS user, which can read that user's cache
  directories. Use for trusted workloads on a dedicated Mac. A shared remote
  backend (S3 via runner-cache's MinIO) is a documented configuration path,
  not wired by this tool — see docs/compiler-cache.md.

EOF
}

# ----------------------------------------------------------------------------
# Environment detection (mirrors runner-bazel-cache / runner-cache)
# ----------------------------------------------------------------------------
detect_platform() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    err "This tool only supports macOS."
    exit 1
  fi
}

detect_user() {
  # Everything runs as the real invoking user, never root.
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    REAL_USER="${SUDO_USER}"
  else
    REAL_USER="$(whoami)"
  fi
  if [[ "${REAL_USER}" == "root" ]]; then
    err "Refusing to run as root. Run this script as a normal user; it uses"
    err "sudo only internally to create ${CACHE_ROOT}."
    exit 1
  fi
  REAL_GROUP="$(id -gn "${REAL_USER}")"
  REAL_UID="$(id -u "${REAL_USER}")"
  # `|| true`: dscl exits non-zero for a non-local (e.g. MDM/AD) user record,
  # and with `pipefail` that would abort the whole script before the fallback.
  REAL_HOME="$(dscl . -read "/Users/${REAL_USER}" NFSHomeDirectory 2>/dev/null \
    | awk '{print $2}' || true)"
  [[ -n "${REAL_HOME}" ]] || REAL_HOME="/Users/${REAL_USER}"
  step "Service owner: ${REAL_USER}:${REAL_GROUP} (uid ${REAL_UID}, home ${REAL_HOME})"
}

require_cmds() {
  local missing=()
  local c
  for c in "$@"; do
    command -v "${c}" >/dev/null 2>&1 || missing+=("${c}")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Required command(s) not found: ${missing[*]}"
    exit 1
  fi
}

ensure_sudo() {
  log "Requesting administrator privileges (needed to create ${CACHE_ROOT})"
  if ! sudo -v; then
    err "Could not obtain sudo privileges."
    exit 1
  fi
}

# Run a command as the real (non-root) user, forcing HOME/USER/LOGNAME so a
# `sudo runner-sccache ...` invocation does not leak root's HOME into sccache.
as_user() {
  if [[ "$(id -un)" == "${REAL_USER}" ]]; then
    HOME="${REAL_HOME}" USER="${REAL_USER}" LOGNAME="${REAL_USER}" "$@"
  else
    sudo -H -u "${REAL_USER}" env \
      HOME="${REAL_HOME}" \
      USER="${REAL_USER}" \
      LOGNAME="${REAL_USER}" \
      "$@"
  fi
}

# Write stdin to a file owned by the real user, mode 0600. Scope config flows
# through a heredoc/pipe, never through argv (ps).
write_secret_file() {
  local dest="$1"
  as_user bash -c 'umask 077; cat > "$1" && chmod 600 "$1"' _ "${dest}"
}

# ----------------------------------------------------------------------------
# Homebrew / sccache guards
# ----------------------------------------------------------------------------
ensure_brew() {
  if ! command -v brew >/dev/null 2>&1; then
    err "Homebrew not found; ${PROG_NAME} installs sccache via brew."
    err "Install Homebrew from https://brew.sh, then re-run:"
    err "  brew install sccache"
    exit 1
  fi
}

ensure_sccache() {
  if ! command -v sccache >/dev/null 2>&1; then
    log "sccache not found; installing via Homebrew (sccache)"
    if ! as_user brew install sccache; then
      err "Failed to install sccache."
      err "Install it manually with: brew install sccache"
      exit 1
    fi
  fi
  SCCACHE_BIN="$(command -v sccache)"
  step "sccache: ${SCCACHE_BIN}"
}

# ----------------------------------------------------------------------------
# Scope helpers
# ----------------------------------------------------------------------------
scope_file() {
  printf '%s/%s.env' "${SCOPES_DIR}" "$1"
}

data_dir() {
  printf '%s/data/%s' "${CACHE_ROOT}" "$1"
}

# Compute SCOPE_SLUG from --org / --repo. Sanitization and truncation are not
# injective, so the slug carries a digest of the canonical scope identity;
# distinct scopes never silently share a cache directory.
resolve_scope() {
  local raw
  if [[ -n "${ORG}" ]]; then
    SCOPE_KIND="org"
    raw="${ORG}"
    SCOPE="${ORG}"
  else
    SCOPE_KIND="repo"
    raw="${REPO//\//-}"
    SCOPE="${REPO}"
  fi
  local slug digest
  slug="$(printf '%s' "${raw}" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | tr -s '-')"
  slug="${slug#-}"; slug="${slug%-}"
  [[ -n "${slug}" ]] || { err "Could not derive a valid scope slug."; exit 2; }
  digest="$(printf '%s:%s' "${SCOPE_KIND}" "${SCOPE}" | tr 'A-Z' 'a-z' | shasum -a 256 | awk '{print $1}')"
  SCOPE_SLUG="${SCOPE_KIND}-${slug:0:27}-${digest:0:16}"
}

# Load a scope's config into globals.
load_scope() {
  local sf
  sf="$(scope_file "$1")"
  if [[ ! -r "${sf}" ]]; then
    err "Scope '$1' is not installed. Run install with the same scope."
    exit 1
  fi
  # shellcheck disable=SC1090
  . "${sf}"
  MAX_SIZE_GIB_LOADED="${MAX_SIZE_GIB}"
  SCOPE_SLUG="$1"
}

# Print all installed scope slugs, one per line.
list_scopes() {
  local f
  for f in "${SCOPES_DIR}"/*.env; do
    [[ -f "${f}" ]] || continue
    basename "${f}" .env
  done
}

# Resolve the scope for env/stats/stop/uninstall: explicit flags win;
# otherwise a single installed scope is used unambiguously.
pick_scope() {
  if [[ -n "${ORG}" || -n "${REPO}" ]]; then
    resolve_scope
    return 0
  fi
  local f count=0 chosen=""
  for f in "${SCOPES_DIR}"/*.env; do
    [[ -f "${f}" ]] || continue
    count=$((count + 1))
    chosen="${f}"
  done
  if [[ "${count}" -eq 0 ]]; then
    err "No sccache scope installed yet. Run: ${PROG_NAME} install --org ORG (or --repo OWNER/REPO)"
    exit 1
  elif [[ "${count}" -gt 1 ]]; then
    err "Multiple scopes installed; pick one with --org or --repo:"
    list_scopes | sed 's/^/     - /' >&2
    exit 2
  fi
  SCOPE_SLUG="$(basename "${chosen}" .env)"
}

# Allocate a loopback port for a new scope: the requested port if free,
# otherwise the first unused port from DEFAULT_PORT_BASE.
allocate_port() {
  local requested="$1" f used
  if [[ -n "${requested}" ]]; then
    for f in "${SCOPES_DIR}"/*.env; do
      [[ -f "${f}" ]] || continue
      used="$(. "${f}"; printf '%s' "${PORT}")"
      if [[ "${used}" == "${requested}" ]]; then
        err "Port ${requested} is already used by scope '$(basename "${f}" .env)'."
        exit 2
      fi
    done
    printf '%s\n' "${requested}"
    return 0
  fi
  local port="${DEFAULT_PORT_BASE}" taken
  while :; do
    taken=0
    for f in "${SCOPES_DIR}"/*.env; do
      [[ -f "${f}" ]] || continue
      used="$(. "${f}"; printf '%s' "${PORT}")"
      if [[ "${used}" == "${port}" ]]; then
        taken=1
        break
      fi
    done
    [[ "${taken}" -eq 0 ]] && break
    port=$((port + 1))
  done
  printf '%s\n' "${port}"
}

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
validate_scope_names() {
  if [[ -n "${ORG}" ]] && ! [[ "${ORG}" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]]; then
    err "--org must be a GitHub organization name (letters, digits, hyphens; max 39 characters)."
    exit 2
  fi
  if [[ -n "${REPO}" ]] && ! [[ "${REPO}" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$ ]]; then
    err "--repo must be a valid GitHub OWNER/REPO name."
    exit 2
  fi
}

validate_port() {
  local value="$1" flag="$2"
  if ! [[ "${value}" =~ ^[0-9]+$ ]] || [[ ${#value} -gt 5 ]] \
      || [[ "$((10#${value}))" -lt 1024 || "$((10#${value}))" -gt 65535 ]]; then
    err "${flag} must be an unprivileged TCP port (1024-65535) (got: '${value}')"
    exit 2
  fi
}

parse_args() {
  COMMAND="${1:-}"
  if [[ $# -gt 0 ]]; then shift; fi

  case "${COMMAND}" in
    ""|-h|--help|help)
      usage; exit 0 ;;
    install|env|stats|stop|uninstall) ;;
    *)
      err "Unknown command: ${COMMAND}"
      usage
      exit 2 ;;
  esac

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --org)
        [[ $# -ge 2 ]] || { err "--org requires a value"; usage; exit 2; }
        ORG="$2"; shift 2 ;;
      --org=*)     ORG="${1#*=}"; shift ;;
      --repo)
        [[ $# -ge 2 ]] || { err "--repo requires a value"; usage; exit 2; }
        REPO="$2"; shift 2 ;;
      --repo=*)    REPO="${1#*=}"; shift ;;
      --port)
        [[ $# -ge 2 ]] || { err "--port requires a value"; usage; exit 2; }
        PORT_REQUESTED="$2"; shift 2 ;;
      --port=*)    PORT_REQUESTED="${1#*=}"; shift ;;
      --max-size)
        [[ $# -ge 2 ]] || { err "--max-size requires a value"; usage; exit 2; }
        MAX_SIZE_GIB="$2"; MAX_SIZE_GIVEN=1; shift 2 ;;
      --max-size=*) MAX_SIZE_GIB="${1#*=}"; MAX_SIZE_GIVEN=1; shift ;;
      --json)      JSON=1; shift ;;
      -y|--yes)    ASSUME_YES=1; shift ;;
      --keep-data) KEEP_DATA=1; shift ;;
      -h|--help)   usage; exit 0 ;;
      *)
        err "Unknown argument: $1"
        usage
        exit 2 ;;
    esac
  done

  if [[ -n "${ORG}" && -n "${REPO}" ]]; then
    err "Choose only one of --org or --repo."
    exit 2
  fi
  validate_scope_names

  case "${COMMAND}" in
    install)
      if [[ -z "${ORG}" && -z "${REPO}" ]]; then
        err "install requires exactly one of --org or --repo."
        usage
        exit 2
      fi
      if [[ -n "${PORT_REQUESTED}" ]]; then
        validate_port "${PORT_REQUESTED}" "--port"
        PORT_REQUESTED="$((10#${PORT_REQUESTED}))"
      fi
      if [[ "${MAX_SIZE_GIVEN}" -eq 0 ]]; then
        MAX_SIZE_GIB="${DEFAULT_MAX_SIZE_GIB}"
      fi
      if ! [[ "${MAX_SIZE_GIB}" =~ ^[0-9]+$ ]] \
          || [[ "$((10#${MAX_SIZE_GIB}))" -lt 1 || "$((10#${MAX_SIZE_GIB}))" -gt 4096 ]]; then
        err "--max-size must be a size in GiB (1-4096) (got: '${MAX_SIZE_GIB}')"
        exit 2
      fi
      MAX_SIZE_GIB="$((10#${MAX_SIZE_GIB}))"
      ;;
  esac
}

# ----------------------------------------------------------------------------
# Per-scope provisioning: isolated cache dir + 0600 scope config.
# ----------------------------------------------------------------------------
provision_scope() {
  local slug="${SCOPE_SLUG}" sf dd
  sf="$(scope_file "${slug}")"
  dd="$(data_dir "${slug}")"

  as_user mkdir -p "${dd}"
  as_user chmod 700 "${dd}"

  if [[ -f "${sf}" ]]; then
    step "Scope '${slug}' already installed; reusing its fixed port and cap."
    load_scope "${slug}"
    as_user chmod 600 "${sf}"
  else
    write_secret_file "${sf}" <<EOF
SCOPE_KIND="${SCOPE_KIND}"
SCOPE="${SCOPE}"
PORT="${PORT}"
MAX_SIZE_GIB="${MAX_SIZE_GIB}"
SCCACHE_BIN="${SCCACHE_BIN}"
CREATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
EOF
    step "Scope config written to ${sf} (0600)"
  fi
}

# ----------------------------------------------------------------------------
# install
# ----------------------------------------------------------------------------
cmd_install() {
  detect_platform
  require_cmds awk sed grep tr uname id sudo dscl shasum date basename du head
  detect_user
  ensure_brew
  ensure_sccache
  resolve_scope

  local sf
  sf="$(scope_file "${SCOPE_SLUG}")"
  if [[ -f "${sf}" ]]; then
    # Reinstall: port and size cap fixed at first install win.
    load_scope "${SCOPE_SLUG}"
    MAX_SIZE_GIB="${MAX_SIZE_GIB_LOADED}"
    if [[ -n "${PORT_REQUESTED}" && "${PORT_REQUESTED}" != "${PORT}" ]]; then
      warn "Port is already fixed at ${PORT} from the first install; ignoring"
      warn "--port. Uninstall the scope first to change it."
    fi
    if [[ "${MAX_SIZE_GIVEN}" -eq 1 ]]; then
      warn "Size cap is already fixed at ${MAX_SIZE_GIB} GiB from the first"
      warn "install; ignoring --max-size. Uninstall the scope first to change it."
    fi
  else
    PORT="$(allocate_port "${PORT_REQUESTED}")"
  fi

  # --- Root-owned scaffolding for /opt, handed to the real user. -----------
  if [[ ! -d "${CACHE_ROOT}" ]]; then
    ensure_sudo
    log "Creating ${CACHE_ROOT} (sudo) and chowning to ${REAL_USER}:${REAL_GROUP}"
    sudo mkdir -p "${CACHE_ROOT}"
    sudo chown "${REAL_USER}:${REAL_GROUP}" "${CACHE_ROOT}"
  fi
  as_user mkdir -p "${CACHE_ROOT}/data" "${SCOPES_DIR}"
  as_user chmod 700 "${CACHE_ROOT}/config" "${SCOPES_DIR}"

  log "Provisioning scope '${SCOPE_SLUG}' (127.0.0.1:${PORT}, cap ${MAX_SIZE_GIB} GiB)"
  provision_scope

  printf '\n'
  log "sccache scope '${SCOPE_SLUG}' installed for ${SCOPE}."
  log "Cache dir:    $(data_dir "${SCOPE_SLUG}") (cap ${MAX_SIZE_GIB} GiB, LRU eviction)"
  log "Server port:  127.0.0.1:${PORT} (dedicated to this scope)"
  log "Next step:    ${PROG_NAME} env $( [[ "${SCOPE_KIND}" == "org" ]] && printf -- '--org %s' "${SCOPE}" || printf -- '--repo %s' "${SCOPE}" )"
}

# ----------------------------------------------------------------------------
# env — print non-secret per-scope settings on stdout; workflow instructions
# on stderr.
# ----------------------------------------------------------------------------
cmd_env() {
  detect_platform
  require_cmds uname id dscl shasum awk tr
  detect_user
  pick_scope
  local sf scope_flag
  sf="$(scope_file "${SCOPE_SLUG}")"
  load_scope "${SCOPE_SLUG}"

  if [[ ! -x "${SCCACHE_BIN}" ]] && ! command -v sccache >/dev/null 2>&1; then
    warn "sccache binary '${SCCACHE_BIN}' recorded at install time is not"
    warn "executable and no sccache is on PATH; re-run install or: brew install sccache"
  fi

  cat <<EOF
SCCACHE_BIN=${SCCACHE_BIN}
SCCACHE_DIR=$(data_dir "${SCOPE_SLUG}")
SCCACHE_CACHE_SIZE=${MAX_SIZE_GIB}G
SCCACHE_SERVER_PORT=${PORT}
SCCACHE_IDLE_TIMEOUT=0
RUSTC_WRAPPER=${SCCACHE_BIN}
EOF

  if [[ "${SCOPE_KIND}" == "org" ]]; then
    scope_flag="--org ${SCOPE}"
  else
    scope_flag="--repo ${SCOPE}"
  fi

  cat >&2 <<EOF

==> Scope '${SCOPE_SLUG}' uses a dedicated on-disk sccache cache on this host.
    Scope config: ${sf} (0600). Local mode has no credentials.

==> Make the settings active in ONE early workflow step (the cache config
    stays workflow-owned; this tool never rewrites workflow files):

      - name: Configure sccache
        run: ${PROG_NAME} env ${scope_flag} >> "\$GITHUB_ENV"

    Rust/Cargo builds then pick up RUSTC_WRAPPER automatically:

      - name: Build (Rust)
        run: cargo build --locked --release

    CMake C/C++ builds route compilations through sccache with launcher args:

      - name: Build (CMake C/C++)
        run: cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER_LAUNCHER=sccache -DCMAKE_CXX_COMPILER_LAUNCHER=sccache && cmake --build build

    Other C/C++ build systems can wrap the compiler explicitly:
    export CC="sccache cc" CXX="sccache c++" before invoking make/ninja.

    ALWAYS export SCCACHE_DIR, SCCACHE_CACHE_SIZE, and SCCACHE_SERVER_PORT
    together (the \$GITHUB_ENV step above does): the per-scope port keeps two
    scopes from silently sharing one sccache server — and therefore one cache.

    NOT ACCELERATED (unsupported): Xcode/Swift builds (swiftc is not supported
    by sccache — language-specific caches like Xcode's derived data need
    separate integrations), linking steps, and compiler invocations sccache
    cannot parse. Those compile normally and are never poisoned by the cache.

    FALLBACK: if the sccache server or cache fails, sccache runs the real
    compiler directly and counts the failure under cache errors — the build
    stays correct, just uncached. To bypass the cache entirely, drop the env
    step or unset RUSTC_WRAPPER.

    Record '${PROG_NAME} stats ${scope_flag} --json' before and after a warm
    rebuild to include requests/hits/misses/errors and cache size in
    benchmark output. See docs/compiler-cache.md.
EOF
}

# ----------------------------------------------------------------------------
# stats — sccache --show-stats (requests/hits/misses/errors) plus disk usage.
# ----------------------------------------------------------------------------
# Extract a numeric counter by exact label from sccache's text stats. Labels
# are followed by padding spaces then the value; anchored so that e.g.
# "Compile requests executed" never matches "Compile requests".
stat_field() {
  local v
  v="$(printf '%s\n' "${STATS_TEXT}" | sed -n "s/^$1  *\([0-9][0-9]*\).*/\1/p" | head -n 1)"
  [[ "${v}" =~ ^[0-9]+$ ]] || v=0
  printf '%s' "${v}"
}

collect_stats() {
  STATS_REACHABLE=0
  STATS_TEXT=""
  local out
  if out="$(as_user env \
      SCCACHE_SERVER_PORT="${PORT}" \
      SCCACHE_DIR="$(data_dir "${SCOPE_SLUG}")" \
      SCCACHE_CACHE_SIZE="${MAX_SIZE_GIB}G" \
      "${SCCACHE_BIN}" --show-stats 2>/dev/null)"; then
    STATS_REACHABLE=1
    STATS_TEXT="${out}"
  fi
}

# Escape for a JSON string: backslashes, quotes, tabs; other controls dropped.
json_escape() {
  printf '%s' "$1" \
    | tr -d '\000-\010\013-\037' \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g'
}

cmd_stats() {
  detect_platform
  require_cmds uname id dscl shasum awk tr sed du head basename
  detect_user
  pick_scope
  load_scope "${SCOPE_SLUG}"

  collect_stats
  local requests hits misses errors write_errors usage_kb dd
  dd="$(data_dir "${SCOPE_SLUG}")"
  if [[ "${STATS_REACHABLE}" -eq 1 ]]; then
    requests="$(stat_field "Compile requests")"
    hits="$(stat_field "Cache hits")"
    misses="$(stat_field "Cache misses")"
    errors="$(stat_field "Cache errors")"
    write_errors="$(stat_field "Cache write errors")"
  else
    requests=0; hits=0; misses=0; errors=0; write_errors=0
    warn "sccache server for scope '${SCOPE_SLUG}' is not reachable on"
    warn "127.0.0.1:${PORT} (no build has run, or it was stopped). Counters"
    warn "reported as 0; disk usage below is still accurate."
  fi
  usage_kb=null
  if [[ -d "${dd}" ]]; then
    usage_kb="$(as_user du -sk "${dd}" 2>/dev/null | awk '{print $1}' || true)"
    [[ "${usage_kb}" =~ ^[0-9]+$ ]] || usage_kb=null
  fi

  if [[ "${JSON}" -eq 1 ]]; then
    printf '{"tool":"runner-sccache","slug":"%s","kind":"%s","scope":"%s","port":%s,"server_reachable":%s,"compile_requests":%s,"cache_hits":%s,"cache_misses":%s,"cache_errors":%s,"cache_write_errors":%s,"disk_usage_kb":%s,"max_size_gib":%s}\n' \
      "$(json_escape "${SCOPE_SLUG}")" "$(json_escape "${SCOPE_KIND}")" "$(json_escape "${SCOPE}")" \
      "${PORT}" \
      "$( [[ "${STATS_REACHABLE}" -eq 1 ]] && printf true || printf false )" \
      "${requests}" "${hits}" "${misses}" "${errors}" "${write_errors}" \
      "${usage_kb}" "${MAX_SIZE_GIB}"
    return 0
  fi

  printf '\n'
  printf '==> runner-sccache stats: scope %s (%s %s)\n' "${SCOPE_SLUG}" "${SCOPE_KIND}" "${SCOPE}"
  if [[ "${STATS_REACHABLE}" -eq 1 ]]; then
    printf '  %-20s %s\n' "server:" "reachable on 127.0.0.1:${PORT}"
  else
    printf '  %-20s %s\n' "server:" "NOT reachable on 127.0.0.1:${PORT}"
  fi
  printf '  %-20s %s\n' "compile requests:" "${requests}"
  printf '  %-20s %s\n' "cache hits:" "${hits}"
  printf '  %-20s %s\n' "cache misses:" "${misses}"
  printf '  %-20s %s\n' "cache errors:" "${errors} (write errors: ${write_errors})"
  printf '  %-20s %s\n' "data dir:" "${dd}"
  if [[ -d "${dd}" ]]; then
    printf '  %-20s %s\n' "disk usage:" "$(as_user du -sh "${dd}" 2>/dev/null | awk '{print $1}' || true) of ${MAX_SIZE_GIB} GiB cap (LRU eviction)"
  else
    printf '  %-20s %s\n' "disk usage:" "no data yet (cap ${MAX_SIZE_GIB} GiB, LRU eviction)"
  fi
  printf '\n'
}

# ----------------------------------------------------------------------------
# stop — stop the scope's sccache server. Best-effort: a stopped/absent server
# is not an error. Requires load_scope to have populated PORT/SCCACHE_BIN.
# ----------------------------------------------------------------------------
stop_scope() {
  as_user env SCCACHE_SERVER_PORT="${PORT}" "${SCCACHE_BIN}" --stop-server >/dev/null 2>&1
}

cmd_stop() {
  detect_platform
  require_cmds uname id dscl shasum awk tr
  detect_user
  pick_scope
  load_scope "${SCOPE_SLUG}"
  if stop_scope; then
    log "Stopped sccache server for scope '${SCOPE_SLUG}' (127.0.0.1:${PORT})."
    log "The cache directory is untouched; the next build restarts a server."
  else
    log "No running sccache server for scope '${SCOPE_SLUG}' (or stop failed);"
    log "the cache directory is untouched either way."
  fi
}

# ----------------------------------------------------------------------------
# uninstall — removes ONE scope's server, cache data, and (unless --keep-data)
# its scope config.
# ----------------------------------------------------------------------------
cmd_uninstall() {
  detect_platform
  require_cmds uname id dscl shasum awk tr rm basename
  detect_user
  pick_scope

  local slug="${SCOPE_SLUG}" sf dd
  sf="$(scope_file "${slug}")"
  dd="$(data_dir "${slug}")"

  if [[ ! -f "${sf}" && ! -d "${dd}" ]]; then
    log "Scope '${slug}' is not installed; nothing to uninstall."
    exit 0
  fi

  if [[ "${ASSUME_YES}" -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
      err "Refusing to uninstall without confirmation (no TTY). Re-run with --yes."
      exit 1
    fi
    log "About to PERMANENTLY remove scope '${slug}':"
    if [[ "${KEEP_DATA}" -eq 1 ]]; then
      printf '     - running server only (data + config kept)\n' >&2
    else
      printf '     - %s (INCLUDING all cached compilations)\n' "${dd}" >&2
      printf '     - %s (scope config)\n' "${sf}" >&2
    fi
    local reply
    printf '\033[1;33m?\033[0m Proceed? [y/N] ' >&2
    read -r reply
    case "${reply}" in
      y|Y|yes|YES) ;;
      *) log "Aborted; nothing removed."; exit 0 ;;
    esac
  fi

  # Stop the server BEFORE deleting its cache directory so an active server
  # does not recreate entries mid-delete. Best-effort: absence is fine.
  if [[ -f "${sf}" ]]; then
    load_scope "${slug}"
    if stop_scope; then
      step "Stopped sccache server for scope '${slug}'"
    else
      step "No running sccache server for scope '${slug}' (or stop failed); continuing"
    fi
  fi

  if [[ "${KEEP_DATA}" -eq 1 ]]; then
    step "Preserving ${dd} and ${sf} for reinstall"
  else
    if [[ -d "${dd}" ]]; then
      step "Deleting ${dd}"
      as_user rm -rf "${dd}" || sudo rm -rf "${dd}"
    fi
    step "Removing scope config"
    as_user rm -f "${sf}" || sudo rm -f "${sf}"
    # Last scope gone: remove the whole cache root.
    if [[ -z "$(list_scopes)" && -d "${CACHE_ROOT}" ]]; then
      step "No scopes remain; deleting ${CACHE_ROOT}"
      as_user rm -rf "${CACHE_ROOT}" || sudo rm -rf "${CACHE_ROOT}"
    fi
  fi

  log "Uninstall of scope '${slug}' complete."
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
  parse_args "$@"
  case "${COMMAND}" in
    install)   cmd_install ;;
    env)       cmd_env ;;
    stats)     cmd_stats ;;
    stop)      cmd_stop ;;
    uninstall) cmd_uninstall ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi

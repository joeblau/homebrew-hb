#!/usr/bin/env bash
#
# runner-docker-builder — fast Docker image builds on macOS GitHub Actions runners
#
# Usage:
#   runner-docker-builder setup-remote --host ssh://user@linux-builder [--platform CSV]
#   runner-docker-builder setup-colima [--cpu N] [--mem GB] [--disk GB]
#   runner-docker-builder use-desktop
#   runner-docker-builder status
#
# Use persistent BuildKit workers to retain layers and dependency caches.
# Performance depends on the worker's CPU, storage, architecture, and network:
#
#   setup-remote   Build on a remote Linux Docker host over SSH using a
#                  persistent docker-container BuildKit builder.
#   setup-colima   Build locally via colima (a lightweight Lima VM) instead of
#                  Docker Desktop, retaining local VM and BuildKit state.
#   use-desktop    Revert to Docker Desktop's built-in builder.
#   status         Show which builder is active and how it is reachable.
#
# Run as the same non-root user as the runner service (see runner-setup).
# Client/Colima configuration uses that user's directories; BuildKit state
# lives on its Docker host. Homebrew manages CLI installations in its prefix.
# This script never invokes sudo or changes runner LaunchDaemons.

set -euo pipefail

# ----------------------------------------------------------------------------
# Constants / globals
# ----------------------------------------------------------------------------
PROG_NAME="$(basename "$0")"
REMOTE_BUILDER_NAME="runner-remote"
COLIMA_BUILDER_NAME="runner-colima"

COMMAND=""
SSH_HOST=""            # setup-remote: ssh://user@linux-builder (or BUILDER_SSH_HOST)
PLATFORM=""            # optional CSV of target platforms for the builder
COLIMA_CPU=4           # setup-colima defaults
COLIMA_MEM=8           # GiB
COLIMA_DISK=60         # GiB

# ----------------------------------------------------------------------------
# Output helpers — progress goes to stderr.
# ----------------------------------------------------------------------------
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
step() { printf '\033[1;32m  ->\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; }

usage() {
  cat >&2 <<EOF
${PROG_NAME} — fast Docker image builds on macOS GitHub Actions runners

USAGE:
  ${PROG_NAME} setup-remote --host ssh://user@linux-builder [options]
  ${PROG_NAME} setup-colima [options]
  ${PROG_NAME} use-desktop
  ${PROG_NAME} status

COMMANDS:
  setup-remote     Point docker buildx at a remote Linux builder over SSH
                   (docker-container driver, builder name: ${REMOTE_BUILDER_NAME}).
                   Builds run on the remote Linux host.
                   Requires: docker CLI on this Mac, Docker on the remote host,
                   and SSH key auth from this user to the remote user.
  setup-colima     Local alternative: install colima + docker CLI + buildx via
                   Homebrew, start a lightweight Lima VM, and wire buildx to it
                   (builder name: ${COLIMA_BUILDER_NAME}, docker-container driver).
  use-desktop      Revert the default builder to Docker Desktop (desktop-linux).
  status           Show the active docker context and buildx builders.

OPTIONS (setup-remote):
  --host URL          SSH URL of the Linux builder, e.g. ssh://ci@builder.local.
                      May also be supplied via the BUILDER_SSH_HOST env var.
  --platform CSV      Comma-separated target platforms for the builder,
                      e.g. linux/amd64,linux/arm64. Creation-only; does not install emulation.

OPTIONS (setup-colima):
  --cpu N             vCPUs for the colima VM (default: ${COLIMA_CPU})
  --mem GB            Memory in GiB for the colima VM (default: ${COLIMA_MEM})
  --disk GB           Disk in GiB for the colima VM (default: ${COLIMA_DISK})

OTHER:
  -h, --help          Show this help and exit

EXAMPLES:
  ${PROG_NAME} setup-remote --host ssh://ci@linux-builder.internal
  BUILDER_SSH_HOST=ssh://ci@10.0.0.5 ${PROG_NAME} setup-remote \\
      --platform linux/amd64,linux/arm64
  ${PROG_NAME} setup-colima --cpu 6 --mem 12
  ${PROG_NAME} use-desktop
  ${PROG_NAME} status

LAYER CACHING:
  The named builders above pair with buildx cache backends
  (cache-from / cache-to type=registry) so CI builds reuse layers
  across runner hosts. See docs/docker-builds.md for the exact
  docker/build-push-action configuration and the benchmark methodology.

SECURITY NOTE:
  Run as the same non-root user that runs the runner daemons. Use SSH keys
  or a service-accessible SSH agent, never passwords on the command line.
  Registry credentials should come from CI secrets. The script does not
  invoke sudo; Homebrew installs tooling into its configured prefix.
EOF
}

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
parse_args() {
  if [[ $# -lt 1 ]]; then
    err "Missing command (setup-remote | setup-colima | use-desktop | status)"
    usage
    exit 2
  fi
  COMMAND="$1"; shift
  case "${COMMAND}" in
    setup-remote|setup-colima|use-desktop|status) ;;
    -h|--help) usage; exit 0 ;;
    *)
      err "Unknown command: ${COMMAND}"
      usage
      exit 2 ;;
  esac

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host)
        [[ $# -ge 2 ]] || { err "--host requires a value"; usage; exit 2; }
        SSH_HOST="$2"; shift 2 ;;
      --host=*)    SSH_HOST="${1#*=}"; shift ;;
      --platform)
        [[ $# -ge 2 ]] || { err "--platform requires a value"; usage; exit 2; }
        PLATFORM="$2"; shift 2 ;;
      --platform=*) PLATFORM="${1#*=}"; shift ;;
      --cpu)
        [[ $# -ge 2 ]] || { err "--cpu requires a value"; usage; exit 2; }
        COLIMA_CPU="$2"; shift 2 ;;
      --cpu=*)     COLIMA_CPU="${1#*=}"; shift ;;
      --mem)
        [[ $# -ge 2 ]] || { err "--mem requires a value"; usage; exit 2; }
        COLIMA_MEM="$2"; shift 2 ;;
      --mem=*)     COLIMA_MEM="${1#*=}"; shift ;;
      --disk)
        [[ $# -ge 2 ]] || { err "--disk requires a value"; usage; exit 2; }
        COLIMA_DISK="$2"; shift 2 ;;
      --disk=*)    COLIMA_DISK="${1#*=}"; shift ;;
      -h|--help)   usage; exit 0 ;;
      *)
        err "Unknown argument: $1"
        usage
        exit 2 ;;
    esac
  done

  # SSH host may come from the environment if not given on the CLI.
  if [[ -z "${SSH_HOST}" && -n "${BUILDER_SSH_HOST:-}" ]]; then
    SSH_HOST="${BUILDER_SSH_HOST}"
  fi

  case "${COMMAND}" in
    setup-remote)
      if [[ -z "${SSH_HOST}" ]]; then
        err "setup-remote requires --host (or BUILDER_SSH_HOST env)"
        usage
        exit 2
      fi
      if [[ "${SSH_HOST}" != ssh://* ]]; then
        err "--host must be an ssh:// URL (got: '${SSH_HOST}')"
        exit 2
      fi
      ;;
    setup-colima)
      local v
      for v in "${COLIMA_CPU}" "${COLIMA_MEM}" "${COLIMA_DISK}"; do
        if ! [[ "${v}" =~ ^[0-9]+$ ]] || [[ "${v}" -lt 1 ]]; then
          err "--cpu/--mem/--disk must be positive integers (got: '${v}')"
          exit 2
        fi
      done
      ;;
  esac
}

# ----------------------------------------------------------------------------
# Environment detection
# ----------------------------------------------------------------------------
detect_platform() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    err "This tool only supports macOS."
    exit 1
  fi
}

require_cmds() {
  local missing=() c
  for c in uname whoami sed awk head mkdir ln cut; do
    command -v "${c}" >/dev/null 2>&1 || missing+=("${c}")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Required command(s) not found: ${missing[*]}"
    exit 1
  fi
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    if command -v brew >/dev/null 2>&1; then
      log "docker CLI not found; installing via Homebrew (CLI only, not Docker Desktop)"
      brew install docker
    fi
  fi
  if ! command -v docker >/dev/null 2>&1; then
    err "docker CLI not found. Install it with: brew install docker"
    exit 1
  fi
  step "docker CLI: $(docker --version)"
}

# Ensure the buildx CLI plugin is available; install via Homebrew if missing.
ensure_buildx() {
  if docker buildx version >/dev/null 2>&1; then
    step "buildx: $(docker buildx version 2>/dev/null | head -n1)"
    return 0
  fi
  if command -v brew >/dev/null 2>&1; then
    log "docker buildx plugin not found; installing via Homebrew"
    brew install docker-buildx
    # Existing cliPluginsExtraDirs or a Homebrew symlink may now resolve.
    if docker buildx version >/dev/null 2>&1; then
      step "buildx is available after Homebrew installation"
      return 0
    fi
    local plugin_source plugin_dir plugin_target
    plugin_source="$(brew --prefix docker-buildx)/bin/docker-buildx"
    plugin_dir="${DOCKER_CONFIG:-${HOME}/.docker}/cli-plugins"
    plugin_target="${plugin_dir}/docker-buildx"
    if [[ ! -x "${plugin_source}" ]]; then
      err "Homebrew buildx executable not found: ${plugin_source}"
      exit 1
    fi
    if [[ -e "${plugin_target}" || -L "${plugin_target}" ]]; then
      err "Existing buildx plugin is not working: ${plugin_target}"
      err "Repair that plugin before retrying; it has been left unchanged."
      exit 1
    fi
    mkdir -p "${plugin_dir}"
    ln -s "${plugin_source}" "${plugin_target}"
  fi
  if ! docker buildx version >/dev/null 2>&1; then
    err "docker buildx is not available. Install it with: brew install docker-buildx"
    err "Link the Homebrew binary into ${DOCKER_CONFIG:-${HOME}/.docker}/cli-plugins/."
    exit 1
  fi
  step "buildx: $(docker buildx version 2>/dev/null | head -n1)"
}

# Select for buildx. Plain `docker build` still needs --builder or BUILDX_BUILDER.
# CI workflows should pass the builder explicitly to avoid shared-user races.
use_builder_default() {
  local name="$1"
  if ! docker buildx use --default "${name}" 2>/dev/null; then
    docker buildx use "${name}"
  fi
}

# Reuse only matching builders. Never remove a builder or its warm cache merely
# because setup was rerun with a different endpoint or an obsolete driver.
ensure_container_builder() {
  local name="$1" endpoint="$2" details existing_driver existing_endpoint
  if details="$(docker buildx inspect "${name}" 2>/dev/null)"; then
    existing_driver="$(printf '%s\n' "${details}" | awk '$1 == "Driver:" {print $2; exit}')"
    existing_endpoint="$(printf '%s\n' "${details}" | sed -n 's/^[[:space:]]*Endpoint:[[:space:]]*//p')"
    if [[ "${existing_driver}" != docker-container || "${existing_endpoint}" != "${endpoint}" ]]; then
      err "Builder '${name}' exists with driver '${existing_driver}' and endpoint '${existing_endpoint}'."
      err "Expected docker-container at '${endpoint}'. Existing builder and cache are unchanged."
      err "Inspect it with: docker buildx inspect ${name}; see docs/docker-builds.md for migration."
      exit 1
    fi
    step "Reusing '${name}' and its persistent BuildKit cache"
    if [[ -n "${PLATFORM}" ]]; then
      warn "--platform is creation-only; the existing builder's platform configuration is unchanged."
      warn "Select target platforms on the build with: docker buildx build --platform ${PLATFORM} ..."
    fi
  else
    local -a create_args=(create --name "${name}" --driver docker-container)
    if [[ -n "${PLATFORM}" ]]; then
      create_args+=(--platform "${PLATFORM}")
    fi
    create_args+=("${endpoint}")
    docker buildx "${create_args[@]}"
  fi
  docker buildx inspect --bootstrap "${name}"
  use_builder_default "${name}"
}

# ----------------------------------------------------------------------------
# setup-remote — Docker-over-SSH with a persistent BuildKit container
# ----------------------------------------------------------------------------
setup_remote() {
  require_docker
  ensure_buildx

  log "Setting up remote buildx builder '${REMOTE_BUILDER_NAME}' -> ${SSH_HOST}"
  # Let Docker parse SSH URLs, including ports and IPv6, and verify the daemon
  # (docker version can report the client even when its daemon is unavailable).
  local remote_os
  if ! remote_os="$(docker --host "${SSH_HOST}" info --format '{{.OSType}}')"; then
    err "Cannot reach Docker at ${SSH_HOST}. Check noninteractive SSH authentication and Docker access."
    exit 1
  fi
  if [[ "${remote_os}" != linux ]]; then
    err "The remote Docker daemon must run Linux (reported '${remote_os}')."
    exit 1
  fi
  ensure_container_builder "${REMOTE_BUILDER_NAME}" "${SSH_HOST}"
  log "Done. Selected '${REMOTE_BUILDER_NAME}' for docker buildx build."
  log "Use --builder ${REMOTE_BUILDER_NAME} explicitly in CI; see docs/docker-builds.md."
}

# ----------------------------------------------------------------------------
# setup-colima — local lightweight Linux VM via colima
# ----------------------------------------------------------------------------
setup_colima() {
  if ! command -v brew >/dev/null 2>&1; then
    err "Homebrew is required for setup-colima (brew install colima docker docker-buildx)."
    exit 1
  fi

  log "Installing colima, docker CLI, and buildx via Homebrew (as $(whoami))"
  brew install colima docker docker-buildx
  require_docker
  ensure_buildx

  # Never restart a running VM: jobs may be using it. Sizing applies when
  # starting a stopped VM; changing an active VM requires a maintenance window.
  if colima status default >/dev/null 2>&1; then
    step "colima default VM already running; keeping its current resource allocation"
    warn "To apply --cpu/--mem/--disk changes, stop Colima between jobs and rerun setup."
  else
    local -a start_args=(start default --runtime docker --cpus "${COLIMA_CPU}" --memory "${COLIMA_MEM}" --disk "${COLIMA_DISK}")
    # VM/mount types are immutable. Optimize newly created Apple Silicon VMs
    # only; preserve an existing profile's engine and disk/cache on restarts.
    if [[ ! -f "${COLIMA_HOME:-${HOME}/.colima}/default/colima.yaml" ]] \
      && [[ "$(uname -m)" == arm64 ]] && [[ "$(uname -r | cut -d. -f1)" -ge 22 ]]; then
      start_args+=(--vm-type vz --mount-type virtiofs)
    fi
    log "Starting colima default VM"
    colima "${start_args[@]}"
  fi

  # An explicit endpoint is essential when Desktop or DOCKER_CONTEXT is active.
  docker --context colima info >/dev/null
  ensure_container_builder "${COLIMA_BUILDER_NAME}" colima
  log "Done. Selected '${COLIMA_BUILDER_NAME}' for docker buildx build."
  log "Use --builder ${COLIMA_BUILDER_NAME} explicitly in CI; see docs/docker-builds.md."
}

# ----------------------------------------------------------------------------
# use-desktop — revert to Docker Desktop's builder
# ----------------------------------------------------------------------------
use_desktop() {
  require_docker
  ensure_buildx

  log "Reverting default builder to Docker Desktop"
  if ! docker context inspect desktop-linux >/dev/null 2>&1; then
    err "Docker Desktop context 'desktop-linux' not found. Start Docker Desktop and retry."
    exit 1
  fi
  docker --context desktop-linux info >/dev/null
  docker context use desktop-linux
  use_builder_default desktop-linux
  log "Selected Docker Desktop's 'desktop-linux' context and builder."
}

# ----------------------------------------------------------------------------
# status — show active context and builders (parse without jq)
# ----------------------------------------------------------------------------
status() {
  require_docker

  log "docker context"
  local ctx
  ctx="$(docker context show 2>/dev/null || true)"
  step "current context: ${ctx:-unknown}"

  log "buildx builders (* = selected builder)"
  docker buildx ls 2>/dev/null | sed 's/^/  /' >&2 || warn "docker buildx ls failed"

  local default_builder=""
  default_builder="$(docker buildx inspect 2>/dev/null | awk '$1 == "Name:" {print $2; exit}' || true)"
  printf '\n'
  if [[ -n "${default_builder}" ]]; then
    step "selected builder: ${default_builder}"
    case "${default_builder}" in
      "${REMOTE_BUILDER_NAME}")  step "mode: remote Linux builder" ;;
      "${COLIMA_BUILDER_NAME}")  step "mode: local colima VM" ;;
      desktop-linux)             step "mode: Docker Desktop VM" ;;
      *)                         step "mode: other" ;;
    esac
  else
    warn "Could not determine the selected builder."
  fi

  if command -v colima >/dev/null 2>&1; then
    printf '\n'
    log "colima"
    colima status default 2>&1 | sed 's/^/  /' >&2 || step "colima VM not running"
  fi
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
  parse_args "$@"
  detect_platform
  require_cmds

  case "${COMMAND}" in
    setup-remote) setup_remote ;;
    setup-colima) setup_colima ;;
    use-desktop)  use_desktop ;;
    status)       status ;;
  esac
}

main "$@"

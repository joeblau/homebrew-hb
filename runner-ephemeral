#!/usr/bin/env bash
#
# runner-ephemeral — supervise ONE ephemeral GitHub Actions self-hosted runner
# on macOS: register -> run exactly one job -> wipe -> re-register, forever.
#
# Usage:
#   runner-ephemeral --dir /opt/github-runners/runner-1 (--org ORG | --repo OWNER/REPO | --url URL)
#
# This is the LaunchDaemon entrypoint used by `runner-setup --ephemeral`
# (the daemon plist's ProgramArguments point here instead of bin/runsvc.sh).
# Each loop iteration:
#   1. reads the previous registration's name/URL from .runner (before wiping),
#   2. fetches a FRESH registration token from the GitHub API using GITHUB_PAT,
#   3. wipes _work and all registration residue (.runner/.credentials/...),
#      keeping the persistent tool cache (see TOOL CACHE below),
#   4. re-registers with `config.sh --unattended --ephemeral` (same name/labels/
#      url), so GitHub auto-removes the runner after it finishes ONE job,
#   5. runs bin/runsvc.sh in the foreground; when it exits (job done), loops.
#
# TOOL CACHE: the runner's HostContext resolves its tool cache (RUNNER_TOOL_CACHE
# in job steps, used by the setup-* actions) from the first of the
# RUNNER_TOOL_CACHE / RUNNER_TOOLSDIRECTORY / AGENT_TOOLSDIRECTORY environment
# variables, otherwise _work/_tool (verified against actions/runner
# src/Runner.Common/HostContext.cs, WellKnownDirectory.Tools). Ephemeral resets
# delete _work, so this supervisor exports AGENT_TOOLSDIRECTORY pointing at a
# persistent, per-runner location OUTSIDE _work (default: RUNNER_DIR/_toolcache),
# and migrates a legacy _work/_tool cache to it once, between jobs. An operator
# preset of either env var wins; a shared location is at the operator's risk
# (setup-* actions are not safe against concurrent first-time installs).
#
# Re-registration failures back off exponentially; after --max-failures
# consecutive failures the script exits non-zero so launchd's
# KeepAlive/ThrottleInterval restarts it. It runs as the invoking (non-root)
# user like every other runner process — no sudo, and we never set
# RUNNER_ALLOW_RUNASROOT.
#
# Opt-in hardening (off by default; see docs/ephemeral-runners.md):
#   --sandbox             run each job's runner service under a generated
#                         sandbox-exec profile that restricts filesystem
#                         writes to the runner tree, temp dirs, and any
#                         --sandbox-cache-path directories
#   --sandbox-deny-network  sandbox variant that also denies network*
#   --sandbox-cache-path DIR  extra writable directory (repeatable)
#   --snapshot-rollback   when the runner root sits on an APFS volume, take a
#                         local snapshot after each registration and restore
#                         _work from it between jobs, falling back to the
#                         rm -rf cleanup whenever snapshots are unavailable
#                         or fail (cleanup is never skipped)
# Full VM/image isolation and host snapshot rollback stay out of scope.

set -euo pipefail

# ----------------------------------------------------------------------------
# Constants / globals
# ----------------------------------------------------------------------------
PROG_NAME="$(basename "$0")"
GITHUB_API="https://api.github.com"

DIR=""
ORG=""
REPO=""
URL=""
API_URL=""
LABELS="macos,macmini,self-hosted"
NAME_ARG=""             # --name fallback; .runner's agentName wins each cycle
PAT_FILE=""             # fallback PAT location; defaults to ${DIR}/.github_pat
MAX_FAILURES=5
SANDBOX=0             # --sandbox: wrap the runner service in sandbox-exec
SANDBOX_DENY_NETWORK=0 # --sandbox-deny-network: add (deny network*)
SANDBOX_CACHE_PATHS=() # --sandbox-cache-path (repeatable, extra writable dirs)
SANDBOX_PROFILE_FILE=""
SNAPSHOT_ROLLBACK=0   # --snapshot-rollback: APFS snapshot restore of _work
SNAPSHOT_NAME=""      # com.apple.TimeMachine.YYYY-MM-DD-HHMMSS
SNAPSHOT_DATE=""      # YYYY-MM-DD-HHMMSS (tmutil deletelocalsnapshot arg)
TOOL_CACHE_DIR=""     # resolved persistent tool cache (AGENT_TOOLSDIRECTORY)

GITHUB_PAT_VALUE=""
RUNNER_URL=""
API_ENDPOINT=""
CHILD_PID=""

# ----------------------------------------------------------------------------
# Output helpers — progress goes to stderr (the daemon plist redirects it to
# _diag/runner-stderr.log); tokens are NEVER interpolated.
# ----------------------------------------------------------------------------
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
step() { printf '\033[1;32m  ->\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; }

usage() {
  cat >&2 <<EOF
${PROG_NAME} — supervise one ephemeral GitHub Actions self-hosted runner

USAGE:
  ${PROG_NAME} --dir RUNNER_DIR (--org ORG | --repo OWNER/REPO | --url URL) [options]

REQUIRED:
  --dir RUNNER_DIR    Existing runner directory provisioned by runner-setup
                      (e.g. /opt/github-runners/runner-1). Must contain the
                      extracted runner (config.sh, bin/runsvc.sh).

SCOPE (choose exactly ONE — where the runner registers):
  --org ORG_NAME      Organization runner (needs a PAT with admin:org scope).
  --repo OWNER/REPO   Repository runner (needs a PAT with repo scope).
  --url URL           Full runner URL; 1 path segment is treated as an org,
                      2 as a repo. Works for GitHub Enterprise (API base is
                      derived as https://HOST/api/v3 unless --api-url is set).

OPTIONS:
  --labels CSV        Runner labels applied on every re-registration
                      (default: ${LABELS})
  --name NAME         Fallback GitHub runner name. Normally unnecessary: the
                      previous registration's name is read from .runner and
                      reused so the runner keeps its identity across jobs.
  --pat-file FILE     File containing the GitHub PAT (default:
                      RUNNER_DIR/.github_pat). Only used when the GITHUB_PAT
                      environment variable is unset.
  --api-url URL       GitHub API base (default: ${GITHUB_API})
  --max-failures N    Consecutive re-registration failures before giving up
                      and exiting non-zero for launchd to restart (default: ${MAX_FAILURES})
  --sandbox           Run each job's runner service under a generated
                      sandbox-exec profile: filesystem writes are denied
                      except inside RUNNER_DIR, temp dirs, /dev essentials,
                      and any --sandbox-cache-path directories. sandbox-exec
                      is deprecated but still shipped with macOS; the profile
                      is a best-effort seatbelt, not a security boundary.
  --sandbox-deny-network
                      Sandbox variant that also denies ALL network operations
                      for the sandboxed tree (implies --sandbox). NOTE: this
                      also blocks the runner listener's own GitHub connection;
                      runner-netisolate's pf rules are the supported network
                      control. See docs/ephemeral-runners.md.
  --sandbox-cache-path DIR
                      Extra directory the sandboxed job may write to
                      (repeatable; e.g. a shared package cache).
  --snapshot-rollback When RUNNER_DIR sits on an APFS volume, take a local
                      snapshot (tmutil localsnapshot) after each registration
                      and restore _work from it between jobs. Falls back to
                      the rm -rf cleanup whenever snapshots are unavailable
                      or fail — cleanup is never skipped. Snapshot mount and
                      tmutil may require NOPASSWD sudo for tmutil/mount_apfs/
                      umount; sudo is never used for anything else here.
  -h, --help          Show this help and exit

PERSISTENT TOOL CACHE:
  Ephemeral resets delete _work, which would also delete the default tool
  cache (_work/_tool) used by the setup-* actions. This supervisor therefore
  exports AGENT_TOOLSDIRECTORY so the runner (and the RUNNER_TOOL_CACHE it
  gives each job step) points at a persistent cache OUTSIDE _work:

    1. RUNNER_TOOL_CACHE, if already set (operator override)
    2. AGENT_TOOLSDIRECTORY, if already set (operator override)
    3. RUNNER_DIR/_toolcache  (per-runner default — never shared, so
       concurrent jobs on different runners cannot corrupt each other's
       tool installs)

  The path must be absolute and must NOT live under RUNNER_DIR/_work. A
  legacy _work/_tool cache is migrated (moved, never merged) to the
  configured location between jobs while the service is stopped. With
  --sandbox, a tool cache outside RUNNER_DIR is automatically writable.
  Eviction: runner-prune --all --offline --purge-caches. See
  docs/ephemeral-runners.md.

EXAMPLES:
  GITHUB_PAT=ghp_... ${PROG_NAME} --dir /opt/github-runners/runner-1 --org acme
  ${PROG_NAME} --dir /opt/github-runners/runner-2 --repo acme/monorepo \
    --labels macos,macmini,self-hosted,ephemeral
  ${PROG_NAME} --dir /opt/github-runners/runner-3 --org acme \
    --sandbox --sandbox-cache-path /opt/github-runners/shared-cache \
    --snapshot-rollback

SECURITY NOTE:
  The PAT needs admin:org (org runners) or repo (repo runners) scope. Prefer
  the GITHUB_PAT environment variable or a mode-600 --pat-file owned by the
  runner user; the PAT is used only in an Authorization header and is never
  logged. The short-lived REGISTRATION token is passed to config.sh as an
  argument (config.sh has no env alternative), so it is briefly visible in
  'ps' to other local users — registration tokens expire in ~1 hour and are
  single-purpose.

  This script never uses sudo and refuses to run as root; runner processes
  run as the invoking (non-root) user, because the GitHub Actions runner
  refuses to run as root.
EOF
}

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir)
        [[ $# -ge 2 ]] || { err "--dir requires a value"; usage; exit 2; }
        DIR="$2"; shift 2 ;;
      --dir=*)     DIR="${1#*=}"; shift ;;
      --org)
        [[ $# -ge 2 ]] || { err "--org requires a value"; usage; exit 2; }
        ORG="$2"; shift 2 ;;
      --org=*)     ORG="${1#*=}"; shift ;;
      --repo)
        [[ $# -ge 2 ]] || { err "--repo requires a value"; usage; exit 2; }
        REPO="$2"; shift 2 ;;
      --repo=*)    REPO="${1#*=}"; shift ;;
      --url)
        [[ $# -ge 2 ]] || { err "--url requires a value"; usage; exit 2; }
        URL="$2"; shift 2 ;;
      --url=*)     URL="${1#*=}"; shift ;;
      --labels)
        [[ $# -ge 2 ]] || { err "--labels requires a value"; usage; exit 2; }
        LABELS="$2"; shift 2 ;;
      --labels=*)  LABELS="${1#*=}"; shift ;;
      --name)
        [[ $# -ge 2 ]] || { err "--name requires a value"; usage; exit 2; }
        NAME_ARG="$2"; shift 2 ;;
      --name=*)    NAME_ARG="${1#*=}"; shift ;;
      --pat-file)
        [[ $# -ge 2 ]] || { err "--pat-file requires a value"; usage; exit 2; }
        PAT_FILE="$2"; shift 2 ;;
      --pat-file=*) PAT_FILE="${1#*=}"; shift ;;
      --api-url)
        [[ $# -ge 2 ]] || { err "--api-url requires a value"; usage; exit 2; }
        API_URL="$2"; shift 2 ;;
      --api-url=*) API_URL="${1#*=}"; shift ;;
      --max-failures)
        [[ $# -ge 2 ]] || { err "--max-failures requires a value"; usage; exit 2; }
        MAX_FAILURES="$2"; shift 2 ;;
      --max-failures=*) MAX_FAILURES="${1#*=}"; shift ;;
      --sandbox)     SANDBOX=1; shift ;;
      --sandbox-deny-network)
        SANDBOX=1; SANDBOX_DENY_NETWORK=1; shift ;;
      --sandbox-cache-path)
        [[ $# -ge 2 ]] || { err "--sandbox-cache-path requires a value"; usage; exit 2; }
        SANDBOX_CACHE_PATHS+=("$2"); shift 2 ;;
      --sandbox-cache-path=*) SANDBOX_CACHE_PATHS+=("${1#*=}"); shift ;;
      --snapshot-rollback) SNAPSHOT_ROLLBACK=1; shift ;;
      -h|--help)   usage; exit 0 ;;
      *)
        err "Unknown argument: $1"
        usage
        exit 2 ;;
    esac
  done

  if [[ -z "${DIR}" ]]; then
    err "Missing required argument: --dir"
    usage
    exit 2
  fi
  # Normalize away any trailing slashes.
  while [[ "${DIR}" == */ ]]; do DIR="${DIR%/}"; done

  local scope_count=0
  [[ -z "${ORG}" ]]  || scope_count=$((scope_count + 1))
  [[ -z "${REPO}" ]] || scope_count=$((scope_count + 1))
  [[ -z "${URL}" ]]  || scope_count=$((scope_count + 1))
  if [[ "${scope_count}" -ne 1 ]]; then
    err "Choose exactly one of --org, --repo, or --url (got ${scope_count})."
    usage
    exit 2
  fi

  if ! [[ "${MAX_FAILURES}" =~ ^[0-9]+$ ]] || [[ "${MAX_FAILURES}" -lt 1 ]]; then
    err "--max-failures must be a positive integer (got: '${MAX_FAILURES}')"
    exit 2
  fi

  [[ -n "${PAT_FILE}" ]] || PAT_FILE="${DIR}/.github_pat"
  [[ -n "${SANDBOX_PROFILE_FILE}" ]] || SANDBOX_PROFILE_FILE="${DIR}/.sandbox-exec.sb"
  [[ -n "${API_URL}" ]] || API_URL="${GITHUB_API}"
  while [[ "${API_URL}" == */ ]]; do API_URL="${API_URL%/}"; done
}

# ----------------------------------------------------------------------------
# Environment detection (mirrors runner-setup; this script NEVER uses sudo)
# ----------------------------------------------------------------------------
detect_platform() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    err "This tool only supports macOS."
    exit 1
  fi
}

detect_user() {
  if [[ "$(whoami)" == "root" ]]; then
    err "Refusing to run as root. The GitHub Actions runner will not run as"
    err "root. The LaunchDaemon must set UserName to the runner user."
    exit 1
  fi
}

require_cmds() {
  local missing=()
  local c
  for c in curl jq sed grep uname id whoami sleep rm mkdir basename; do
    command -v "${c}" >/dev/null 2>&1 || missing+=("${c}")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Required command(s) not found: ${missing[*]}"
    exit 1
  fi
}

check_runner_dir() {
  if [[ ! -d "${DIR}" ]]; then
    err "Runner directory not found: ${DIR} (provision it with runner-setup first)."
    exit 1
  fi
  if [[ ! -x "${DIR}/config.sh" ]]; then
    err "config.sh not found/executable in ${DIR} (corrupt runner layout)."
    exit 1
  fi
  if [[ ! -f "${DIR}/bin/runsvc.sh" ]]; then
    err "bin/runsvc.sh not found in ${DIR} (corrupt runner layout)."
    exit 1
  fi
  chmod u+x "${DIR}/bin/runsvc.sh" 2>/dev/null || true
}

# ----------------------------------------------------------------------------
# PAT resolution: GITHUB_PAT env wins, else the (mode-600) PAT file.
# ----------------------------------------------------------------------------
resolve_pat() {
  if [[ -n "${GITHUB_PAT:-}" ]]; then
    GITHUB_PAT_VALUE="${GITHUB_PAT}"
  elif [[ -f "${PAT_FILE}" ]]; then
    GITHUB_PAT_VALUE="$(head -n1 "${PAT_FILE}" | tr -d '[:space:]')"
  fi
  if [[ -z "${GITHUB_PAT_VALUE}" ]]; then
    err "No GitHub PAT available. Set the GITHUB_PAT environment variable or"
    err "write a PAT (admin:org for org runners, repo for repo runners) to:"
    err "  ${PAT_FILE}   (chmod 600, owned by the runner user)"
    exit 1
  fi
  step "GitHub PAT loaded ($([[ -n "${GITHUB_PAT:-}" ]] && echo env || echo "${PAT_FILE}"))"
}

# ----------------------------------------------------------------------------
# Resolve the registration URL and the registration-token API endpoint from
# the chosen scope.
# ----------------------------------------------------------------------------
resolve_scope() {
  if [[ -n "${ORG}" ]]; then
    RUNNER_URL="https://github.com/${ORG}"
    API_ENDPOINT="${API_URL}/orgs/${ORG}/actions/runners/registration-token"
  elif [[ -n "${REPO}" ]]; then
    if ! [[ "${REPO}" =~ ^[^/]+/[^/]+$ ]]; then
      err "--repo must be in OWNER/REPO form (got: '${REPO}')"
      exit 2
    fi
    RUNNER_URL="https://github.com/${REPO}"
    API_ENDPOINT="${API_URL}/repos/${REPO}/actions/runners/registration-token"
  else
    RUNNER_URL="${URL}"
    while [[ "${RUNNER_URL}" == */ ]]; do RUNNER_URL="${RUNNER_URL%/}"; done
    local host path
    host="${RUNNER_URL#*://}"; host="${host%%/*}"        # strip scheme:// and /path
    path="${RUNNER_URL#*://}"; path="${path#*/}"          # strip scheme://host/
    # GitHub Enterprise: API lives at https://HOST/api/v3 unless --api-url
    # was given explicitly.
    if [[ -z "${API_URL:-}" || "${API_URL}" == "${GITHUB_API}" ]]; then
      if [[ "${host}" != "github.com" && "${host}" != "www.github.com" ]]; then
        API_URL="https://${host}/api/v3"
      fi
    fi
    case "${path}" in
      */*/*|"")
        err "Cannot derive org/repo scope from --url '${URL}'."
        err "Use --org or --repo (or --api-url) for this target."
        exit 2 ;;
      */*)
        API_ENDPOINT="${API_URL}/repos/${path}/actions/runners/registration-token" ;;
      *)
        API_ENDPOINT="${API_URL}/orgs/${path}/actions/runners/registration-token" ;;
    esac
  fi
  step "Runner URL: ${RUNNER_URL}"
  step "Token endpoint: ${API_ENDPOINT}"
}

# ----------------------------------------------------------------------------
# Signal handling: forward TERM/INT to the running runsvc.sh child and exit
# cleanly so `launchctl bootout` stops the supervisor without orphans.
# ----------------------------------------------------------------------------
shutdown() {
  log "Shutdown requested; stopping runner."
  if [[ -n "${CHILD_PID}" ]] && kill -0 "${CHILD_PID}" 2>/dev/null; then
    kill -TERM "${CHILD_PID}" 2>/dev/null || true
    wait "${CHILD_PID}" 2>/dev/null || true
  fi
  if [[ "${SNAPSHOT_ROLLBACK}" -eq 1 ]]; then
    delete_workspace_snapshot || true
  fi
  exit 0
}
trap shutdown TERM INT

# ----------------------------------------------------------------------------
# OPT-IN: sandboxed job execution (--sandbox). generate_sandbox_profile is a
# pure function (arguments in, SBPL profile on stdout) so it is testable
# without sandbox-exec. The profile is permissive by default and denies only
# filesystem writes outside the runner tree, temp dirs, /dev essentials, and
# operator-designated cache paths. sandbox-exec is deprecated-but-present on
# macOS; this is a best-effort seatbelt, not a security boundary. For network
# policy, runner-netisolate's pf anchor remains the stronger control.
# ----------------------------------------------------------------------------
generate_sandbox_profile() {
  local dir="$1" deny_network="$2"
  shift 2
  cat <<EOF
(version 1)
;; Generated by runner-ephemeral --sandbox. Default-allow except file writes,
;; which are confined to the runner tree, temp dirs, /dev essentials, and any
;; operator-designated cache paths.
(allow default)
(deny file-write*)
(allow file-write*
  (subpath "${dir}")
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath "/private/var/folders"))
(allow file-write*
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/ptmx")
  (literal "/dev/tty")
  (regex #"^/dev/ttys[0-9]+$"))
EOF
  local cache_path
  for cache_path in "$@"; do
    printf '(allow file-write* (subpath "%s"))\n' "${cache_path}"
  done
  if [[ "${deny_network}" == "1" ]]; then
    cat <<'EOF'
;; Network-deny variant: blocks ALL network operations for the sandboxed
;; tree — including the runner listener's own GitHub connection. Prefer
;; runner-netisolate (pf) for network policy.
(deny network*)
EOF
  fi
}

# Writes the generated profile to SANDBOX_PROFILE_FILE. Returns non-zero when
# sandboxing cannot be honored, so the caller backs off instead of running an
# unsandboxed job the operator asked to be confined.
prepare_sandbox_profile() {
  if ! command -v sandbox-exec >/dev/null 2>&1; then
    warn "--sandbox requested but sandbox-exec is not available on this system."
    return 1
  fi
  [[ -n "${SANDBOX_PROFILE_FILE}" ]] || SANDBOX_PROFILE_FILE="${DIR}/.sandbox-exec.sb"
  local -a writable=()
  if [[ ${#SANDBOX_CACHE_PATHS[@]} -gt 0 ]]; then
    local cache_path
    for cache_path in "${SANDBOX_CACHE_PATHS[@]}"; do
      [[ -d "${cache_path}" ]] || warn "sandbox cache path does not exist: ${cache_path}"
      writable+=("${cache_path}")
    done
  fi
  # The persistent tool cache must stay writable for sandboxed jobs even when
  # the operator pointed it outside the runner tree.
  if [[ -n "${TOOL_CACHE_DIR}" ]]; then
    case "${TOOL_CACHE_DIR}/" in
      "${DIR}/"*) ;;  # already writable via the runner-tree subpath rule
      *) writable+=("${TOOL_CACHE_DIR}") ;;
    esac
  fi
  if [[ ${#writable[@]} -gt 0 ]]; then
    generate_sandbox_profile "${DIR}" "${SANDBOX_DENY_NETWORK}" "${writable[@]}" \
      > "${SANDBOX_PROFILE_FILE}" || return 1
  else
    generate_sandbox_profile "${DIR}" "${SANDBOX_DENY_NETWORK}" \
      > "${SANDBOX_PROFILE_FILE}" || return 1
  fi
  step "sandbox-exec profile written to ${SANDBOX_PROFILE_FILE}"
}

# ----------------------------------------------------------------------------
# OPT-IN: APFS snapshot rollback of the workspace (--snapshot-rollback). A
# local snapshot is taken right after each successful registration (the clean
# baseline); the next cycle restores _work from a read-only mount of that
# snapshot. Every failure falls back to the rm -rf cleanup — a snapshot
# failure NEVER skips cleanup. tmutil/mount_apfs/umount may need NOPASSWD
# sudo; `sudo -n` is used so a missing sudoers entry fails fast (and falls
# back) instead of prompting. This is host-level workspace rollback only —
# full host/VM image snapshots remain out of scope.
# ----------------------------------------------------------------------------
workspace_mount_point() {
  df -P "${DIR}" 2>/dev/null | awk 'NR == 2 { $1=$2=$3=$4=$5=""; sub(/^ +/, ""); print }'
}

workspace_device() {
  df -P "${DIR}" 2>/dev/null | awk 'NR == 2 { print $1 }'
}

workspace_is_apfs() {
  diskutil info "${DIR}" 2>/dev/null \
    | grep -qiE 'File System Personality: *APFS|Type \(Bundle\): *apfs' \
    || return 1
}

delete_workspace_snapshot() {
  [[ -n "${SNAPSHOT_DATE}" ]] || return 0
  tmutil deletelocalsnapshot "${SNAPSHOT_DATE}" >/dev/null 2>&1 \
    || sudo -n tmutil deletelocalsnapshot "${SNAPSHOT_DATE}" >/dev/null 2>&1 \
    || warn "Could not delete local snapshot ${SNAPSHOT_NAME} (Time Machine will purge it)."
  SNAPSHOT_DATE=""
  SNAPSHOT_NAME=""
  return 0
}

take_workspace_snapshot() {
  if ! command -v tmutil >/dev/null 2>&1; then
    warn "tmutil not found; snapshot rollback unavailable."
    return 1
  fi
  if ! workspace_is_apfs; then
    warn "${DIR} is not on an APFS volume; snapshot rollback unavailable."
    return 1
  fi
  local mount output date
  mount="$(workspace_mount_point)"
  if [[ -z "${mount}" ]]; then
    warn "Could not determine the mount point of ${DIR}."
    return 1
  fi
  if ! output="$(tmutil localsnapshot "${mount}" 2>/dev/null)"; then
    if ! output="$(sudo -n tmutil localsnapshot "${mount}" 2>/dev/null)"; then
      warn "tmutil localsnapshot failed (needs root or a NOPASSWD sudoers entry)."
      return 1
    fi
  fi
  date="$(printf '%s\n' "${output}" | sed -n 's/.*[Dd]ate: *//p' | head -n1)"
  if ! [[ "${date}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}$ ]]; then
    warn "Could not parse a snapshot date from tmutil output."
    return 1
  fi
  # Keep at most one baseline snapshot at a time.
  delete_workspace_snapshot
  SNAPSHOT_DATE="${date}"
  SNAPSHOT_NAME="com.apple.TimeMachine.${date}"
  step "APFS workspace baseline snapshot: ${SNAPSHOT_NAME}"
  return 0
}

restore_workspace_snapshot() {
  [[ -n "${SNAPSHOT_NAME}" && -n "${SNAPSHOT_DATE}" ]] || return 1
  workspace_is_apfs || return 1
  local device mount_point
  device="$(workspace_device)"
  mount_point="${DIR}/.snapshot-mnt.$$"
  if [[ -z "${device}" ]] || ! mkdir -p "${mount_point}"; then
    return 1
  fi
  local rc=0
  if sudo -n /sbin/mount_apfs -r -s "${SNAPSHOT_NAME}" "${device}" "${mount_point}" 2>/dev/null; then
    if [[ -d "${mount_point}${DIR}/_work" ]]; then
      rsync -a --delete "${mount_point}${DIR}/_work/" "${DIR}/_work/" 2>/dev/null || rc=1
    else
      # _work did not exist at snapshot time; the clean baseline is empty.
      rm -rf "${DIR}/_work" 2>/dev/null || rc=1
    fi
    sudo -n umount "${mount_point}" 2>/dev/null || rc=1
  else
    rc=1
  fi
  rmdir "${mount_point}" 2>/dev/null || true
  return "${rc}"
}

# Reset _work for the next cycle: snapshot restore when enabled and possible,
# the rm -rf cleanup otherwise. Never returns success without having reset.
reset_workspace() {
  if [[ "${SNAPSHOT_ROLLBACK}" -eq 1 && -n "${SNAPSHOT_NAME}" ]]; then
    if restore_workspace_snapshot; then
      step "Workspace restored from APFS snapshot ${SNAPSHOT_NAME}."
      return 0
    fi
    warn "Snapshot restore failed; falling back to rm -rf workspace cleanup."
  fi
  rm -rf "${DIR}/_work"
}

# ----------------------------------------------------------------------------
# Fetch a FRESH registration token (never logged). Returns non-zero on any
# HTTP or parse failure so the caller can back off and retry.
# ----------------------------------------------------------------------------
fetch_registration_token() {
  local json token
  # Capture-then-check so set -e isn't masked inside command substitution.
  if ! json="$(printf 'header = "Authorization: Bearer %s"\n' "${GITHUB_PAT_VALUE}" \
      | curl --config - -fsSL --retry 3 --retry-delay 2 \
      --connect-timeout 15 --max-time 60 -X POST \
      -H 'Accept: application/vnd.github+json' \
      -H 'X-GitHub-Api-Version: 2022-11-28' \
      "${API_ENDPOINT}")"; then
    warn "Registration-token request failed (HTTP error from GitHub API)."
    return 1
  fi

  if ! token="$(printf '%s' "${json}" | jq -er '.token | select(type == "string" and length > 0)')"; then
    warn "Could not parse a registration token from the API response."
    return 1
  fi
  FETCHED_TOKEN="${token}"
  return 0
}

# ----------------------------------------------------------------------------
# Read the previous registration's name/URL/group from .runner BEFORE wiping, like
# runner-setup's existing_name logic: the runner keeps its GitHub identity
# (and its LaunchDaemon/label naming) stable across ephemeral re-registrations.
# ----------------------------------------------------------------------------
read_saved_identity() {
  local saved_group=""
  SAVED_NAME=""
  SAVED_URL=""
  if [[ -f "${DIR}/.runner" ]]; then
    SAVED_NAME="$(sed -n 's/.*"agentName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "${DIR}/.runner" 2>/dev/null | head -n1 || true)"
    SAVED_URL="$(sed -n 's/.*"gitHubUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "${DIR}/.runner" 2>/dev/null | head -n1 || true)"
    saved_group="$(jq -r '.poolName | select(type == "string")' "${DIR}/.runner" 2>/dev/null || true)"
  fi
  # Precedence: --name CLI arg > previous registration's agentName > dir name.
  # Resolve once, then retain the identity if GitHub removes .runner.
  # Pin the resolved identity for this supervisor's lifetime: GitHub can remove
  # .runner after a successful ephemeral job, so the next cycle cannot reread it.
  if [[ -z "${NAME_ARG}" ]]; then
    NAME_ARG="${SAVED_NAME:-$(basename "${DIR}")}"
  fi
  RUNNER_NAME="${NAME_ARG}"
  [[ -n "${SAVED_URL}" ]] && RUNNER_URL="${SAVED_URL}"
  # Ephemeral completion can remove .runner. Retain the last known group so
  # later registrations keep the group's workflow access restrictions.
  [[ -n "${saved_group}" ]] && RUNNER_GROUP="${saved_group}"
  return 0
}

# ----------------------------------------------------------------------------
# Persistent tool cache (AGENT_TOOLSDIRECTORY). The runner's
# HostContext.GetDirectory(WellKnownDirectory.Tools) uses the first of
# RUNNER_TOOL_CACHE / RUNNER_TOOLSDIRECTORY / AGENT_TOOLSDIRECTORY and falls
# back to _work/_tool (verified against actions/runner,
# src/Runner.Common/HostContext.cs; JobRunner.cs creates the directory and
# exposes it to steps as RUNNER_TOOL_CACHE). Ephemeral resets delete _work, so
# the cache must live outside it. The default is the PER-RUNNER
# ${DIR}/_toolcache: two runners never write the same cache, so no
# concurrent-install corruption is possible. An operator preset points at a
# shared location at the operator's risk.
# ----------------------------------------------------------------------------
resolve_tool_cache_dir() {
  local dir="${RUNNER_TOOL_CACHE:-${AGENT_TOOLSDIRECTORY:-${DIR}/_toolcache}}"
  while [[ "${dir}" == */ && "${dir}" != "/" ]]; do dir="${dir%/}"; done
  case "${dir}" in
    /*) ;;
    *)
      err "Tool cache directory must be an absolute path (got: '${dir}')."
      return 1 ;;
  esac
  case "${dir}/" in
    "${DIR}/_work/"*)
      err "Tool cache directory must live OUTSIDE ${DIR}/_work (got: '${dir}');"
      err "ephemeral resets delete _work, so a cache inside it cannot persist."
      return 1 ;;
  esac
  TOOL_CACHE_DIR="${dir}"
  export AGENT_TOOLSDIRECTORY="${TOOL_CACHE_DIR}"
  return 0
}

# Idle-only migration: wipe_state runs between jobs while the runner service
# is stopped, so this move can never race a running job. A legacy _work/_tool
# is moved to the configured location only when that location does not exist
# yet (never merged); otherwise the legacy copy is left for the regular _work
# reset. Rollback path: stop the supervisor, unset AGENT_TOOLSDIRECTORY, and
# move _toolcache back to _work/_tool — migration never deletes the cache.
migrate_tool_cache() {
  local legacy="${DIR}/_work/_tool"
  [[ -e "${legacy}" || -L "${legacy}" ]] || return 0
  if [[ -L "${legacy}" ]]; then
    warn "Legacy tool cache ${legacy} is a symlink; not migrating (it resets with _work)."
    return 0
  fi
  [[ -d "${legacy}" ]] || return 0
  if [[ -e "${TOOL_CACHE_DIR}" || -L "${TOOL_CACHE_DIR}" ]]; then
    warn "Tool cache ${TOOL_CACHE_DIR} already exists; not merging legacy ${legacy} (it resets with _work)."
    return 0
  fi
  mkdir -p "$(dirname "${TOOL_CACHE_DIR}")" || return 1
  mv "${legacy}" "${TOOL_CACHE_DIR}" || return 1
  step "Migrated legacy _work/_tool cache to ${TOOL_CACHE_DIR}"
}

# ----------------------------------------------------------------------------
# Wipe job output and registration residue so every cycle starts from a
# reset workspace (binaries, operator configuration, the persistent tool
# cache, and _diag logs are kept). _work goes through reset_workspace, which
# honors --snapshot-rollback and always falls back to rm -rf.
# ----------------------------------------------------------------------------
wipe_state() {
  resolve_tool_cache_dir || return 1
  migrate_tool_cache || return 1
  reset_workspace || return 1
  rm -f "${DIR}/.runner" "${DIR}/.credentials" \
        "${DIR}/.credentials_rsaparams" || return 1
  # .env/.path are operator service/toolchain configuration. Retain job hooks
  # and PATH across cycles; these files are not job registration credentials.
}

# ----------------------------------------------------------------------------
# One lifecycle: register (ephemeral) -> run one job in the foreground.
# ----------------------------------------------------------------------------
FETCHED_TOKEN=""
SAVED_NAME=""
SAVED_URL=""
RUNNER_NAME=""
RUNNER_GROUP=""

run_cycle() {
  # Resolve and export the persistent tool cache first, so a misconfigured
  # AGENT_TOOLSDIRECTORY fails the cycle (backoff) instead of wasting a
  # registration token or running a job whose cache cannot persist.
  if ! resolve_tool_cache_dir; then
    return 1
  fi

  read_saved_identity
  step "Identity: '${RUNNER_NAME}' @ ${RUNNER_URL} (labels: ${LABELS})"

  if ! fetch_registration_token; then
    return 1
  fi
  step "Fresh registration token obtained (not logged)."

  if ! wipe_state; then
    FETCHED_TOKEN=""
    warn "Could not clean the previous job; refusing re-registration."
    return 1
  fi
  step "Wiped _work and registration residue."

  # config.sh re-creates .runner/.credentials; --ephemeral makes GitHub remove
  # the runner automatically after it completes ONE job. --replace overwrites
  # any stale same-name registration left by an interrupted previous cycle.
  local config_rc=0 saved_path=""
  local -a config_args=(
    --unattended --ephemeral --url "${RUNNER_URL}" --token "${FETCHED_TOKEN}"
    --name "${RUNNER_NAME}" --labels "${LABELS}" --replace
  )
  [[ -z "${RUNNER_GROUP}" ]] || config_args+=(--runnergroup "${RUNNER_GROUP}")
  # Upstream config.sh runs env.sh, which rewrites .path from its environment.
  # Carry the existing toolchain PATH into config, not just through wipe_state.
  if [[ -f "${DIR}/.path" ]]; then
    if ! saved_path="$(cat "${DIR}/.path")"; then
      FETCHED_TOKEN=""
      warn "Could not read the saved toolchain PATH; refusing re-registration."
      return 1
    fi
  fi
  (
    cd "${DIR}" || exit 1
    [[ -z "${saved_path}" ]] || export PATH="${saved_path}"
    ./config.sh "${config_args[@]}"
  ) || config_rc=$?
  config_args=()
  FETCHED_TOKEN=""
  if [[ "${config_rc}" -ne 0 || ! -f "${DIR}/.runner" ]]; then
    local marker; marker="$( [[ -f "${DIR}/.runner" ]] && echo present || echo missing )"
    warn "Registration failed (config.sh rc=${config_rc}, .runner ${marker})."
    return 1
  fi
  log "Registered ephemeral runner '${RUNNER_NAME}'. Waiting for one job..."

  # OPT-IN: capture the clean post-registration baseline so the next cycle
  # can restore _work from an APFS snapshot instead of deleting it.
  if [[ "${SNAPSHOT_ROLLBACK}" -eq 1 ]]; then
    if ! take_workspace_snapshot; then
      warn "Snapshot unavailable; workspace resets use rm -rf cleanup this cycle."
    fi
  fi

  # OPT-IN: sandbox the runner service. Failing to honor an explicit
  # --sandbox request fails the cycle (with backoff) rather than running
  # unconfined.
  if [[ "${SANDBOX}" -eq 1 ]] && ! prepare_sandbox_profile; then
    return 1
  fi

  # runsvc.sh is the service entrypoint (translates TERM->INT); it resolves
  # .path/externals/RunnerService.js relative to CWD, so run it from ${DIR}.
  # Foreground from OUR perspective: background + wait so the TERM trap can
  # forward signals to the child.
  local run_rc=0
  if [[ "${SANDBOX}" -eq 1 ]]; then
    (
      cd "${DIR}" || exit 1
      ACTIONS_RUNNER_SVC=1 exec sandbox-exec -f "${SANDBOX_PROFILE_FILE}" ./bin/runsvc.sh
    ) &
  else
    (
      cd "${DIR}" || exit 1
      ACTIONS_RUNNER_SVC=1 exec ./bin/runsvc.sh
    ) &
  fi
  CHILD_PID=$!
  wait "${CHILD_PID}" && run_rc=0 || run_rc=$?
  CHILD_PID=""
  log "Runner '${RUNNER_NAME}' exited (rc=${run_rc}); job complete or service stopped."
  # A failed listener must back off too, otherwise a crash can continuously
  # re-register and hammer the API. Job failures normally still exit the service 0.
  [[ "${run_rc}" -eq 0 ]]
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
  parse_args "$@"
  detect_platform
  # Older installed plists may predate runner-setup's explicit Homebrew PATH.
  # Find formula dependencies even before config.sh loads .path, while keeping
  # the operator's existing tool precedence intact.
  export PATH="${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}:/opt/homebrew/bin:/usr/local/bin"
  require_cmds
  detect_user
  check_runner_dir
  resolve_pat
  resolve_scope

  log "Supervising ephemeral runner in ${DIR}"
  local failures=0 delay cycle=0
  while :; do
    cycle=$((cycle + 1))
    log "Lifecycle cycle ${cycle} starting."
    if run_cycle; then
      failures=0
    else
      failures=$((failures + 1))
      if [[ "${failures}" -ge "${MAX_FAILURES}" ]]; then
        err "Re-registration failed ${failures} times in a row; giving up."
        err "Exiting non-zero so launchd (KeepAlive/ThrottleInterval) restarts us."
        exit 1
      fi
      # Exponential backoff: 10s, 20s, 40s, ... capped at 300s.
      delay=$((10 * 2 ** (failures - 1)))
      [[ "${delay}" -le 300 ]] || delay=300
      warn "Cycle failed (${failures}/${MAX_FAILURES}); retrying in ${delay}s."
      sleep "${delay}"
    fi
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi

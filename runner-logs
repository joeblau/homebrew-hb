#!/usr/bin/env bash
#
# runner-logs — ship GitHub Actions self-hosted runner logs + metrics to a
# central aggregator on macOS.
#
# Usage:
#   runner-logs ship [--sink file|http] [--output-dir DIR] [--interval SEC]
#   runner-logs metrics [--interval SEC] [--once]
#   runner-logs tail [--runner N] [--kind runner|worker|stdout|stderr] [--lines N] [--json]
#   runner-logs jobs [--runner N] [--limit N] [--json]
#   runner-logs steps [--runner N] [--interval SEC] [--once]
#   runner-logs tests ingest [--junit-glob GLOB] [PATH ...]
#   runner-logs tests report [--suite NAME] [--limit N] [--json]
#   runner-logs dashboard [--output FILE] [--limit N]
#
# ship:    tails every runner's _diag/*.log (Runner_*.log, Worker_*.log, plus
#          the runner-stdout.log / runner-stderr.log written by the LaunchDaemon
#          plist) under /opt/github-runners and forwards new lines as JSON
#          (one object per line) to a pluggable sink. File offsets are tracked
#          in a state file so restarts resume where they left off instead of
#          re-shipping everything. Runs read-only against /opt — no sudo.
#
# metrics: emits one JSON line per runner per interval with online status
#          (launchctl + newest diag 'Listening for Jobs'), the last job result
#          (Worker 'completed with result' lines), disk usage on the runner
#          volume, and — when GITHUB_PAT is set — queue depth from the GitHub
#          API. Uses sudo only for `launchctl print system/...`.
#
# tail:    print the last N lines of one runner's newest diag log (Runner_*,
#          Worker_*, or the LaunchDaemon stdout/stderr files). No sudo.
#
# jobs:    list recent Worker completions (job name, result, start time,
#          duration) across runners, newest first. No sudo. Both tail and
#          jobs accept --json for agents and scripts (docs/agent-tools.md).
#
# steps:   samples per-runner CPU/memory with ps (read-only) while jobs run
#          and correlates the samples with step boundaries (StepsRunner
#          lines) parsed from Worker_*.log, emitting one JSON line per
#          completed step: name, start/end, duration, mean/peak CPU %, and
#          peak RSS. --once reconstructs post-hoc from the logs plus the
#          recorded samples without taking new ones. No sudo.
#
# tests:   ingests JUnit XML results into a JSON-lines history database and
#          reports per-suite pass/fail/error counts plus flaky tests (tests
#          whose result flips between consecutive runs of the same suite).
#
# dashboard: renders a self-contained static HTML report (inline CSS, no
#          external assets) with per-runner online status, recent job
#          results and durations, and the top flaky tests. No sudo.
#
# steps/tests/dashboard use python3 (stdlib only) for the heavier parsing
# and reporting; everything else is bash 3.2.
#
# The script never runs any runner process and never sets
# RUNNER_ALLOW_RUNASROOT; it only READS runner state. Secrets (bearer token,
# GITHUB_PAT) come from env vars and are passed to curl via a 0600 config
# file, never on the command line where `ps` could expose them.

set -euo pipefail

# ----------------------------------------------------------------------------
# Constants / globals
# ----------------------------------------------------------------------------
PROG_NAME="$(basename "$0")"
RUNNER_ROOT="/opt/github-runners"
GITHUB_API="https://api.github.com"

MODE=""                          # ship | metrics | tail | jobs | steps | tests | dashboard
RUNNER_FILTER=""                 # tail/jobs/steps: only this runner (runner-N or N)
LOG_KIND="runner"                # tail: runner | worker | stdout | stderr
LINES=200                        # tail: lines to print
LIMIT=20                         # jobs/report/dashboard: rows to list
JSON=0                           # tail/jobs/tests report: JSON output on stdout
SUDO="sudo"                      # metrics: "sudo -n" when launchctl print is passwordless
SINK="file"                      # file | http
OUTPUT_DIR=""                    # default resolved after arg parse
INTERVAL=""                      # default depends on MODE
ONCE=0
STATE_FILE=""                    # default resolved after arg parse
BATCH_SIZE=500                   # max JSON lines per HTTP POST
ENDPOINT=""                      # default: LOG_HTTP_ENDPOINT env
TESTS_CMD=""                     # tests: ingest | report
JUNIT_GLOBS=""                   # tests ingest: colon-separated paths/globs
SUITE_FILTER=""                  # tests report: only this suite
SAMPLES_FILE=""                  # steps: ps sample history (default resolved after parse)
STEPS_STATE_FILE=""              # steps: incremental emit state (default resolved after parse)
HISTORY_FILE=""                  # tests: JSON-lines run history DB (default after parse)
DASHBOARD_OUTPUT=""              # dashboard: HTML output path (default after parse)

HOST_LABEL=""
WORK_TMPDIR=""
CURL_AUTH_CONFIG=""              # 0600 curl -K file holding the bearer header
SHIP_OK=1                        # 0 when any sink write failed this pass
BATCH=""
BATCH_COUNT=0

# ----------------------------------------------------------------------------
# Output helpers — progress goes to stderr; secrets are NEVER interpolated.
# ----------------------------------------------------------------------------
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
step() { printf '\033[1;32m  ->\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; }

usage() {
  cat >&2 <<EOF
${PROG_NAME} — ship runner logs and metrics to a central aggregator (macOS)

USAGE:
  ${PROG_NAME} [ship] [--sink file|http] [--output-dir DIR] [--interval SEC] [--once]
  ${PROG_NAME} metrics [--interval SEC] [--once]
  ${PROG_NAME} tail [--runner N] [--kind runner|worker|stdout|stderr] [--lines N] [--json]
  ${PROG_NAME} jobs [--runner N] [--limit N] [--json]
  ${PROG_NAME} steps [--runner N] [--interval SEC] [--once]
  ${PROG_NAME} tests ingest [--junit-glob GLOB] [PATH ...]
  ${PROG_NAME} tests report [--suite NAME] [--limit N] [--json]
  ${PROG_NAME} dashboard [--output FILE] [--limit N]

MODES:
  ship (default)   Tail ${RUNNER_ROOT}/runner-*/_diag/*.log (Runner_*,
                   Worker_*, runner-stdout.log, runner-stderr.log) and forward
                   new lines as JSON-lines to the chosen sink. Per-file byte
                   offsets are persisted in a state file, so a restart resumes
                   where it stopped; rotated/truncated files are detected via
                   inode+size and re-read from the top.
  metrics          Emit one JSON line per runner per interval to stdout:
                   runner name, online status (launchctl + newest diag
                   'Listening for Jobs'), last job result (Worker 'completed
                   with result' lines), disk free/used on the runner volume,
                   and queue depth when GITHUB_PAT is set.
  tail             Print the last --lines lines of one runner's newest log of
                   the chosen --kind. Defaults to the single installed runner
                   when --runner is omitted and exactly one exists. No sudo.
  jobs             List recent job completions parsed from Worker_*.log files
                   (name, result, started, duration), newest first. No sudo.
  steps            Sample per-runner CPU/memory with ps (read-only) every
                   --interval and correlate the samples with step boundaries
                   (StepsRunner lines) in Worker_*.log, emitting one JSON
                   line per completed step: name, start/end, duration,
                   mean/peak CPU %, peak RSS MB. Samples are appended to
                   --samples-file; --once skips sampling and reconstructs
                   post-hoc from the logs plus recorded samples. No sudo.
  tests ingest     Parse JUnit XML files (paths or --junit-glob globs; '**'
                   recurses) into the JSON-lines history DB (--history-file).
                   Files whose mtime is unchanged are not re-ingested.
  tests report     Per-suite run/pass/fail/error/skip counts and flaky
                   tests — tests whose status flips between consecutive
                   runs of the same suite. --json for scripts and agents.
  dashboard        Write a self-contained static HTML report (inline CSS,
                   no external assets) to --output: per-runner online
                   status, recent job results and durations, and the top
                   flaky tests. No sudo.

SINKS (ship mode):
  --sink file      Append JSON lines to OUTPUT_DIR/runner-logs-YYYYMMDD.jsonl
                   (default; zero dependencies).
  --sink http      POST newline-delimited JSON batches to LOG_HTTP_ENDPOINT
                   (e.g. a Fluent Bit / Logstash / Vector HTTP input feeding
                   Elasticsearch _bulk or Loki). Auth: LOG_HTTP_TOKEN env var
                   sent as a Bearer header via a 0600 curl config file.

OPTIONS:
  --sink file|http  Ship sink (default: file)
  --output-dir DIR  Directory for the file sink (default: ~/Library/Logs/github-runners)
  --state-file PATH Offset state file (default: ~/.runner-logs/offsets.tsv)
  --endpoint URL    HTTP sink endpoint (default: LOG_HTTP_ENDPOINT env)
  --batch-size N    Max JSON lines per HTTP POST (default: ${BATCH_SIZE})
  --interval SEC    Seconds between passes (default: 10 ship/steps / 60 metrics)
  --once            Run a single pass and exit (for cron/launchd/manual runs);
                    steps: reconstruct from logs + recorded samples only
  --runner N        tail/jobs/steps: restrict to runner-N (accepts 'runner-N' or 'N')
  --kind KIND       tail: runner (default) | worker | stdout | stderr
  --lines N         tail: number of trailing lines (default: ${LINES})
  --limit N         jobs/report/dashboard: maximum rows to list (default: ${LIMIT})
  --samples-file PATH  steps: ps sample history (default: ~/.runner-logs/steps-samples.jsonl)
  --history-file PATH  tests/dashboard: run history DB (default: ~/.runner-logs/test-history.jsonl)
  --junit-glob GLOB tests ingest: glob of JUnit XML files (repeatable; '**' recurses)
  --suite NAME      tests report: restrict to one suite
  --output FILE     dashboard: HTML output path (default: ~/.runner-logs/dashboard.html)
  --json            tail/jobs/tests report: emit JSON on stdout instead of text
  -h, --help        Show this help and exit

ENVIRONMENT:
  LOG_HTTP_ENDPOINT  Target URL for --sink http (required for that sink)
  LOG_HTTP_TOKEN     Bearer token for the HTTP sink (never logged, never in ps)
  GITHUB_PAT         PAT (actions:read) enabling queue metrics in metrics mode
  GITHUB_QUEUE_REPO  OWNER/REPO override for queue metrics (default: derived
                     from a repo-scoped runner's .runner gitHubUrl)
  RUNNER_LOGS_JUNIT_GLOBS  Colon-separated default globs for tests ingest

EXAMPLES:
  ${PROG_NAME} ship --once
  ${PROG_NAME} ship --sink http --interval 15
  LOG_HTTP_ENDPOINT=https://logs.example.com:8080 LOG_HTTP_TOKEN=... ${PROG_NAME} ship
  ${PROG_NAME} metrics --once
  GITHUB_PAT=ghp_... GITHUB_QUEUE_REPO=acme/monorepo ${PROG_NAME} metrics --once
  ${PROG_NAME} tail --runner 2 --kind worker --lines 50
  ${PROG_NAME} jobs --limit 5 --json
  ${PROG_NAME} steps --interval 5
  ${PROG_NAME} steps --once --runner 1
  ${PROG_NAME} tests ingest --junit-glob '/opt/github-runners/runner-*/_work/**/*.xml'
  ${PROG_NAME} tests report --json
  ${PROG_NAME} dashboard --output ~/Desktop/runners.html

  Emit a synthetic 'job' event for every Worker completion line — each such
  shipped line also carries job_name / job_result / job_duration_s so
  dashboards can graph success/failure rate and job duration directly.
  See docs/log-aggregation.md for the launchd plist and sample queries.

SECURITY NOTE:
  Secrets come from env vars only. LOG_HTTP_TOKEN and GITHUB_PAT are handed to
  curl through a temporary 0600 config file (curl -K), so they never appear in
  'ps' output or in this script's logs. Ship mode needs NO sudo (runner logs
  are user-readable); metrics mode uses sudo only for
  'launchctl print system/...'. This script never starts or stops runners.
EOF
}

# ----------------------------------------------------------------------------
# Cleanup / signal traps
# ----------------------------------------------------------------------------
cleanup() {
  local code=$?
  if [[ -n "${CURL_AUTH_CONFIG}" && -f "${CURL_AUTH_CONFIG}" ]]; then
    rm -f "${CURL_AUTH_CONFIG}" 2>/dev/null || true
  fi
  if [[ -n "${WORK_TMPDIR}" && -d "${WORK_TMPDIR}" ]]; then
    rm -rf "${WORK_TMPDIR}" 2>/dev/null || true
  fi
  return "${code}"
}
trap cleanup EXIT
trap 'err "Interrupted."; exit 130' INT TERM

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
parse_args() {
  # Optional leading mode word; default is ship.
  if [[ $# -gt 0 ]]; then
    case "$1" in
      ship|metrics|tail|jobs|steps|tests|dashboard) MODE="$1"; shift ;;
    esac
  fi
  [[ -n "${MODE}" ]] || MODE="ship"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --sink)
        [[ $# -ge 2 ]] || { err "--sink requires a value"; usage; exit 2; }
        SINK="$2"; shift 2 ;;
      --sink=*)    SINK="${1#*=}"; shift ;;
      --output-dir)
        [[ $# -ge 2 ]] || { err "--output-dir requires a value"; usage; exit 2; }
        OUTPUT_DIR="$2"; shift 2 ;;
      --output-dir=*) OUTPUT_DIR="${1#*=}"; shift ;;
      --state-file)
        [[ $# -ge 2 ]] || { err "--state-file requires a value"; usage; exit 2; }
        STATE_FILE="$2"; shift 2 ;;
      --state-file=*) STATE_FILE="${1#*=}"; shift ;;
      --endpoint)
        [[ $# -ge 2 ]] || { err "--endpoint requires a value"; usage; exit 2; }
        ENDPOINT="$2"; shift 2 ;;
      --endpoint=*) ENDPOINT="${1#*=}"; shift ;;
      --batch-size)
        [[ $# -ge 2 ]] || { err "--batch-size requires a value"; usage; exit 2; }
        BATCH_SIZE="$2"; shift 2 ;;
      --batch-size=*) BATCH_SIZE="${1#*=}"; shift ;;
      --interval)
        [[ $# -ge 2 ]] || { err "--interval requires a value"; usage; exit 2; }
        INTERVAL="$2"; shift 2 ;;
      --interval=*) INTERVAL="${1#*=}"; shift ;;
      --once)      ONCE=1; shift ;;
      --runner)
        [[ $# -ge 2 ]] || { err "--runner requires a value"; usage; exit 2; }
        RUNNER_FILTER="$2"; shift 2 ;;
      --runner=*)  RUNNER_FILTER="${1#*=}"; shift ;;
      --kind)
        [[ $# -ge 2 ]] || { err "--kind requires a value"; usage; exit 2; }
        LOG_KIND="$2"; shift 2 ;;
      --kind=*)    LOG_KIND="${1#*=}"; shift ;;
      --lines)
        [[ $# -ge 2 ]] || { err "--lines requires a value"; usage; exit 2; }
        LINES="$2"; shift 2 ;;
      --lines=*)   LINES="${1#*=}"; shift ;;
      --limit)
        [[ $# -ge 2 ]] || { err "--limit requires a value"; usage; exit 2; }
        LIMIT="$2"; shift 2 ;;
      --limit=*)   LIMIT="${1#*=}"; shift ;;
      --samples-file)
        [[ $# -ge 2 ]] || { err "--samples-file requires a value"; usage; exit 2; }
        SAMPLES_FILE="$2"; shift 2 ;;
      --samples-file=*) SAMPLES_FILE="${1#*=}"; shift ;;
      --history-file)
        [[ $# -ge 2 ]] || { err "--history-file requires a value"; usage; exit 2; }
        HISTORY_FILE="$2"; shift 2 ;;
      --history-file=*) HISTORY_FILE="${1#*=}"; shift ;;
      --junit-glob)
        [[ $# -ge 2 ]] || { err "--junit-glob requires a value"; usage; exit 2; }
        if [[ -n "${JUNIT_GLOBS}" ]]; then JUNIT_GLOBS="${JUNIT_GLOBS}:$2"; else JUNIT_GLOBS="$2"; fi
        shift 2 ;;
      --junit-glob=*)
        if [[ -n "${JUNIT_GLOBS}" ]]; then JUNIT_GLOBS="${JUNIT_GLOBS}:${1#*=}"; else JUNIT_GLOBS="${1#*=}"; fi
        shift ;;
      --suite)
        [[ $# -ge 2 ]] || { err "--suite requires a value"; usage; exit 2; }
        SUITE_FILTER="$2"; shift 2 ;;
      --suite=*)   SUITE_FILTER="${1#*=}"; shift ;;
      --output)
        [[ $# -ge 2 ]] || { err "--output requires a value"; usage; exit 2; }
        DASHBOARD_OUTPUT="$2"; shift 2 ;;
      --output=*)  DASHBOARD_OUTPUT="${1#*=}"; shift ;;
      --json)      JSON=1; shift ;;
      -h|--help)   usage; exit 0 ;;
      *)
        if [[ "${MODE}" == "tests" && -z "${TESTS_CMD}" ]]; then
          case "$1" in
            ingest|report) TESTS_CMD="$1"; shift ;;
            *) err "tests subcommand must be 'ingest' or 'report' (got: '$1')"; exit 2 ;;
          esac
        elif [[ "${MODE}" == "tests" && "${TESTS_CMD}" == "ingest" ]]; then
          if [[ -n "${JUNIT_GLOBS}" ]]; then JUNIT_GLOBS="${JUNIT_GLOBS}:$1"; else JUNIT_GLOBS="$1"; fi
          shift
        else
          err "Unknown argument: $1"
          usage
          exit 2
        fi ;;
    esac
  done

  if [[ -n "${RUNNER_FILTER}" ]]; then
    [[ "${RUNNER_FILTER}" == runner-* ]] || RUNNER_FILTER="runner-${RUNNER_FILTER}"
    if ! [[ "${RUNNER_FILTER}" =~ ^runner-[0-9]+$ ]]; then
      err "--runner must be N or runner-N (got: '${RUNNER_FILTER}')"
      exit 2
    fi
  fi
  case "${LOG_KIND}" in
    runner|worker|stdout|stderr) ;;
    *) err "--kind must be runner, worker, stdout, or stderr (got: '${LOG_KIND}')"; exit 2 ;;
  esac
  if ! [[ "${LINES}" =~ ^[0-9]+$ ]] || [[ "${LINES}" -lt 1 ]]; then
    err "--lines must be a positive integer (got: '${LINES}')"
    exit 2
  fi
  if ! [[ "${LIMIT}" =~ ^[0-9]+$ ]] || [[ "${LIMIT}" -lt 1 ]]; then
    err "--limit must be a positive integer (got: '${LIMIT}')"
    exit 2
  fi

  case "${SINK}" in
    file|http) ;;
    *) err "--sink must be 'file' or 'http' (got: '${SINK}')"; exit 2 ;;
  esac

  [[ -n "${OUTPUT_DIR}" ]] || OUTPUT_DIR="${HOME}/Library/Logs/github-runners"
  [[ -n "${STATE_FILE}" ]] || STATE_FILE="${HOME}/.runner-logs/offsets.tsv"
  [[ -n "${ENDPOINT}" ]] || ENDPOINT="${LOG_HTTP_ENDPOINT:-}"
  [[ -n "${JUNIT_GLOBS}" ]] || JUNIT_GLOBS="${RUNNER_LOGS_JUNIT_GLOBS:-}"
  [[ -n "${SAMPLES_FILE}" ]] || SAMPLES_FILE="${HOME}/.runner-logs/steps-samples.jsonl"
  [[ -n "${STEPS_STATE_FILE}" ]] || STEPS_STATE_FILE="${HOME}/.runner-logs/steps-state.tsv"
  [[ -n "${HISTORY_FILE}" ]] || HISTORY_FILE="${HOME}/.runner-logs/test-history.jsonl"
  [[ -n "${DASHBOARD_OUTPUT}" ]] || DASHBOARD_OUTPUT="${HOME}/.runner-logs/dashboard.html"
  if [[ "${MODE}" == "tests" ]]; then
    if [[ -z "${TESTS_CMD}" ]]; then
      err "tests requires a subcommand: ingest or report"
      usage
      exit 2
    fi
    if [[ "${TESTS_CMD}" == "ingest" && -z "${JUNIT_GLOBS}" ]]; then
      err "tests ingest requires JUnit XML path(s) or --junit-glob GLOB"
      exit 2
    fi
  fi
  if [[ -z "${INTERVAL}" ]]; then
    if [[ "${MODE}" == "metrics" ]]; then INTERVAL=60; else INTERVAL=10; fi
  fi
  if ! [[ "${INTERVAL}" =~ ^[0-9]+$ ]] || [[ "${INTERVAL}" -lt 1 ]]; then
    err "--interval must be a positive integer (got: '${INTERVAL}')"
    exit 2
  fi
  if ! [[ "${BATCH_SIZE}" =~ ^[0-9]+$ ]] || [[ "${BATCH_SIZE}" -lt 1 ]]; then
    err "--batch-size must be a positive integer (got: '${BATCH_SIZE}')"
    exit 2
  fi
  if [[ "${MODE}" == "ship" && "${SINK}" == "http" && -z "${ENDPOINT}" ]]; then
    err "--sink http requires LOG_HTTP_ENDPOINT (or --endpoint)."
    exit 2
  fi
}

# ----------------------------------------------------------------------------
# Environment detection
# ----------------------------------------------------------------------------
detect_platform() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    err "This tool only supports macOS."
    exit 1
  fi
}

require_cmds() {
  local missing=() c
  local cmds="sed grep awk cut tail stat date basename uname mktemp tr ls"
  if [[ "${MODE}" == "metrics" ]]; then
    cmds="${cmds} sudo launchctl df head sleep"
  elif [[ "${MODE}" == "tail" || "${MODE}" == "jobs" ]]; then
    cmds="${cmds} head sort"
  elif [[ "${MODE}" == "steps" ]]; then
    cmds="${cmds} ps sleep python3"
  elif [[ "${MODE}" == "tests" ]]; then
    cmds="${cmds} python3"
  elif [[ "${MODE}" == "dashboard" ]]; then
    cmds="${cmds} python3 head sort"
  fi
  if [[ "${SINK}" == "http" && "${MODE}" == "ship" ]] \
      || [[ "${MODE}" == "metrics" && -n "${GITHUB_PAT:-}" ]]; then
    cmds="${cmds} curl"
  fi
  for c in ${cmds}; do
    command -v "${c}" >/dev/null 2>&1 || missing+=("${c}")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Required command(s) not found: ${missing[*]}"
    exit 1
  fi
}

# Sanitized machine name, mirroring runner-setup's detect_host.
detect_host() {
  local h
  h="$(scutil --get LocalHostName 2>/dev/null || true)"
  [[ -n "${h}" ]] || h="$(hostname -s 2>/dev/null || true)"
  [[ -n "${h}" ]] || h="$(uname -n 2>/dev/null | cut -d. -f1 || true)"
  h="$(printf '%s' "${h}" | tr -c 'A-Za-z0-9' '-' | tr -s '-')"
  h="${h#-}"; h="${h%-}"
  HOST_LABEL="${h:-mac}"
}

iso_now() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

# Escape a raw log line for embedding in a JSON string: backslashes, double
# quotes, literal tabs. Every other control character (carriage returns, ANSI
# escapes in Worker output) is stripped so the result is always valid JSON.
json_escape() {
  printf '%s' "$1" \
    | tr -d '\000-\010\013-\037' \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g'
}

# Build a 0600 curl config file carrying the Authorization header so the
# bearer token never appears in `ps` (curl -K reads headers from a file).
make_curl_auth_config() {
  local token="$1"
  [[ -z "${CURL_AUTH_CONFIG}" ]] || return 0
  WORK_TMPDIR="$(mktemp -d "${TMPDIR:-/tmp}/runner-logs.XXXXXX")"
  CURL_AUTH_CONFIG="${WORK_TMPDIR}/curl-auth.conf"
  printf 'header = "Authorization: Bearer %s"\n' "${token}" > "${CURL_AUTH_CONFIG}"
  chmod 600 "${CURL_AUTH_CONFIG}"
}

# ----------------------------------------------------------------------------
# SHIP mode
# ----------------------------------------------------------------------------

# Print the stored "inode<TAB>offset" for a log path, or nothing.
state_lookup() {
  local path="$1"
  [[ -f "${STATE_FILE}" ]] || return 0
  awk -F '\t' -v p="${path}" '$1 == p { print $2 "\t" $3; exit }' \
    "${STATE_FILE}" 2>/dev/null || true
}

# Extra JSON fields for Worker completion lines: job name, result, and a
# duration derived from the Worker_YYYYMMDD-HHMMSS-utc.log filename (the job
# start, UTC) to now. Prints e.g. `,"job_name":"build","job_result":"Succeeded"`
# or nothing for non-completion lines, so dashboards get first-class fields.
job_fields() {
  local base="$1" line="$2"
  case "${base}" in
    Worker_*.log) ;;
    *) return 0 ;;
  esac
  [[ "${line}" == *"completed with result"* ]] || return 0

  local job result stamp epoch duration="" out=""
  job="$(printf '%s' "${line}" \
    | sed -n "s/.*Job '\([^']*\)'.*/\1/p" | head -n1 || true)"
  if [[ -z "${job}" ]]; then
    job="$(printf '%s' "${line}" \
      | sed -n 's/.*Job \([^ ]*\) completed.*/\1/p' | head -n1 || true)"
  fi
  result="$(printf '%s' "${line}" \
    | sed -n 's/.*completed with result:[[:space:]]*\([A-Za-z]*\).*/\1/p' \
    | head -n1 || true)"

  stamp="$(printf '%s' "${base}" \
    | sed -n 's/^Worker_\([0-9]\{8\}-[0-9]\{6\}\)-utc\.log/\1/p' | head -n1 || true)"
  if [[ -n "${stamp}" ]]; then
    epoch="$(date -j -u -f '%Y%m%d-%H%M%S' "${stamp}" '+%s' 2>/dev/null || true)"
    if [[ -n "${epoch}" ]]; then
      duration=$(( $(date -u '+%s') - epoch ))
    fi
  fi

  [[ -z "${job}" ]]    || out="${out},\"job_name\":\"$(json_escape "${job}")\""
  [[ -z "${result}" ]] || out="${out},\"job_result\":\"$(json_escape "${result}")\""
  [[ -z "${duration}" ]] || out="${out},\"job_duration_s\":${duration}"
  printf '%s' "${out}"
}

emit_line() {
  local json="$1"
  case "${SINK}" in
    file)
      if ! printf '%s\n' "${json}" >> "${OUTPUT_DIR}/runner-logs-$(date -u '+%Y%m%d').jsonl"; then
        SHIP_OK=0
      fi
      ;;
    http)
      BATCH="${BATCH}${json}"$'\n'
      BATCH_COUNT=$((BATCH_COUNT + 1))
      if [[ "${BATCH_COUNT}" -ge "${BATCH_SIZE}" ]]; then
        flush_batch
      fi
      ;;
  esac
}

flush_batch() {
  [[ "${BATCH_COUNT}" -gt 0 ]] || return 0
  local rc=0
  if [[ -n "${CURL_AUTH_CONFIG}" ]]; then
    printf '%s' "${BATCH}" | curl -fsS -o /dev/null \
      --connect-timeout 5 --max-time 30 \
      -K "${CURL_AUTH_CONFIG}" \
      -H 'Content-Type: application/x-ndjson' \
      --data-binary @- "${ENDPOINT}" || rc=$?
  else
    printf '%s' "${BATCH}" | curl -fsS -o /dev/null \
      --connect-timeout 5 --max-time 30 \
      -H 'Content-Type: application/x-ndjson' \
      --data-binary @- "${ENDPOINT}" || rc=$?
  fi
  if [[ "${rc}" -ne 0 ]]; then
    warn "HTTP sink POST failed (curl rc=${rc}); batch will be re-sent next pass."
    SHIP_OK=0
  fi
  BATCH=""
  BATCH_COUNT=0
}

# Ship new bytes of one file, starting at 1-based byte offset $4.
ship_chunk() {
  local runner="$1" base="$2" file="$3" from="$4"
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -n "${line}" ]] || continue
    emit_line "{\"ts\":\"$(iso_now)\",\"host\":\"${HOST_LABEL}\",\"runner\":\"${runner}\",\"source\":\"${base}\",\"line\":\"$(json_escape "${line}")\"$(job_fields "${base}" "${line}")}"
  done < <(tail -c "+${from}" "${file}" 2>/dev/null || true)
}

ship_pass() {
  local state_dir tmp_state
  state_dir="$(dirname "${STATE_FILE}")"
  mkdir -p "${state_dir}"
  tmp_state="$(mktemp "${state_dir}/.offsets.XXXXXX")"
  SHIP_OK=1

  local d f runner base size inode start stored s_inode s_offset
  shopt -s nullglob
  for d in "${RUNNER_ROOT}"/runner-*; do
    [[ -d "${d}/_diag" ]] || continue
    runner="$(basename "${d}")"
    for f in "${d}/_diag"/*.log; do
      [[ -f "${f}" ]] || continue
      base="$(basename "${f}")"
      stored="$(state_lookup "${f}")"

      # Unreadable (different owner): keep the old offset so nothing is
      # skipped, and retry next pass instead of reshipping from byte 0.
      if [[ ! -r "${f}" ]]; then
        warn "Not readable, skipping this pass: ${f}"
        if [[ -n "${stored}" ]]; then
          printf '%s\t%s\n' "${f}" "${stored}" >> "${tmp_state}"
        fi
        continue
      fi

      size="$(stat -f %z "${f}")"
      inode="$(stat -f %i "${f}")"

      # Resume from the stored offset only when the file is the same inode
      # and did not shrink; otherwise it was rotated/truncated -> re-read.
      start=0
      if [[ -n "${stored}" ]]; then
        s_inode="$(printf '%s' "${stored}" | cut -f1)"
        s_offset="$(printf '%s' "${stored}" | cut -f2)"
        if [[ "${s_inode}" == "${inode}" && "${s_offset}" -le "${size}" ]]; then
          start="${s_offset}"
        fi
      fi

      if [[ "${size}" -gt "${start}" ]]; then
        ship_chunk "${runner}" "${base}" "${f}" "$((start + 1))"
      fi
      printf '%s\t%s\t%s\n' "${f}" "${inode}" "${size}" >> "${tmp_state}"
    done
  done
  shopt -u nullglob

  flush_batch
  # Only commit offsets when every sink write succeeded (at-least-once:
  # a failed pass re-ships those lines rather than losing them).
  if [[ "${SHIP_OK}" -eq 1 ]]; then
    mv "${tmp_state}" "${STATE_FILE}"
  else
    rm -f "${tmp_state}"
    warn "Sink failure: offsets NOT advanced; lines will be re-sent next pass."
  fi
}

run_ship() {
  if [[ "${SINK}" == "http" && -n "${LOG_HTTP_TOKEN:-}" ]]; then
    make_curl_auth_config "${LOG_HTTP_TOKEN}"
  fi
  if [[ "${SINK}" == "file" ]]; then
    mkdir -p "${OUTPUT_DIR}"
    step "File sink: ${OUTPUT_DIR}/runner-logs-YYYYMMDD.jsonl"
  else
    step "HTTP sink: ${ENDPOINT} (batch ${BATCH_SIZE})"
  fi
  log "Shipping runner logs from ${RUNNER_ROOT}/runner-*/_diag (interval ${INTERVAL}s)"
  while :; do
    ship_pass
    [[ "${ONCE}" -eq 1 ]] && break
    sleep "${INTERVAL}"
  done
  if [[ "${SHIP_OK}" -eq 1 ]]; then
    log "Ship pass complete."
  else
    err "Ship pass finished with sink errors (see above)."
    return 1
  fi
}

# ----------------------------------------------------------------------------
# METRICS mode
# ----------------------------------------------------------------------------

# Queue depth from the GitHub API. Prints "queued in_progress"; empty on
# failure. The PAT travels via the 0600 curl config file, never argv.
queue_counts() {
  local slug="$1"
  local queued="" in_progress="" body
  body="$(curl -fsS --connect-timeout 5 --max-time 20 \
    -K "${CURL_AUTH_CONFIG}" \
    -H 'Accept: application/vnd.github+json' \
    "${GITHUB_API}/repos/${slug}/actions/runs?status=queued&per_page=1" \
    2>/dev/null || true)"
  queued="$(printf '%s' "${body}" \
    | grep -m1 '"total_count"' \
    | sed -E 's/[^0-9]*([0-9]+).*/\1/' || true)"
  body="$(curl -fsS --connect-timeout 5 --max-time 20 \
    -K "${CURL_AUTH_CONFIG}" \
    -H 'Accept: application/vnd.github+json' \
    "${GITHUB_API}/repos/${slug}/actions/runs?status=in_progress&per_page=1" \
    2>/dev/null || true)"
  in_progress="$(printf '%s' "${body}" \
    | grep -m1 '"total_count"' \
    | sed -E 's/[^0-9]*([0-9]+).*/\1/' || true)"
  printf '%s %s' "${queued}" "${in_progress}"
}

metrics_one() {
  local dir="$1"
  local name; name="$(basename "${dir}")"
  local label="com.github.${name}"
  local diag="${dir}/_diag"

  # GitHub-visible runner name from .runner (agentName), parsed without jq.
  local runner_name=""
  if [[ -f "${dir}/.runner" ]]; then
    runner_name="$(sed -n 's/.*"agentName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "${dir}/.runner" 2>/dev/null | head -n1 || true)"
  fi
  [[ -n "${runner_name}" ]] || runner_name="${name}"

  # launchd state (sudo only for the system domain).
  local daemon_loaded=0
  if ${SUDO} launchctl print "system/${label}" >/dev/null 2>&1; then
    daemon_loaded=1
  fi

  # Busy/idle from the newest Runner diag log's last marker line.
  local status="offline" newest_runner="" marker=""
  if [[ -d "${diag}" ]]; then
    newest_runner="$(ls -t "${diag}"/Runner_*.log 2>/dev/null | head -n1 || true)"
  fi
  if [[ -n "${newest_runner}" ]]; then
    marker="$(tail -n 300 "${newest_runner}" 2>/dev/null \
      | grep -E 'Listening for Jobs|Running job' | tail -n1 || true)"
  fi
  if [[ "${daemon_loaded}" -eq 1 ]]; then
    case "${marker}" in
      *"Running job"*)        status="busy" ;;
      *"Listening for Jobs"*) status="idle" ;;
      *)                      status="unknown" ;;
    esac
  fi

  # Last job result from the newest Worker diag log.
  local last_job_result="" last_job_name="" newest_worker="" wline=""
  if [[ -d "${diag}" ]]; then
    newest_worker="$(ls -t "${diag}"/Worker_*.log 2>/dev/null | head -n1 || true)"
  fi
  if [[ -n "${newest_worker}" ]]; then
    wline="$(grep 'completed with result' "${newest_worker}" 2>/dev/null \
      | tail -n1 || true)"
  fi
  if [[ -n "${wline}" ]]; then
    last_job_result="$(printf '%s' "${wline}" \
      | sed -n 's/.*completed with result:[[:space:]]*\([A-Za-z]*\).*/\1/p' \
      | head -n1 || true)"
    last_job_name="$(printf '%s' "${wline}" \
      | sed -n "s/.*Job '\([^']*\)'.*/\1/p" | head -n1 || true)"
  fi

  # Disk usage on the runner volume.
  local df_target="${RUNNER_ROOT}"
  [[ -d "${df_target}" ]] || df_target="/"
  local disk_total="" disk_used="" disk_avail="" disk_pct=""
  local dfline
  dfline="$(df -k "${df_target}" 2>/dev/null | awk 'NR==2 {print $2, $3, $4, $5}' || true)"
  if [[ -n "${dfline}" ]]; then
    disk_total="$(printf '%s' "${dfline}" | awk '{print $1}')"
    disk_used="$(printf '%s' "${dfline}" | awk '{print $2}')"
    disk_avail="$(printf '%s' "${dfline}" | awk '{print $3}')"
    disk_pct="$(printf '%s' "${dfline}" | awk '{gsub(/%/,"",$4); print $4}')"
  fi

  # Queue metrics (opt-in via GITHUB_PAT). Repo slug: GITHUB_QUEUE_REPO,
  # else a repo-scoped runner's gitHubUrl; org-scoped runners are skipped.
  local queue_json="" slug="${GITHUB_QUEUE_REPO:-}"
  if [[ -n "${GITHUB_PAT:-}" ]]; then
    if [[ -z "${slug}" && -f "${dir}/.runner" ]]; then
      local gh_url path
      gh_url="$(sed -n 's/.*"gitHubUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "${dir}/.runner" 2>/dev/null | head -n1 || true)"
      path="${gh_url#*://}"; path="${path#*/}"; path="${path%/}"
      if [[ "${path}" == */* ]]; then
        slug="${path}"
      fi
    fi
    if [[ -n "${slug}" ]]; then
      local counts q ip
      counts="$(queue_counts "${slug}")"
      q="$(printf '%s' "${counts}" | awk '{print $1}')"
      ip="$(printf '%s' "${counts}" | awk '{print $2}')"
      [[ -z "${q}" ]]  || queue_json="${queue_json},\"queue_queued\":${q}"
      [[ -z "${ip}" ]] || queue_json="${queue_json},\"queue_in_progress\":${ip}"
    fi
  fi

  # Optional fields as fragments; absent keys stay absent (not null).
  local extra=""
  [[ -z "${last_job_name}" ]]   || extra="${extra},\"last_job_name\":\"$(json_escape "${last_job_name}")\""
  [[ -z "${last_job_result}" ]] || extra="${extra},\"last_job_result\":\"$(json_escape "${last_job_result}")\""
  [[ -z "${disk_total}" ]]      || extra="${extra},\"disk_total_kb\":${disk_total}"
  [[ -z "${disk_used}" ]]       || extra="${extra},\"disk_used_kb\":${disk_used}"
  [[ -z "${disk_avail}" ]]      || extra="${extra},\"disk_avail_kb\":${disk_avail}"
  [[ -z "${disk_pct}" ]]        || extra="${extra},\"disk_used_pct\":${disk_pct}"
  extra="${extra}${queue_json}"

  printf '{"ts":"%s","host":"%s","runner":"%s","runner_name":"%s","daemon_loaded":%s,"status":"%s"%s}\n' \
    "$(iso_now)" "${HOST_LABEL}" "${name}" "$(json_escape "${runner_name}")" \
    "$([[ "${daemon_loaded}" -eq 1 ]] && echo true || echo false)" \
    "${status}" "${extra}"
}

run_metrics() {
  # Queue metrics need the PAT in the curl config file (not in ps).
  if [[ -n "${GITHUB_PAT:-}" ]]; then
    make_curl_auth_config "${GITHUB_PAT}"
  fi
  # metrics reads the system launchd domain; prime sudo once up front so
  # prompts don't interleave with JSON on stdout. A NOPASSWD rule for
  # `launchctl print` (docs/agent-tools.md) keeps this non-interactive.
  if sudo -n launchctl print system >/dev/null 2>&1; then
    SUDO="sudo -n"
  else
    log "Requesting administrator privileges (needed for launchctl print system/...)"
    if ! sudo -v; then
      err "Could not obtain sudo privileges."
      exit 1
    fi
  fi
  log "Emitting runner metrics to stdout (interval ${INTERVAL}s)"
  while :; do
    local d found=0
    shopt -s nullglob
    for d in "${RUNNER_ROOT}"/runner-*; do
      [[ -d "${d}" ]] || continue
      found=1
      metrics_one "${d}"
    done
    shopt -u nullglob
    if [[ "${found}" -eq 0 ]]; then
      warn "No runners found under ${RUNNER_ROOT}."
    fi
    [[ "${ONCE}" -eq 1 ]] && break
    sleep "${INTERVAL}"
  done
}

# ----------------------------------------------------------------------------
# tail / jobs — read-only views of diag logs for operators and agents.
# ----------------------------------------------------------------------------
# Runner directories to inspect: --runner, else every runner-N under RUNNER_ROOT.
runner_dirs() {
  local d
  if [[ -n "${RUNNER_FILTER}" ]]; then
    d="${RUNNER_ROOT}/${RUNNER_FILTER}"
    if [[ ! -d "${d}" ]]; then
      err "No such runner: ${d}"
      return 1
    fi
    printf '%s\n' "${d}"
    return 0
  fi
  shopt -s nullglob
  for d in "${RUNNER_ROOT}"/runner-*; do
    [[ -d "${d}" && "${d##*/}" =~ ^runner-[0-9]+$ ]] && printf '%s\n' "${d}"
  done
  shopt -u nullglob
  return 0
}

# Newest file for a log kind inside one runner directory (empty when none).
newest_log() {
  local dir="$1" kind="$2"
  case "${kind}" in
    runner) ls -t "${dir}"/_diag/Runner_*.log 2>/dev/null | head -n1 || true ;;
    worker) ls -t "${dir}"/_diag/Worker_*.log 2>/dev/null | head -n1 || true ;;
    stdout) [[ -f "${dir}/_diag/runner-stdout.log" ]] && printf '%s\n' "${dir}/_diag/runner-stdout.log" || true ;;
    stderr) [[ -f "${dir}/_diag/runner-stderr.log" ]] && printf '%s\n' "${dir}/_diag/runner-stderr.log" || true ;;
  esac
}

run_tail() {
  local -a dirs=()
  local d list
  list="$(runner_dirs)" || exit 1
  while IFS= read -r d; do [[ -n "${d}" ]] && dirs+=("${d}"); done <<< "${list}"
  if [[ ${#dirs[@]} -eq 0 ]]; then
    err "No runners found under ${RUNNER_ROOT}."
    exit 1
  fi
  if [[ ${#dirs[@]} -gt 1 ]]; then
    err "Several runners are installed; choose one with --runner N:"
    for d in "${dirs[@]}"; do err "  ${d##*/}"; done
    exit 2
  fi
  local dir="${dirs[0]}" name file
  name="${dir##*/}"
  file="$(newest_log "${dir}" "${LOG_KIND}")"
  if [[ -z "${file}" ]]; then
    if [[ "${JSON}" -eq 1 ]]; then
      printf '{"runner":"%s","kind":"%s","file":null,"lines":[]}\n' \
        "$(json_escape "${name}")" "${LOG_KIND}"
      exit 0
    fi
    err "${name}: no ${LOG_KIND} log found under ${dir}/_diag."
    exit 1
  fi

  if [[ "${JSON}" -eq 0 ]]; then
    tail -n "${LINES}" "${file}"
    return 0
  fi
  local line lines="" first=1
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${first}" -eq 1 ]]; then first=0; else lines="${lines},"; fi
    lines="${lines}\"$(json_escape "${line}")\""
  done < <(tail -n "${LINES}" "${file}")
  printf '{"runner":"%s","kind":"%s","file":"%s","mtime":"%s","lines":[%s]}\n' \
    "$(json_escape "${name}")" "${LOG_KIND}" "$(json_escape "${file}")" \
    "$(date -u -r "$(stat -f %m "${file}")" '+%Y-%m-%dT%H:%M:%SZ')" "${lines}"
}

# Print one TSV record per Worker completion: <epoch>\t<runner>\t<started>\t<duration_s>\t<result>\t<job>\t<file>
# Worker logs are named Worker_YYYYMMDD-HHMMSS-utc.log; the start stamp is the
# file name and the finish time is the file's mtime, so duration needs no
# parsing of the log body.
job_records() {
  local dir name f base stamp started epoch finished duration result job line
  while IFS= read -r dir; do
    [[ -n "${dir}" ]] || continue
    name="${dir##*/}"
    for f in "${dir}"/_diag/Worker_*.log; do
      [[ -f "${f}" ]] || continue
      line="$(grep 'completed with result' "${f}" 2>/dev/null | tail -n1 || true)"
      [[ -n "${line}" ]] || continue
      base="${f##*/}"
      stamp="$(printf '%s' "${base}" \
        | sed -n 's/^Worker_\([0-9]\{8\}-[0-9]\{6\}\)-utc\.log/\1/p' || true)"
      epoch=""
      [[ -z "${stamp}" ]] || epoch="$(date -j -u -f '%Y%m%d-%H%M%S' "${stamp}" '+%s' 2>/dev/null || true)"
      finished="$(stat -f %m "${f}" 2>/dev/null || echo 0)"
      started=""; duration=""
      if [[ -n "${epoch}" ]]; then
        started="$(date -u -r "${epoch}" '+%Y-%m-%dT%H:%M:%SZ')"
        duration=$(( finished - epoch ))
        [[ "${duration}" -ge 0 ]] || duration=""
      fi
      result="$(printf '%s' "${line}" \
        | sed -n 's/.*completed with result:[[:space:]]*\([A-Za-z]*\).*/\1/p' | head -n1 || true)"
      job="$(printf '%s' "${line}" | sed -n "s/.*Job '\([^']*\)'.*/\1/p" | head -n1 || true)"
      [[ -n "${job}" ]] || job="$(printf '%s' "${line}" \
        | sed -n 's/.*Job \([^ ]*\) completed.*/\1/p' | head -n1 || true)"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "${epoch:-${finished}}" "${name}" "${started}" "${duration}" "${result:-unknown}" "${job}" "${f}"
    done
  done < <(runner_dirs)
}

run_jobs() {
  local records
  runner_dirs >/dev/null || exit 1
  shopt -s nullglob
  records="$(job_records | sort -t $'\t' -k1,1nr | head -n "${LIMIT}")" || exit 1
  shopt -u nullglob

  local epoch name started duration result job file
  if [[ "${JSON}" -eq 0 ]]; then
    printf '%-10s %-20s %-9s %-9s %s\n' RUNNER STARTED DURATION RESULT JOB
    [[ -n "${records}" ]] || return 0
    while IFS=$'\t' read -r epoch name started duration result job file; do
      printf '%-10s %-20s %-9s %-9s %s\n' "${name}" "${started:-?}" "${duration:+${duration}s}" "${result}" "${job}"
    done <<< "${records}"
    return 0
  fi
  local items="" first=1 obj
  if [[ -n "${records}" ]]; then
    while IFS=$'\t' read -r epoch name started duration result job file; do
      obj="$(printf '{"runner":"%s","job":"%s","result":"%s","started":%s,"duration_s":%s,"file":"%s"}' \
        "$(json_escape "${name}")" "$(json_escape "${job}")" "$(json_escape "${result}")" \
        "$([[ -n "${started}" ]] && printf '"%s"' "${started}" || printf null)" \
        "${duration:-null}" "$(json_escape "${file}")")"
      if [[ "${first}" -eq 1 ]]; then first=0; else items="${items},"; fi
      items="${items}${obj}"
    done <<< "${records}"
  fi
  printf '{"host":"%s","jobs":[%s]}\n' "$(json_escape "${HOST_LABEL}")" "${items}"
}

# ----------------------------------------------------------------------------
# STEPS mode — per-step CPU/memory timeline.
# Sampling (ps) stays in bash; step-boundary parsing and sample correlation
# are heavier, so they run in an embedded python3 (stdlib only).
# ----------------------------------------------------------------------------

# Append one {"ts","runner","cpu_pct","rss_mb"} sample per runner. A process
# is attributed to a runner when its command line references the runner
# directory (Runner.Worker lives in runner-N/bin/, step scripts in
# runner-N/_work/), so attribution is best-effort but needs no sudo.
sample_runners() {
  local list d name stats cpu rss
  list="$(runner_dirs)" || return 1
  while IFS= read -r d; do
    [[ -n "${d}" ]] || continue
    name="${d##*/}"
    stats="$(ps -axo pcpu=,rss=,args= 2>/dev/null \
      | grep -F "${d}/" | grep -v 'grep' \
      | awk '{cpu+=$1; rss+=$2} END {printf "%.1f %d", cpu+0, int(rss/1024)}')"
    cpu="${stats%% *}"; rss="${stats##* }"
    printf '{"ts":"%s","runner":"%s","cpu_pct":%s,"rss_mb":%s}\n' \
      "$(iso_now)" "$(json_escape "${name}")" "${cpu}" "${rss}" >> "${SAMPLES_FILE}"
  done <<< "${list}"
}

# Emit one JSON line per completed step on stdout. mode=full parses every
# Worker log from scratch (post-hoc reconstruction); mode=incr emits only
# steps not yet emitted and persists per-file progress in the state file.
steps_emit() {
  python3 - "$1" "${RUNNER_ROOT}" "${SAMPLES_FILE}" "${STEPS_STATE_FILE}" "${RUNNER_FILTER}" <<'PYEOF'
import glob
import json
import os
import re
import sys
from datetime import datetime, timezone

mode, runner_root, samples_file, state_file, runner_filter = sys.argv[1:6]

TS_RE = re.compile(r"^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})Z")
STEP_RE = re.compile(r"INFO StepsRunner\] Processing step: DisplayName='?(.+?)'?\s*$")
RESULT_RE = re.compile(r"INFO StepsRunner\] Step result:\s*([A-Za-z]+)")
DONE_RE = re.compile(r"Job '([^']+)' completed with result:\s*([A-Za-z]+)")
RUNNER_DIR_RE = re.compile(r"^runner-\d+$")


def parse_ts(line):
    match = TS_RE.match(line)
    if not match:
        return None
    return int(datetime.strptime(match.group(1), "%Y-%m-%d %H:%M:%S")
               .replace(tzinfo=timezone.utc).timestamp())


def iso(epoch_s):
    return datetime.fromtimestamp(epoch_s, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


samples = {}
if os.path.exists(samples_file):
    with open(samples_file) as handle:
        for line in handle:
            try:
                rec = json.loads(line)
                stamp = int(datetime.strptime(rec["ts"], "%Y-%m-%dT%H:%M:%SZ")
                            .replace(tzinfo=timezone.utc).timestamp())
                samples.setdefault(rec.get("runner", ""), []).append(
                    (stamp, float(rec.get("cpu_pct") or 0), float(rec.get("rss_mb") or 0)))
            except (ValueError, KeyError, TypeError):
                continue


def parse_steps(path):
    steps, current, job, job_result = [], None, "", ""
    with open(path, errors="replace") as handle:
        for line in handle:
            match = STEP_RE.search(line)
            if match:
                stamp = parse_ts(line)
                if current is not None and stamp is not None:
                    current["end"] = stamp
                    steps.append(current)
                current = {"step": match.group(1).strip(), "start": stamp,
                           "end": None, "result": ""}
                continue
            match = RESULT_RE.search(line)
            if match and current is not None:
                stamp = parse_ts(line)
                current["result"] = match.group(1)
                if stamp is not None:
                    current["end"] = stamp
                    steps.append(current)
                    current = None
                continue
            match = DONE_RE.search(line)
            if match:
                job, job_result = match.group(1), match.group(2)
                stamp = parse_ts(line)
                if current is not None and stamp is not None:
                    current["end"] = stamp
                    steps.append(current)
                    current = None
    return job, job_result, [s for s in steps
                             if s["start"] is not None and s["end"] is not None]


def emit(runner, path, job, job_result, step):
    window = [entry for entry in samples.get(runner, [])
              if step["start"] <= entry[0] <= step["end"]]
    cpus = [entry[1] for entry in window]
    rss = [entry[2] for entry in window]
    print(json.dumps({
        "runner": runner,
        "job": job or None,
        "job_result": job_result or None,
        "step": step["step"],
        "result": step["result"] or None,
        "start": iso(step["start"]),
        "end": iso(step["end"]),
        "duration_s": step["end"] - step["start"],
        "samples": len(window),
        "cpu_mean_pct": round(sum(cpus) / len(cpus), 1) if cpus else None,
        "cpu_peak_pct": round(max(cpus), 1) if cpus else None,
        "rss_peak_mb": int(max(rss)) if rss else None,
        "file": path,
    }))


state = {}
if mode == "incr" and os.path.exists(state_file):
    with open(state_file) as handle:
        for line in handle:
            parts = line.rstrip("\n").split("\t")
            if len(parts) == 3 and parts[2].isdigit():
                state[parts[0]] = (parts[1], int(parts[2]))

new_state = {}
pattern = os.path.join(runner_root, "runner-*", "_diag", "Worker_*.log")
for path in sorted(glob.glob(pattern)):
    runner = path.split(os.sep)[-3]
    if not RUNNER_DIR_RE.match(runner):
        continue
    if runner_filter and runner != runner_filter:
        continue
    try:
        inode = str(os.stat(path).st_ino)
    except OSError:
        continue
    job, job_result, steps = parse_steps(path)
    start = 0
    if mode == "incr":
        previous = state.get(path)
        if previous and previous[0] == inode:
            start = previous[1]
    for step in steps[start:]:
        emit(runner, path, job, job_result, step)
    new_state[path] = (inode, len(steps))

if mode == "incr":
    os.makedirs(os.path.dirname(state_file), exist_ok=True)
    tmp_path = state_file + ".tmp"
    with open(tmp_path, "w") as handle:
        for path in sorted(new_state):
            handle.write("%s\t%s\t%d\n" % (path, new_state[path][0], new_state[path][1]))
    os.replace(tmp_path, state_file)
PYEOF
}

run_steps() {
  mkdir -p "$(dirname "${SAMPLES_FILE}")"
  if [[ "${ONCE}" -eq 1 ]]; then
    steps_emit full
    return 0
  fi
  log "Sampling per-runner CPU/memory and emitting step timelines (interval ${INTERVAL}s)"
  while :; do
    sample_runners || warn "No runners found under ${RUNNER_ROOT}."
    steps_emit incr
    sleep "${INTERVAL}"
  done
}

# ----------------------------------------------------------------------------
# TESTS mode — JUnit ingestion + flake history (python3 stdlib).
# ----------------------------------------------------------------------------

# Append one history record per (file, testsuite); unchanged files (same
# path+mtime already in the history) are skipped.
tests_ingest() {
  python3 - "${HISTORY_FILE}" "${JUNIT_GLOBS}" <<'PYEOF'
import glob
import json
import os
import sys
import xml.etree.ElementTree as ET
from datetime import datetime, timezone

history_file, patterns = sys.argv[1], sys.argv[2].split(":")

seen = set()
if os.path.exists(history_file):
    with open(history_file) as handle:
        for line in handle:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            seen.add((rec.get("source", ""), rec.get("source_mtime", 0)))

files = set()
for pattern in patterns:
    if glob.has_magic(pattern):
        files.update(p for p in glob.glob(pattern, recursive=True) if os.path.isfile(p))
    elif os.path.isfile(pattern):
        files.add(pattern)

if not files:
    sys.stderr.write("ERROR: no JUnit XML files matched.\n")
    sys.exit(1)


def parse_suites(path):
    root = ET.parse(path).getroot()
    suites = [root] if root.tag == "testsuite" else list(root.iter("testsuite"))
    records = []
    for suite in suites:
        cases = []
        for case in suite.iter("testcase"):
            status = "passed"
            if case.find("failure") is not None:
                status = "failed"
            elif case.find("error") is not None:
                status = "error"
            elif case.find("skipped") is not None:
                status = "skipped"
            try:
                seconds = float(case.get("time") or 0)
            except ValueError:
                seconds = 0.0
            cases.append({"name": case.get("name", ""),
                          "classname": case.get("classname", ""),
                          "status": status, "time_s": seconds})
        records.append({
            "suite": suite.get("name") or os.path.splitext(os.path.basename(path))[0],
            "tests": len(cases),
            "failures": sum(1 for c in cases if c["status"] == "failed"),
            "errors": sum(1 for c in cases if c["status"] == "error"),
            "skipped": sum(1 for c in cases if c["status"] == "skipped"),
            "cases": cases,
        })
    return records


os.makedirs(os.path.dirname(history_file), exist_ok=True)
ingested = 0
with open(history_file, "a") as out:
    for path in sorted(files):
        try:
            mtime = int(os.stat(path).st_mtime)
        except OSError:
            continue
        if (path, mtime) in seen:
            continue
        try:
            suites = parse_suites(path)
        except Exception as exc:
            sys.stderr.write("WARN: skipping unreadable JUnit file %s: %s\n" % (path, exc))
            continue
        for record in suites:
            record.update({"ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                           "source": path, "source_mtime": mtime})
            out.write(json.dumps(record) + "\n")
            ingested += 1
            print("ingested %s: suite=%s tests=%d failures=%d errors=%d skipped=%d"
                  % (path, record["suite"], record["tests"], record["failures"],
                     record["errors"], record["skipped"]))
sys.stderr.write("%d suite run(s) recorded in %s\n" % (ingested, history_file))
PYEOF
}

# Per-suite totals across all recorded runs, plus flaky tests: tests whose
# status changes between consecutive runs of the same suite.
tests_report() {
  if [[ ! -f "${HISTORY_FILE}" ]]; then
    err "No test history at ${HISTORY_FILE}; run '${PROG_NAME} tests ingest' first."
    exit 1
  fi
  python3 - "${HISTORY_FILE}" "${SUITE_FILTER}" "${LIMIT}" "${JSON}" <<'PYEOF'
import json
import sys

history_file, suite_filter = sys.argv[1], sys.argv[2]
limit, as_json = int(sys.argv[3]), sys.argv[4] == "1"

by_suite = {}
with open(history_file) as handle:
    for line in handle:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if suite_filter and rec.get("suite") != suite_filter:
            continue
        by_suite.setdefault(rec.get("suite", ""), []).append(rec)

if not by_suite:
    sys.stderr.write("ERROR: no matching suite runs in history.\n")
    sys.exit(1)


def case_key(case):
    if case.get("classname"):
        return case["classname"] + "." + case.get("name", "")
    return case.get("name", "")


suites, flaky = [], []
for suite in sorted(by_suite):
    runs = by_suite[suite]
    totals = {}
    history = {}
    for run in runs:
        for case in run.get("cases", []):
            totals[case["status"]] = totals.get(case["status"], 0) + 1
            history.setdefault(case_key(case), []).append(case["status"])
    suites.append({"suite": suite, "runs": len(runs),
                   "passed": totals.get("passed", 0), "failed": totals.get("failed", 0),
                   "errors": totals.get("error", 0), "skipped": totals.get("skipped", 0)})
    for key in sorted(history):
        statuses = history[key]
        flips = sum(1 for a, b in zip(statuses, statuses[1:]) if a != b)
        if flips:
            flaky.append({"suite": suite, "test": key, "flips": flips,
                          "runs": len(statuses), "last_status": statuses[-1]})

flaky.sort(key=lambda row: (-row["flips"], row["test"]))
flaky = flaky[:limit]

if as_json:
    print(json.dumps({"suites": suites, "flaky": flaky}))
    sys.exit(0)

print("%-30s %5s %7s %7s %7s %8s" % ("SUITE", "RUNS", "PASSED", "FAILED", "ERRORS", "SKIPPED"))
for row in suites:
    print("%-30s %5d %7d %7d %7d %8d" % (row["suite"][:30], row["runs"], row["passed"],
                                        row["failed"], row["errors"], row["skipped"]))
print("")
print("FLAKY TESTS (status flips between consecutive runs):")
if not flaky:
    print("  none")
for row in flaky:
    print("  flips=%d last=%-8s %s :: %s"
          % (row["flips"], row["last_status"], row["suite"], row["test"]))
PYEOF
}

run_tests() {
  case "${TESTS_CMD}" in
    ingest) tests_ingest ;;
    report) tests_report ;;
  esac
}

# ----------------------------------------------------------------------------
# DASHBOARD mode — self-contained static HTML report. Runner status here is
# inferred from diag logs only (no sudo): the newest Runner log must have
# been touched within the last 10 minutes to count as online.
# ----------------------------------------------------------------------------

# One TSV record per runner: <name>\t<status>\t<last diag activity ISO|- >
dashboard_runners() {
  local d name diag newest marker mtime now status
  now="$(date -u '+%s')"
  shopt -s nullglob
  for d in "${RUNNER_ROOT}"/runner-*; do
    [[ -d "${d}" && "${d##*/}" =~ ^runner-[0-9]+$ ]] || continue
    name="${d##*/}"
    diag="${d}/_diag"
    status="offline"; marker=""; mtime=0
    newest="$(ls -t "${diag}"/Runner_*.log 2>/dev/null | head -n1 || true)"
    if [[ -n "${newest}" ]]; then
      mtime="$(stat -f %m "${newest}" 2>/dev/null || echo 0)"
      marker="$(tail -n 300 "${newest}" 2>/dev/null \
        | grep -E 'Listening for Jobs|Running job' | tail -n1 || true)"
      if [[ $((now - mtime)) -lt 600 ]]; then
        case "${marker}" in
          *"Running job"*)        status="busy" ;;
          *"Listening for Jobs"*) status="idle" ;;
          *)                      status="unknown" ;;
        esac
      fi
    fi
    printf '%s\t%s\t%s\n' "${name}" "${status}" \
      "$([[ "${mtime}" -gt 0 ]] && date -u -r "${mtime}" '+%Y-%m-%dT%H:%M:%SZ' || echo '-')"
  done
  shopt -u nullglob
}

run_dashboard() {
  mkdir -p "$(dirname "${DASHBOARD_OUTPUT}")"
  WORK_TMPDIR="$(mktemp -d "${TMPDIR:-/tmp}/runner-logs.XXXXXX")"
  local runners_tsv="${WORK_TMPDIR}/runners.tsv" jobs_tsv="${WORK_TMPDIR}/jobs.tsv"
  dashboard_runners > "${runners_tsv}"
  job_records | sort -t $'\t' -k1,1nr | head -n "${LIMIT}" > "${jobs_tsv}"
  python3 - "${DASHBOARD_OUTPUT}" "${HOST_LABEL}" "${runners_tsv}" "${jobs_tsv}" \
    "${HISTORY_FILE}" "${LIMIT}" <<'PYEOF'
import html
import json
import os
import sys
from datetime import datetime, timezone

out_path, host, runners_tsv, jobs_tsv, history_file = sys.argv[1:6]
limit = int(sys.argv[6])


def esc(text):
    return html.escape(text, quote=True)


runners = []
with open(runners_tsv) as handle:
    for line in handle:
        parts = line.rstrip("\n").split("\t")
        if len(parts) >= 3:
            runners.append(parts[:3])

jobs = []
with open(jobs_tsv) as handle:
    for line in handle:
        parts = line.rstrip("\n").split("\t")
        if len(parts) >= 6:
            jobs.append(parts)

by_suite = {}
if os.path.exists(history_file):
    with open(history_file) as handle:
        for line in handle:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            by_suite.setdefault(rec.get("suite", ""), []).append(rec)

flaky = []
for suite, runs in by_suite.items():
    history = {}
    for run in runs:
        for case in run.get("cases", []):
            key = (case.get("classname", "") + "." + case.get("name", "")
                   if case.get("classname") else case.get("name", ""))
            history.setdefault(key, []).append(case.get("status", ""))
    for key in sorted(history):
        statuses = history[key]
        flips = sum(1 for a, b in zip(statuses, statuses[1:]) if a != b)
        if flips:
            flaky.append({"suite": suite, "test": key, "flips": flips,
                          "last_status": statuses[-1]})
flaky.sort(key=lambda row: (-row["flips"], row["test"]))
flaky = flaky[:limit]

generated = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def badge(text, kind):
    return '<span class="badge %s">%s</span>' % (kind, esc(text or "?"))


rows_runners = []
for name, status, seen in runners:
    kind = "ok" if status in ("idle", "busy") else ("warn" if status == "unknown" else "bad")
    rows_runners.append("<tr><td>%s</td><td>%s</td><td>%s</td></tr>"
                        % (esc(name), badge(status, kind), esc(seen)))

rows_jobs = []
for parts in jobs:
    _, runner, started, duration, result, job = parts[:6]
    kind = "ok" if result == "Succeeded" else ("bad" if result in ("Failed", "Cancelled") else "warn")
    rows_jobs.append("<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>"
                     % (esc(runner), esc(job or "?"), badge(result, kind),
                        esc(started or "?"), esc(duration + "s" if duration else "?")))

rows_flaky = []
for row in flaky:
    rows_flaky.append("<tr><td>%d</td><td>%s</td><td>%s</td><td>%s</td></tr>"
                      % (row["flips"], esc(row["last_status"]), esc(row["suite"]), esc(row["test"])))


def table(headers, rows, empty):
    if not rows:
        return '<p class="empty">%s</p>' % esc(empty)
    return "<table><thead><tr>%s</tr></thead><tbody>%s</tbody></table>" % (
        "".join("<th>%s</th>" % esc(h) for h in headers), "".join(rows))


page = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>runner-logs dashboard - %(host)s</title>
<style>
body { font-family: -apple-system, Helvetica, Arial, sans-serif; margin: 2rem; color: #1a1a1a; }
h1 { font-size: 1.4rem; }
h2 { font-size: 1.1rem; margin-top: 2rem; }
.meta { color: #666; font-size: 0.85rem; }
table { border-collapse: collapse; width: 100%%; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid #ddd; font-size: 0.9rem; }
th { background: #f5f5f5; }
.badge { padding: 2px 8px; border-radius: 10px; font-size: 0.8rem; color: #fff; }
.badge.ok { background: #22863a; }
.badge.bad { background: #cb2431; }
.badge.warn { background: #b08800; }
.empty { color: #666; font-style: italic; }
</style>
</head>
<body>
<h1>runner-logs dashboard &mdash; %(host)s</h1>
<p class="meta">Generated %(generated)s. Self-contained report; no external assets.</p>
<h2>Runners</h2>
%(runners)s
<h2>Recent jobs</h2>
%(jobs)s
<h2>Top flaky tests</h2>
%(flaky)s
</body>
</html>
""" % {
    "host": esc(host),
    "generated": generated,
    "runners": table(["Runner", "Status", "Last diag activity"], rows_runners, "No runners found."),
    "jobs": table(["Runner", "Job", "Result", "Started", "Duration"], rows_jobs,
                  "No job completions found."),
    "flaky": table(["Flips", "Last", "Suite", "Test"], rows_flaky, "No flaky tests detected."),
}

with open(out_path, "w") as handle:
    handle.write(page)
PYEOF
  step "Dashboard written to ${DASHBOARD_OUTPUT}"
}

